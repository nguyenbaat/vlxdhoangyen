---
import Layout from '../../layouts/Layout.astro';
import { PostRepo } from '../../server/db/repo.js';

const POSTS_PER_PAGE = 9;

// 1. Get current page from query string
const url = new URL(Astro.request.url);
let currentPage = parseInt(url.searchParams.get('page') || '1', 10);
if (isNaN(currentPage) || currentPage < 1) currentPage = 1;

// 2. Fetch total count & compute pagination
const totalPosts = await PostRepo.count('published');
const totalPages = Math.max(1, Math.ceil(totalPosts / POSTS_PER_PAGE));
if (currentPage > totalPages) currentPage = totalPages;

const offset = (currentPage - 1) * POSTS_PER_PAGE;
const posts = await PostRepo.getAll({ limit: POSTS_PER_PAGE, offset, status: 'published' });

const breadcrumbs = [
  { name: 'Trang Chủ', url: '/' },
  { name: 'Tin Tức', url: '/tin-tuc/' }
];

function formatDate(dateStr?: string) {
  if (!dateStr) return '16/09/2026';
  try {
    const d = new Date(dateStr);
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    return `${day}/${month}/${year}`;
  } catch {
    return '16/09/2026';
  }
}

// Generate pagination page list with dots
function getPaginationRange(current: number, total: number) {
  const delta = 2;
  const range: (number | string)[] = [];
  const rangeWithDots: (number | string)[] = [];
  let l: number | undefined;

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    }
  }

  for (const i of range) {
    if (l) {
      if (typeof i === 'number' && i - l === 2) {
        rangeWithDots.push(l + 1);
      } else if (typeof i === 'number' && i - l !== 1) {
        rangeWithDots.push('...');
      }
    }
    rangeWithDots.push(i);
    if (typeof i === 'number') l = i;
  }

  return rangeWithDots;
}

const paginationItems = getPaginationRange(currentPage, totalPages);
const pageTitle = currentPage > 1 
  ? `Tin Tức & Cẩm Nang Xây Dựng (Trang ${currentPage}) | Siêu Thị VLXD Hoàng Yến`
  : `Tin Tức & Cẩm Nang Kỹ Thuật Xây Dựng | Siêu Thị VLXD Hoàng Yến`;

const canonicalUrl = currentPage > 1 
  ? `https://vlxdhoangyen.com/tin-tuc/?page=${currentPage}`
  : 'https://vlxdhoangyen.com/tin-tuc/';

const currentPathStr = currentPage > 1 ? `/tin-tuc/?page=${currentPage}` : '/tin-tuc/';
---

<Layout
  title={pageTitle}
  description="Tin tức, cập nhật bảng báo giá vật liệu xây dựng, biến động thị trường sắt thép, xi măng, gạch ngói và kiến thức kỹ thuật xây dựng tại Quảng Trị."
  breadcrumbs={breadcrumbs}
  canonical={canonicalUrl}
  currentPath={currentPathStr}
>
  <div class="news-page-wrapper">
    <!-- Header Hero -->
    <section class="news-hero">
      <div class="container">
        <div class="eyebrow">SIÊU THỊ VLXD HOÀNG YẾN</div>
        <h1>Tin Tức & Cẩm Nang Kỹ Thuật</h1>
        <p>Cập nhật biến động giá vật tư xuất xưởng, barem quy cách chuẩn TCVN và cẩm nang kinh nghiệm xây dựng.</p>
      </div>
    </section>

    <!-- News Grid -->
    <section class="section">
      <div class="container">
        {posts.length === 0 ? (
          <div class="no-posts-box">
            <p>Hiện tại chưa có bài viết nào được đăng tải.</p>
          </div>
        ) : (
          <div class="posts-industrial-grid">
            {posts.map(post => (
              <article class="post-item-card">
                <a href={`/tin-tuc/${post.slug}/`} class="post-thumb-wrap">
                  <img 
                    src={post.featured_image || 'https://vlxdhoangyen.com/wp-content/uploads/2025/07/VAT-LIEU-XAY-DUNG-1920-x-731-px-4.png'} 
                    alt={`${post.title} – Tin tức VLXD Hoàng Yến Quảng Trị`} 
                    width="400"
                    height="240"
                    loading="lazy" 
                    decoding="async" 
                  />
                </a>
                <div class="post-content">
                  <div class="post-header-meta">
                    <span class="post-meta-badge">{post.category_name || 'Kiến Thức VLXD'}</span>
                    <span class="post-meta-date">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -1px; margin-right: 4px; color: var(--color-red);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                      {formatDate(post.published_at)}
                    </span>
                  </div>
                  <h2 class="post-title">
                    <a href={`/tin-tuc/${post.slug}/`}>{post.title}</a>
                  </h2>
                  <p class="post-excerpt">{post.summary}</p>
                  <div class="post-footer">
                    <a href={`/tin-tuc/${post.slug}/`} class="btn-read-more">
                      <span>Đọc Chi Tiết</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}

        <!-- Pagination Bar -->
        {totalPages > 1 && (
          <nav class="pagination-wrapper" aria-label="Phân trang bài viết">
            <div class="pagination-container">
              {/* Prev Button */}
              {currentPage > 1 ? (
                <a href={`/tin-tuc/${currentPage - 1 === 1 ? '' : `?page=${currentPage - 1}`}`} class="page-btn page-nav-btn" aria-label="Trang trước">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  <span>Trước</span>
                </a>
              ) : (
                <span class="page-btn page-nav-btn disabled" aria-disabled="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  <span>Trước</span>
                </span>
              )}

              {/* Numbered Page Buttons */}
              <div class="page-numbers-list">
                {paginationItems.map(item => {
                  if (item === '...') {
                    return <span class="page-dots">...</span>;
                  }
                  const pageNum = Number(item);
                  const isActive = pageNum === currentPage;
                  const pageHref = pageNum === 1 ? '/tin-tuc/' : `/tin-tuc/?page=${pageNum}`;
                  
                  return isActive ? (
                    <span class="page-btn page-num-btn active" aria-current="page">{pageNum}</span>
                  ) : (
                    <a href={pageHref} class="page-btn page-num-btn">{pageNum}</a>
                  );
                })}
              </div>

              {/* Next Button */}
              {currentPage < totalPages ? (
                <a href={`/tin-tuc/?page=${currentPage + 1}`} class="page-btn page-nav-btn" aria-label="Trang sau">
                  <span>Sau</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
              ) : (
                <span class="page-btn page-nav-btn disabled" aria-disabled="true">
                  <span>Sau</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </span>
              )}
            </div>
            <div class="pagination-info">
              Hiển thị trang <strong>{currentPage}</strong> / <strong>{totalPages}</strong> (Tổng cộng <strong>{totalPosts}</strong> bài viết)
            </div>
          </nav>
        )}
      </div>
    </section>
  </div>
</Layout>

<style>
  .news-hero {
    background-color: var(--color-concrete-light);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .news-hero .eyebrow {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-red);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .news-hero h1 {
    font-size: 2rem;
    color: #0f172a;
    margin-bottom: 8px;
    font-weight: 800;
  }

  .news-hero p {
    font-size: 1.05rem;
    color: #475569;
    max-width: 700px;
    line-height: 1.6;
    margin-top: var(--space-2);
  }

  .posts-industrial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .post-item-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-xs);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .post-item-card:hover {
    border-color: #0f172a;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
  }

  .post-thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: #f1f5f9;
    overflow: hidden;
    border-bottom: 1px solid #e2e8f0;
    display: block;
  }

  .post-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-item-card:hover .post-thumb-wrap img {
    transform: scale(1.05);
  }

  .post-content {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .post-header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .post-meta-badge {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-red);
    background: #fef2f2;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid #fee2e2;
  }

  .post-meta-date {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 500;
  }

  .post-title {
    font-size: 1.125rem;
    line-height: 1.45;
    margin-bottom: var(--space-3);
    font-weight: 700;
  }

  .post-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-title a:hover {
    color: var(--color-red);
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: var(--space-5);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    justify-content: flex-start;
    padding-top: var(--space-3);
    border-top: 1px solid #f1f5f9;
  }

  .btn-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
    text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .btn-read-more:hover {
    color: var(--color-red);
    gap: 9px;
  }

  /* Pagination Styling */
  .pagination-wrapper {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .pagination-container {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    flex-wrap: wrap !important;
  }

  .page-numbers-list {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 6px !important;
  }

  .page-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 40px !important;
    height: 40px !important;
    padding: 0 12px !important;
    border-radius: 6px !important;
    border: 1px solid #cbd5e1 !important;
    background: #ffffff !important;
    color: #1e293b !important;
    font-size: 0.9rem !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: all 0.15s ease !important;
    cursor: pointer !important;
    user-select: none !important;
    box-sizing: border-box !important;
  }

  .page-btn:hover:not(.disabled):not(.active) {
    border-color: #0f172a !important;
    background: #f8fafc !important;
    color: #0f172a !important;
  }

  .page-btn.active {
    background: #0f172a !important;
    color: #ffffff !important;
    border-color: #0f172a !important;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15) !important;
    cursor: default !important;
  }

  .page-btn.disabled {
    opacity: 0.4 !important;
    cursor: not-allowed !important;
    border-color: #e2e8f0 !important;
    background: #f8fafc !important;
    color: #94a3b8 !important;
  }

  .page-nav-btn {
    gap: 6px !important;
    padding: 0 14px !important;
    font-size: 0.85rem !important;
  }

  .page-dots {
    padding: 0 6px !important;
    color: #94a3b8 !important;
    font-weight: 700 !important;
  }

  .pagination-info {
    font-size: 0.85rem;
    color: #64748b;
    margin-top: 4px;
  }

  .pagination-info strong {
    color: #0f172a;
  }

  .no-posts-box {
    text-align: center;
    padding: 4rem 1rem;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 8px;
    color: #64748b;
  }

  @media (max-width: 1024px) {
    .posts-industrial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .posts-industrial-grid {
      grid-template-columns: 1fr;
    }
    .page-btn {
      min-width: 36px !important;
      height: 36px !important;
      padding: 0 8px !important;
      font-size: 0.85rem !important;
    }
  }
</style>
