    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #16a34a;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
  }

  .store-info-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
  }

  .store-info-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .info-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .loc-icon {
    color: var(--color-red);
  }

  .clock-icon {
    color: #d97706;
  }

  .info-text {
    display: flex;
    flex-direction: column;
  }

  .info-label {
    font-size: 0.6875rem;
