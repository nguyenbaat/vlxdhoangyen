<script is:inline>
  // Table of Contents Toggle Script
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('toc-toggle-btn');
    const navBody = document.getElementById('toc-nav-body');
    const actionBtn = toggleBtn ? toggleBtn.querySelector('.toc-action-btn') : null;

    if (toggleBtn && navBody && actionBtn) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = navBody.style.display === 'none';
        navBody.style.display = isHidden ? 'block' : 'none';
        actionBtn.textContent = isHidden ? '[Ẩn]' : '[Hiện]';
      });
    }

    // Smooth Scroll for TOC links
    document.querySelectorAll('.toc-link').forEach(link => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href');
        if (targetId && targetId.startsWith('#')) {
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', targetId);
          }
        }
      });
    });
  });
</script>

