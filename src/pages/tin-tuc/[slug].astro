---
import Layout from '../../layouts/Layout.astro';
import { PostRepo, ProductRepo, CategoryRepo, SettingsRepo } from '../../server/db/repo.js';

const { slug } = Astro.params;
const post = slug ? await PostRepo.getBySlug(slug) : null;

if (!post) {
  return Astro.redirect('/404');
}

const settings = await SettingsRepo.getAll();
const allCategories = await CategoryRepo.getMainCategories();
const recentPosts = (await PostRepo.getLatest(4)).filter(p => p.id !== post.id).slice(0, 3);

// Dynamic Related Products matching post category or topic
let relatedProducts = [];
if (post.category_slug) {
  const cat = await CategoryRepo.getBySlug(post.category_slug);
  if (cat) {
    relatedProducts = (await ProductRepo.getByCategory(cat.id)).slice(0, 4);
  }
}
if (relatedProducts.length === 0) {
  // Fallback if no specific category match
  if (post.title.toLowerCase().includes('thép') || post.slug.includes('thep')) {
    relatedProducts = (await ProductRepo.getByCategory(2)).slice(0, 4);
  } else if (post.title.toLowerCase().includes('xi măng') || post.slug.includes('xi-mang')) {
    relatedProducts = (await ProductRepo.getByCategory(1)).slice(0, 4);
  } else if (post.title.toLowerCase().includes('gạch') || post.slug.includes('gach')) {
    relatedProducts = (await ProductRepo.getByCategory(5)).slice(0, 4);
  } else {
    relatedProducts = await ProductRepo.getFeatured(4);
  }
}

// Format Date
function formatDate(dateStr?: string) {
  if (!dateStr) return '15/09/2026';
  try {
    const d = new Date(dateStr);
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    return `${day}/${month}/${year}`;
  } catch {
    return '15/09/2026';
  }
}

const formattedDate = formatDate(post.published_at);

// Extract Headings for Table of Contents (TOC) & inject IDs if needed
interface TocItem {
  id: string;
  text: string;
  level: number;
}

const tocItems: TocItem[] = [];
let processedContent = post.content || '';

// Regex to find and process H2 and H3 for Table of Contents
const headingRegex = /<(h[23])([^>]*)>(.*?)<\/\1>/gi;
let headingIndex = 0;

processedContent = processedContent.replace(headingRegex, (match, tag, attrs, text) => {
  const cleanText = text.replace(/<[^>]*>/g, '').trim();
  
  // Skip headings from FAQ items, CTA boxes, EEAT cards, or auxiliary widgets
  const isExcluded = 
    /class=["'][^"']*(faq-question|cta-heading|section-title|eeat-|no-toc)[^"']*["']/i.test(attrs) ||
    /^(hỏi:|câu hỏi \d+:|q\d*:)/i.test(cleanText);

  if (isExcluded) {
    return match; // Do not add to TOC, keep original in article
  }

  headingIndex++;
  const level = parseInt(tag.charAt(1), 10);
  
  // Extract existing id or generate one
  const idMatch = attrs.match(/id=["']([^"']+)["']/i);
  let id = idMatch ? idMatch[1] : '';
  
  if (!id) {
    const slugified = cleanText.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[đĐ]/g, 'd').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    id = `muc-${headingIndex}-${slugified || 'heading'}`;
    tocItems.push({ id, text: cleanText, level });
    return `<${tag}${attrs} id="${id}">${text}</${tag}>`;
  }
  
  tocItems.push({ id, text: cleanText, level });
  return match;
});

// Extract FAQs for FAQPage Schema
interface FaqItem {
  question: string;
  answer: string;
}
const faqItems: FaqItem[] = [];
const faqItemRegex = /<div class="faq-item">[\s\S]*?<h3 class="faq-question">(.*?)<\/h3>[\s\S]*?<div class="faq-answer">([\s\S]*?)<\/div>[\s\S]*?<\/div>/gi;
let faqMatch;
while ((faqMatch = faqItemRegex.exec(post.content || '')) !== null) {
  faqItems.push({
    question: faqMatch[1].replace(/<[^>]*>/g, '').trim(),
    answer: faqMatch[2].replace(/<[^>]*>/g, '').trim()
  });
}

// Auto-enrich any <img> tags inside processedContent for strict SEO ALT & Lazy Loading
const postTitleClean = (post.title || 'Vật tư xây dựng Hoàng Yến').replace(/"/g, '&quot;');
processedContent = processedContent.replace(/<img\s+([^>]*?)>/gi, (match, attrs) => {
  let newAttrs = attrs;
  const altMatch = attrs.match(/alt=["']([^"']*)["']/i);
  if (!altMatch) {
    newAttrs += ` alt="${postTitleClean} – Siêu Thị VLXD Hoàng Yến Quảng Trị"`;
  } else if (!altMatch[1].trim()) {
    newAttrs = newAttrs.replace(/alt=["'][^"']*["']/i, `alt="${postTitleClean} – Siêu Thị VLXD Hoàng Yến Quảng Trị"`);
  }
  if (!/loading=["'][^"']*["']/i.test(newAttrs)) {
    newAttrs += ' loading="lazy"';
  }
  if (!/decoding=["'][^"']*["']/i.test(newAttrs)) {
    newAttrs += ' decoding="async"';
  }
  return `<img ${newAttrs}>`;
});

// SEO Breadcrumbs
const categoryName = post.category_name || 'Vật Liệu Xây Dựng';
const categorySlug = post.category_slug || 'thep-xay-dung';

const breadcrumbs = [
  { name: 'Trang Chủ', url: '/' },
  { name: 'Tin Tức', url: '/tin-tuc/' },
  { name: post.title, url: `/tin-tuc/${post.slug}/` }
];

const canonicalUrl = `https://vlxdhoangyen.com/tin-tuc/${post.slug}/`;

// Schemas
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl
  },
  headline: post.title,
  description: post.seo_description || post.summary,
  image: [post.featured_image || settings.banner_url],
  datePublished: post.published_at ? new Date(post.published_at).toISOString() : new Date().toISOString(),
  dateModified: post.published_at ? new Date(post.published_at).toISOString() : new Date().toISOString(),
  inLanguage: 'vi-VN',
  articleSection: categoryName,
  keywords: [categoryName, 'VLXD Quảng Trị', 'Vật liệu xây dựng Hoàng Yến', 'Báo giá vật tư'],
  author: {
    '@type': 'Organization',
    name: 'Ban Biên tập & Marketing – Siêu thị VLXD Hoàng Yến',
    url: 'https://vlxdhoangyen.com/gioi-thieu/'
  },
  publisher: {
    '@type': 'Organization',
    name: settings.company_name,
    url: 'https://vlxdhoangyen.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://vlxdhoangyen.com/logo.png'
    }
  }
};

const schemas: any[] = [articleSchema];

if (faqItems.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(item => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  });
}

// CTA Content based on post type
let ctaTitle = 'Cần Báo Giá VLXD Cho Công Trình Tại Quảng Trị?';
let ctaDesc = 'Gửi danh sách vật tư hoặc khối lượng dự kiến để Siêu thị VLXD Hoàng Yến bóc tách và báo giá cạnh tranh nhất.';
let ctaButtonText = 'NHẬN BÁO GIÁ VẬT TƯ';

if (post.title.toLowerCase().includes('thép') || post.slug.includes('thep')) {
  ctaTitle = 'Cần Báo Giá Thép Xây Dựng Cho Công Trình?';
  ctaDesc = 'Gửi danh sách quy cách D6 – D25 hoặc số lượng dự kiến để Hoàng Yến gửi bảng báo giá xuất xưởng và hỗ trợ giao tận công trình.';
  ctaButtonText = 'NHẬN BÁO GIÁ THÉP';
} else if (post.title.toLowerCase().includes('xi măng') || post.slug.includes('xi-mang')) {
  ctaTitle = 'Cần Báo Giá Xi Măng Tận công trình?';
  ctaDesc = 'Cung ứng xi măng Bỉm Sơn, Nghi Sơn, Sông Gianh PCB30 & PCB40 theo bao 50kg với báo giá cạnh tranh tại Quảng Trị.';
  ctaButtonText = 'NHẬN BÁO GIÁ XI MĂNG';
} else if (post.title.toLowerCase().includes('gạch') || post.slug.includes('gach')) {
  ctaTitle = 'Cần Báo Giá Gạch Tuynel Đất Nung Chuẩn Kỹ Thuật?';
  ctaDesc = 'Cung cấp gạch tuynel 2 lỗ, 4 lỗ, 6 lỗ, gạch đặc nung chín đều, chịu lực tốt, hỗ trợ xe giao tận công trình.';
  ctaButtonText = 'NHẬN BÁO GIÁ GẠCH';
}
---

<Layout
  title={post.seo_title || `${post.title} | VLXD Hoàng Yến`}
  description={post.seo_description || post.summary}
  canonical={canonicalUrl}
  ogImage={post.featured_image}
  ogType="article"
  breadcrumbs={breadcrumbs}
  schemas={schemas}
>
  <div class="article-page-wrapper">
    <div class="container article-main-container">
      <div class="article-layout">
        
        <!-- MAIN ARTICLE COLUMN -->
        <article class="article-primary-column" itemscope itemtype="https://schema.org/NewsArticle">
          
          <!-- 1. Category Tag Badge -->
          <div class="article-tag-row">
            <a href={`/${categorySlug}/`} class="article-category-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <span>{categoryName}</span>
            </a>
          </div>

          <!-- 2. H1 Headline -->
          <h1 class="article-title" itemprop="headline">{post.title}</h1>

          <!-- 3. Article Meta (Author & Actual Date) -->
          <div class="article-meta-bar">
            <div class="meta-author">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #0284c7;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              <span>Biên soạn bởi: <strong>Chuyên viên Marketing - VLXD Hoàng Yến</strong></span>
            </div>
            <span class="meta-separator">•</span>
            <div class="meta-date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-red);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span>Cập nhật: <time datetime={post.published_at}>{formattedDate}</time></span>
            </div>
          </div>

          <!-- 5. Table of Contents (Mục Lục Tự Động) -->
          {tocItems.length > 0 && (
            <div class="article-toc-box" id="article-toc">
              <div class="toc-header" id="toc-toggle-btn" role="button" tabindex="0">
                <div class="toc-title-wrap">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color: var(--color-red);"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                  <span class="toc-main-title">Mục Lục Bài Viết</span>
                </div>
                <button type="button" class="toc-action-btn" aria-label="Đóng mở mục lục">[Ẩn]</button>
              </div>
              <nav class="toc-nav-body" id="toc-nav-body">
                <ol class="toc-ordered-list">
                  {tocItems.map(item => (
                    <li class={`toc-node toc-level-${item.level}`}>
                      <a href={`#${item.id}`} class="toc-link">{item.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </div>
          )}

          <!-- 6. Main Prose Industrial Content -->
          <div class="prose-industrial article-body-content" itemprop="articleBody" set:html={processedContent} />

          <!-- Disclaimer / Ghi chú miễn trừ kỹ thuật & giá -->
          <div class="article-disclaimer-card">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color: #d97706; flex-shrink: 0; margin-top: 2px;">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div class="disclaimer-content-wrap">
              <strong>Lưu ý tham khảo:</strong> Mọi thông số kỹ thuật, barem quy cách và công thức tính toán trong bài viết được biên soạn nhằm mục đích chia sẻ kiến thức xây dựng và tham khảo chuyên ngành. Quy cách sản phẩm thực tế, dung sai xuất xưởng và đơn giá có thể thay đổi theo từng nhà sản xuất và thời điểm mua hàng. Quý bạn đọc nên đối chiếu bản vẽ thiết kế công trình hoặc liên hệ trực tiếp Siêu thị VLXD Hoàng Yến để được hỗ trợ kiểm tra dữ liệu chính xác nhất.
            </div>
          </div>

          <div class="eeat-author-card">
            <div class="eeat-card-inner">
              <div class="eeat-left-col">
                <div class="eeat-photo-wrap">
                  <img
                    src="/images/chuyenvienmkt.png"
                    alt="Chuyên viên Marketing VLXD Hoàng Yến"
                    class="eeat-avatar-img"
                    width="104"
                    height="104"
                    loading="lazy"
                  />
                </div>
                <div class="eeat-social-row">
                  <a href="https://www.facebook.com/sieuthivlxdhoangyen/" target="_blank" rel="noopener noreferrer" class="eeat-social-btn" aria-label="Facebook" title="Facebook VLXD Hoàng Yến">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  </a>
                  <a href="https://zalo.me/0946575579" target="_blank" rel="noopener noreferrer" class="eeat-social-btn" aria-label="Zalo" title="Zalo Tư Vấn">
                    <svg width="15" height="15" viewBox="0 0 32 32" fill="currentColor"><path d="M16 2C8.28 2 2 8.28 2 16c0 2.56.68 4.96 1.86 7.04L2 30l7.18-1.84A13.93 13.93 0 0 0 16 30c7.72 0 14-6.28 14-14S23.72 2 16 2zm6.6 19.4c-.28.78-1.6 1.44-2.2 1.54-.56.1-1.26.14-2.04-.14-.48-.16-1.08-.38-1.86-.74-3.26-1.42-5.4-4.7-5.56-4.92-.16-.22-1.3-1.74-1.3-3.32s.82-2.36 1.12-2.68c.28-.32.62-.4.82-.4l.58.01c.2 0 .46-.08.72.54.28.64.94 2.3.02 2.48l-.52.28c-.2.12-.32.34-.22.58.44 1.02 1.32 2.12 2.3 2.86.98.74 2.04 1.22 2.78 1.44.22.06.46-.02.6-.22l.36-.52c.14-.2.36-.28.58-.18 1.48.72 2.3 1.08 2.5 1.22.2.14.28.42.02 1.16z"/></svg>
                  </a>
                  <a href="mailto:vlxdhoangyenqt@gmail.com" class="eeat-social-btn" aria-label="Email" title="Gửi Email">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  </a>
                </div>
              </div>
              <div class="eeat-right-col">
                <div class="eeat-header-row">
                  <div>
                    <h4 class="eeat-name">Chuyên viên Marketing</h4>
                    <span class="eeat-role">VLXD Hoàng Yến &mdash; Quảng Trị</span>
                  </div>
                  <span class="eeat-dept-tag">Nội dung &amp; SEO</span>
                </div>
                <p class="eeat-bio">
                  Phụ trách nội dung và SEO tại VLXD Hoàng Yến, tập trung vào các chủ đề vật liệu xây dựng, thiết bị vệ sinh, thông tin sản phẩm và nhu cầu tìm kiếm thực tế của khách hàng tại Quảng Trị.
                </p>
                <p class="eeat-bio eeat-bio-note">
                  Những thông tin về giá, tồn kho, quy cách và thông số kỹ thuật được cập nhật theo dữ liệu hiện có và cần được kiểm tra lại tại thời điểm mua hàng.
                </p>
                <a href="/gioi-thieu/" class="eeat-link">
                  <span>Tìm hiểu về VLXD Hoàng Yến</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- 8. Related Products Section (Commercial Interlinking) -->
          {relatedProducts.length > 0 && (
            <section class="article-related-products">
              <div class="section-title-bar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #0284c7;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                <h3 class="section-title">Sản Phẩm & Vật Tư Liên Quan</h3>
              </div>
              <div class="related-products-grid">
                {relatedProducts.map(p => (
                  <div class="rel-product-card">
                    <a href={`/san-pham/${p.slug}/`} class="rel-product-img">
                      <img src={p.featured_image || '/images/danh-muc/thep.png'} alt={p.name} loading="lazy" />
                    </a>
                    <div class="rel-product-details">
                      <span class="rel-product-sku">Mã: {p.sku || 'HY-VLXD'}</span>
                      <h4 class="rel-product-name">
                        <a href={`/san-pham/${p.slug}/`}>{p.name}</a>
                      </h4>
                      <div class="rel-product-bottom">
                        <span class="rel-product-price">Giá: Liên hệ</span>
                        <a href={`/san-pham/${p.slug}/`} class="btn-rel-view">Chi Tiết</a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- 9. Dynamic CTA Box -->
          <div class="article-cta-box">
            <div class="cta-inner">
              <div class="cta-badge">BÁO GIÁ NHÀ MÁY</div>
              <h3 class="cta-heading">{ctaTitle}</h3>
              <p class="cta-description">{ctaDesc}</p>
              <div class="cta-buttons-group">
                <a href={`tel:${settings.hotline_main}`} class="btn btn-cta-primary">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.23 2.09z"/>
                  </svg>
                  <span>{ctaButtonText} (0946.575.579)</span>
                </a>
                <a href={settings.zalo_url || `https://zalo.me/${settings.hotline_main.replace(/\s+/g, '')}`} target="_blank" rel="noopener noreferrer" class="btn btn-cta-secondary">
                  <span>GỬI DANH SÁCH QUA ZALO</span>
                </a>
              </div>
            </div>
          </div>

          <!-- 10. Related Articles Section -->
          {recentPosts.length > 0 && (
            <section class="article-related-posts">
              <div class="section-title-bar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-red);"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                <h3 class="section-title">Bài Viết & Cẩm Nang Liên Quan</h3>
              </div>
              <div class="related-posts-grid">
                {recentPosts.map(rp => (
                  <article class="rel-post-card">
                    <a href={`/tin-tuc/${rp.slug}/`} class="rel-post-thumb">
                      <img src={rp.featured_image || '/images/danh-muc/thep.png'} alt={rp.title} loading="lazy" />
                    </a>
                    <div class="rel-post-body">
                      <span class="rel-post-tag">{rp.category_name || 'Tin Tức'}</span>
                      <h4 class="rel-post-title">
                        <a href={`/tin-tuc/${rp.slug}/`}>{rp.title}</a>
                      </h4>
                      <p class="rel-post-desc">{rp.summary}</p>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}

