    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .store-badge-title {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 3px 0;
  }

  .store-badge-status {
