</style>

<script>
  // Tab Switching Handler
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      tabBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      tabPanes.forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const targetPane = document.getElementById(targetId);
      if (targetPane) {
        targetPane.classList.add('active');
      }
    });
  });

  // Product Detail Form Handling
  const productForm = document.getElementById('product-inquiry-form') as HTMLFormElement;
  const pSubmitBtn = document.getElementById('p-submit-btn') as HTMLButtonElement;
  const pStatusMsg = document.getElementById('p-status-msg');

  if (productForm && pSubmitBtn && pStatusMsg) {
    productForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      pSubmitBtn.disabled = true;
      pSubmitBtn.innerHTML = '<span>Đang gửi thông tin...</span>';

      const formData = new FormData(productForm);
      const payload = {
        customer_name: formData.get('customer_name'),
        customer_phone: formData.get('customer_phone'),
        notes: formData.get('notes'),
        product_name: formData.get('product_name')
      };

      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          pStatusMsg.className = 'status-msg success';
          pStatusMsg.style.display = 'block';
          pStatusMsg.textContent = 'Đã nhận yêu cầu! Đội ngũ tư vấn Hoàng Yến sẽ liên hệ báo giá chi tiết sớm nhất.';
          productForm.reset();
        } else {
          throw new Error(data.error || 'Có lỗi xảy ra.');
        }
      } catch (err: any) {
        pStatusMsg.className = 'status-msg error';
        pStatusMsg.style.display = 'block';
        pStatusMsg.textContent = 'Lỗi: ' + err.message;
      } finally {
        pSubmitBtn.disabled = false;
        pSubmitBtn.innerHTML = '<span>Gửi Yêu Cầu Báo Giá</span>';
      }
    });
  }

  // Product Review Form Handling
  const reviewForm = document.getElementById('product-review-form') as HTMLFormElement;
  const revSubmitBtn = document.getElementById('rev-submit-btn') as HTMLButtonElement;
  const revStatusMsg = document.getElementById('rev-status-msg');

  if (reviewForm && revSubmitBtn && revStatusMsg) {
    reviewForm.addEventListener('submit', (e) => {
      e.preventDefault();
      revSubmitBtn.disabled = true;
      revSubmitBtn.innerHTML = '<span>Đang gửi đánh giá...</span>';

      setTimeout(() => {
        revStatusMsg.className = 'status-msg success';
        revStatusMsg.style.display = 'block';
        revStatusMsg.textContent = 'Cảm ơn quý khách đã gửi đánh giá! Nhận xét sẽ được kiểm duyệt và hiển thị.';
        reviewForm.reset();
        revSubmitBtn.disabled = false;
        revSubmitBtn.innerHTML = '<span>Gửi Đánh Giá</span>';
      }, 500);
    });
  }
</script>
