---
import Layout from '../layouts/Layout.astro';
import { SettingsRepo } from '../server/db/repo.js';

const settings = await SettingsRepo.getAll();
const breadcrumbs = [
  { name: 'Trang Chủ', url: '/' },
  { name: 'Chính Sách Bảo Mật', url: '/chinh-sach-bao-mat/' }
];
---

<Layout
  title="Chính Sách Bảo Mật Thông Tin Khách Hàng | VLXD Hoàng Yến Quảng Trị"
  description="Chính sách bảo mật thông tin liên hệ và thông tin đơn hàng tại Siêu Thị VLXD Hoàng Yến."
  breadcrumbs={breadcrumbs}
  currentPath="/chinh-sach-bao-mat/"
>
  <div class="policy-page">
    <header class="policy-header">
      <div class="container">
        <div class="eyebrow">Quy Định Bảo Mật</div>
        <h1>Chính Sách Bảo Mật Thông Tin</h1>
        <p>Bảo vệ toàn diện thông tin liên hệ và dự toán công trình của quý khách hàng và đối tác.</p>
      </div>
    </header>

    <div class="container policy-body-container">
      <div class="policy-content prose-industrial">
        <h2>1. Mục Đích Thu Thập Thông Tin</h2>
        <p>
          Siêu Thị VLXD Hoàng Yến chỉ thu thập thông tin của quý khách khi quý khách gửi yêu cầu báo giá hoặc liên hệ đặt hàng, bao gồm: Họ tên, Số điện thoại/Zalo, Địa chỉ công trình và Khối lượng vật tư cần báo giá.
        </p>

        <h2>2. Phạm Vi Sử Dụng Thông Tin</h2>
        <ul>
          <li>Gửi bảng báo giá chi tiết, tiến độ giao hàng và chính sách chiết khấu.</li>
          <li>Điều phối xe giao hàng đúng địa chỉ công trình đã hẹn trước.</li>
          <li>Xuất hóa đơn GTGT điện tử và chứng từ bán hàng cho đối tác.</li>
        </ul>

        <h2>3. Quy Định Về Bảo Mật Thông Tin</h2>
        <p>
          Cửa hàng không chuyển giao hay chia sẻ thông tin liên hệ của khách hàng cho bên thứ ba vì mục đích thương mại khi chưa có sự đồng ý của khách hàng.
        </p>

        <div class="callout-box">
          <h3 style="font-size: 1.15rem; margin-top: 0; margin-bottom: 0.5rem; font-weight: 700;">Mọi Thắc Mắc Về Chính Sách Bảo Mật:</h3>
          <p>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display: inline-block; vertical-align: middle; margin-right: 4px; color: #1e293b;"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="22.01"></line><line x1="15" y1="22" x2="15" y2="22.01"></line><line x1="9" y1="6" x2="9" y2="6.01"></line><line x1="15" y1="6" x2="15" y2="6.01"></line><line x1="9" y1="10" x2="9" y2="10.01"></line><line x1="15" y1="10" x2="15" y2="10.01"></line><line x1="9" y1="14" x2="9" y2="14.01"></line><line x1="15" y1="14" x2="15" y2="14.01"></line><line x1="9" y1="18" x2="9" y2="18.01"></line><line x1="15" y1="18" x2="15" y2="18.01"></line></svg>
            <strong>{settings.company_name}</strong>
          </p>
          <p>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display: inline-block; vertical-align: middle; margin-right: 4px; color: #dc2626;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Địa chỉ: {settings.address}</span>
          </p>
          <p>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display: inline-block; vertical-align: middle; margin-right: 4px; color: #0284c7;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>Email: {settings.email}</span> &nbsp;|&nbsp; 
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display: inline-block; vertical-align: middle; margin-right: 4px; color: #16a34a;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>Hotline: {settings.hotline_main}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .policy-header {
    background-color: var(--color-concrete-light);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .policy-header p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .policy-body-container {
    padding-top: var(--space-10);
    padding-bottom: var(--space-20);
    max-width: 900px;
  }

  .policy-content h2 {
    font-size: 1.45rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-charcoal);
  }

  .policy-content p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .policy-content ul {
    margin-left: var(--space-6);
    margin-bottom: var(--space-6);
    font-size: 1rem;
    line-height: 1.7;
  }

  .policy-content li {
    margin-bottom: var(--space-2);
  }
</style>
