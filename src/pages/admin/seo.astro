<script>
  document.addEventListener('DOMContentLoaded', () => {
    // DOM Elements
    const searchInput = document.getElementById('seo-search-input') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement;
    const statusFilter = document.getElementById('seo-status-filter') as HTMLSelectElement;
    const tabButtons = document.querySelectorAll('.tab-btn-pill');
    const statCards = document.querySelectorAll('.seo-stat-card');
    const tableRows = document.querySelectorAll('.seo-row');
    const noResultsMsg = document.getElementById('no-results-msg');

    // Modal Elements
    const modal = document.getElementById('quick-edit-modal');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalForm = document.getElementById('quick-seo-form') as HTMLFormElement;
    const modalSubmitBtn = document.getElementById('modal-submit-btn') as HTMLButtonElement;
    
    const modalInputType = document.getElementById('modal-input-type') as HTMLInputElement;
    const modalInputId = document.getElementById('modal-input-id') as HTMLInputElement;
    const modalInputTitle = document.getElementById('modal-input-title') as HTMLInputElement;
    const modalInputDesc = document.getElementById('modal-input-desc') as HTMLTextAreaElement;
    const modalInputH1 = document.getElementById('modal-input-h1') as HTMLInputElement;
    const modalH1Group = document.getElementById('modal-h1-group');

    const modalTypeBadge = document.getElementById('modal-type-badge');
    const modalUrlSlug = document.getElementById('modal-url-slug');
    const modalPageName = document.getElementById('modal-page-name');
    
    const modalTitleCounter = document.getElementById('modal-title-counter');
    const modalTitleBar = document.getElementById('modal-title-bar');
    const modalDescCounter = document.getElementById('modal-desc-counter');
    const modalDescBar = document.getElementById('modal-desc-bar');

    const previewSlugText = document.getElementById('preview-slug-text');
    const previewTitleText = document.getElementById('preview-title-text');
    const previewDescText = document.getElementById('preview-desc-text');
    const toast = document.getElementById('seo-toast');

    let currentType = 'all';

    // Filter function
    function applyFilters() {
      const searchTerm = (searchInput?.value || '').trim().toLowerCase();
      const statusValue = statusFilter?.value || 'all';
      let visibleCount = 0;

      tableRows.forEach(row => {
        const tr = row as HTMLElement;
        const rowType = tr.getAttribute('data-type') || '';
        const rowName = tr.getAttribute('data-name') || '';
        const rowSlug = tr.getAttribute('data-slug') || '';
        const rowTitle = tr.getAttribute('data-title') || '';
        const titleLen = Number(tr.getAttribute('data-title-len')) || 0;
        const descLen = Number(tr.getAttribute('data-desc-len')) || 0;

        // 1. Type Match
        const matchType = (currentType === 'all' || rowType === currentType);

        // 2. Search Match
        const matchSearch = !searchTerm || rowName.includes(searchTerm) || rowSlug.includes(searchTerm) || rowTitle.includes(searchTerm);

        // 3. Status Match
        let matchStatus = true;
        if (statusValue === 'good') {
          matchStatus = (titleLen >= 40 && titleLen <= 65) && (descLen >= 110 && descLen <= 165);
        } else if (statusValue === 'title_long') {
          matchStatus = titleLen > 65;
        } else if (statusValue === 'title_short') {
          matchStatus = titleLen < 40;
        } else if (statusValue === 'meta_missing') {
          matchStatus = descLen === 0;
        }

        if (matchType && matchSearch && matchStatus) {
          tr.style.display = '';
          visibleCount++;
        } else {
          tr.style.display = 'none';
        }
      });

      if (noResultsMsg) {
        noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (clearSearchBtn) {
        clearSearchBtn.style.display = searchTerm ? 'block' : 'none';
      }
    }

    // Tab Switch
    function setTab(type: string) {
      currentType = type;
      tabButtons.forEach(btn => {
        if (btn.getAttribute('data-type') === type) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      statCards.forEach(card => {
        if (card.getAttribute('data-tab-trigger') === type) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });

      applyFilters();
    }

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type') || 'all';
        setTab(type);
      });
    });

    statCards.forEach(card => {
      card.addEventListener('click', () => {
        const type = card.getAttribute('data-tab-trigger') || 'all';
        setTab(type);
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    statusFilter?.addEventListener('change', applyFilters);

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      applyFilters();
    });

    // Modal Live Preview Calculations
    function updateLivePreview() {
      const title = (modalInputTitle?.value || '').trim();
      const desc = (modalInputDesc?.value || '').trim();
      const titleLen = title.length;
      const descLen = desc.length;

      // Title Counter & Bar
      if (modalTitleCounter) {
        modalTitleCounter.textContent = `${titleLen} / 60 ký tự`;
        if (titleLen >= 40 && titleLen <= 65) {
          modalTitleCounter.className = 'char-meter good';
        } else if (titleLen > 65) {
          modalTitleCounter.className = 'char-meter warning';
        } else {
          modalTitleCounter.className = 'char-meter info';
        }
      }

      if (modalTitleBar) {
        const pct = Math.min(100, Math.round((titleLen / 60) * 100));
        modalTitleBar.style.width = `${pct}%`;
        if (titleLen >= 40 && titleLen <= 65) {
          modalTitleBar.className = 'progress-bar-inner good';
        } else if (titleLen > 65) {
          modalTitleBar.className = 'progress-bar-inner warning';
        } else {
          modalTitleBar.className = 'progress-bar-inner info';
        }
      }

      // Desc Counter & Bar
      if (modalDescCounter) {
        modalDescCounter.textContent = `${descLen} / 155 ký tự`;
        if (descLen >= 115 && descLen <= 165) {
          modalDescCounter.className = 'char-meter good';
        } else if (descLen > 165) {
          modalDescCounter.className = 'char-meter warning';
        } else {
          modalDescCounter.className = 'char-meter info';
        }
      }

      if (modalDescBar) {
        const pct = Math.min(100, Math.round((descLen / 155) * 100));
        modalDescBar.style.width = `${pct}%`;
        if (descLen >= 115 && descLen <= 165) {
          modalDescBar.className = 'progress-bar-inner good';
        } else if (descLen > 165) {
          modalDescBar.className = 'progress-bar-inner warning';
        } else {
          modalDescBar.className = 'progress-bar-inner info';
        }
      }

      // Google Snippet Preview Texts
      if (previewTitleText) {
        previewTitleText.textContent = title || 'Tiêu Đề Trang | VLXD Hoàng Yến';
      }
      if (previewDescText) {
        previewDescText.textContent = desc || 'Đoạn mô tả ngắn hiển thị bên dưới tiêu đề trên Google tìm kiếm...';
      }
    }

    modalInputTitle?.addEventListener('input', updateLivePreview);
    modalInputDesc?.addEventListener('input', updateLivePreview);

    // Open Quick Edit Modal
    document.querySelectorAll('.btn-quick-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-edit-type') || '';
        const id = btn.getAttribute('data-edit-id') || '';
        const name = btn.getAttribute('data-edit-name') || '';
        const url = btn.getAttribute('data-edit-url') || '';
        const title = btn.getAttribute('data-edit-title') || '';
        const desc = btn.getAttribute('data-edit-desc') || '';
        const h1 = btn.getAttribute('data-edit-h1') || '';

        if (modalInputType) modalInputType.value = type;
        if (modalInputId) modalInputId.value = id;
        if (modalInputTitle) modalInputTitle.value = title;
        if (modalInputDesc) modalInputDesc.value = desc;
        if (modalInputH1) modalInputH1.value = h1;

        if (modalPageName) modalPageName.textContent = `Chỉnh Sửa SEO: ${name}`;
        if (modalUrlSlug) modalUrlSlug.textContent = url;
        if (previewSlugText) previewSlugText.textContent = `https://vlxdhoangyen.com${url.startsWith('/') ? url : '/' + url}`;

        if (modalTypeBadge) {
          modalTypeBadge.textContent = type === 'category' ? 'Danh Mục' : (type === 'brand' ? 'Thương Hiệu' : (type === 'post' ? 'Bài Viết' : (type === 'product' ? 'Sản Phẩm' : 'Trang')));
          modalTypeBadge.className = `type-badge ${type === 'category' ? 'badge-cat' : (type === 'brand' ? 'badge-brand' : (type === 'post' ? 'badge-post' : (type === 'product' ? 'badge-product' : 'badge-page')))}`;
        }

        if (modalH1Group) {
          const h1Label = modalH1Group.querySelector('label strong');
          if (h1Label) {
            h1Label.textContent = type === 'post' ? 'Tiêu Đề Bài Viết (H1/Title) *' : (type === 'product' ? 'Tên Sản Phẩm (H1) *' : 'Thẻ Tiêu Đề H1 Danh Mục');
          }
          modalH1Group.style.display = (type === 'category' || type === 'post' || type === 'product') ? 'block' : 'none';
        }

        updateLivePreview();

        if (modal) {
          modal.style.display = 'flex';
          modalInputTitle?.focus();
        }
      });
    });

    // Close Modal
    function closeModal() {
      if (modal) modal.style.display = 'none';
    }

    modalCloseBtn?.addEventListener('click', closeModal);
    modalCancelBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Show Toast
    function showToast(message: string, isError = false) {
      if (!toast) return;
      toast.textContent = message;
      toast.style.background = isError ? '#ef4444' : '#0f172a';
      toast.style.display = 'flex';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 3500);
    }

    // Form Submit (AJAX)
    modalForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!modalSubmitBtn) return;

      const type = modalInputType.value;
      const id = modalInputId.value;
      const seo_title = modalInputTitle.value.trim();
      const seo_description = modalInputDesc.value.trim();
      const h1 = modalInputH1?.value?.trim();

      modalSubmitBtn.disabled = true;
      modalSubmitBtn.innerHTML = '<span>Đang Lưu...</span>';

      try {
        const res = await fetch('/api/admin/quick-seo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, id, seo_title, seo_description, h1 })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          showToast('✓ Đã cập nhật tiêu đề & meta SEO thành công!');
          
          // Update table row in realtime
          const titleDisplay = document.getElementById(`title-display-${type}-${id}`);
          const titleCount = document.getElementById(`title-count-${type}-${id}`);
          const descDisplay = document.getElementById(`desc-display-${type}-${id}`);
          const descCount = document.getElementById(`desc-count-${type}-${id}`);

          if (titleDisplay) titleDisplay.textContent = seo_title;
          if (descDisplay) descDisplay.textContent = seo_description || 'Chưa cấu hình Meta Description';

          const titleLen = seo_title.length;
          const descLen = seo_description.length;
          const isTitleGood = titleLen >= 40 && titleLen <= 65;
          const isDescGood = descLen >= 110 && descLen <= 165;

          if (titleCount) {
            titleCount.textContent = `${titleLen} ký tự ${isTitleGood ? '✓' : (titleLen > 65 ? '⚠️ Quá dài' : '')}`;
            titleCount.className = `len-badge ${isTitleGood ? 'good' : (titleLen > 65 ? 'warning' : 'info')}`;
          }

          if (descCount) {
            descCount.textContent = `${descLen} ký tự ${isDescGood ? '✓' : (descLen === 0 ? '⚠️ Thiếu' : '')}`;
            descCount.className = `len-badge ${isDescGood ? 'good' : (descLen > 165 ? 'warning' : 'info')}`;
          }

          // Update trigger button data attributes
          const triggerBtn = document.querySelector(`.btn-quick-edit[data-edit-type="${type}"][data-edit-id="${id}"]`);
          if (triggerBtn) {
            triggerBtn.setAttribute('data-edit-title', seo_title);
            triggerBtn.setAttribute('data-edit-desc', seo_description);
            if (h1) triggerBtn.setAttribute('data-edit-h1', h1);
          }

          // Update tr data attributes for filtering
          const rowTr = document.querySelector(`tr.seo-row[data-type="${type}"][data-id="${id}"]`);
          if (rowTr) {
            rowTr.setAttribute('data-title', seo_title.toLowerCase());
            rowTr.setAttribute('data-title-len', titleLen.toString());
            rowTr.setAttribute('data-desc-len', descLen.toString());
          }

          closeModal();
        } else {
          throw new Error(data.error || 'Có lỗi xảy ra khi cập nhật.');
        }
      } catch (err: any) {
        showToast('Lỗi: ' + err.message, true);
      } finally {
        modalSubmitBtn.disabled = false;
        modalSubmitBtn.innerHTML = '<span>Lưu Cập Nhật SEO</span>';
      }
    });

  });
</script>
