---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CategoryRepo, BrandRepo, ProductRepo, PostRepo, SettingsRepo } from '../../server/db/repo.js';

// Fetch all data for SEO management
const categories = await CategoryRepo.getAll();
const brands = await BrandRepo.getAll();
const posts = await PostRepo.getAll('all');
const productsResult = await ProductRepo.getAll({ limit: 500, status: 'all' });
const products = productsResult.products || [];
const settings = await SettingsRepo.getAll();

// Static Pages list
const staticPages = [
  {
    id: 'home',
    type: 'setting',
    name: 'Trang Chủ',
    slug: '/',
    url: '/',
    seo_title: settings.default_seo_title || 'Siêu Thị VLXD Hoàng Yến | Vật Liệu Xây Dựng & Thiết Bị Vệ Sinh Tại Quảng Trị',
    seo_description: settings.default_seo_desc || 'Siêu Thị Vật Liệu Xây Dựng Hoàng Yến tại 299 Lê Duẩn, TP. Đông Hà, Quảng Trị. Cung cấp xi măng, sắt thép, gạch ngói, tôn, thiết bị vệ sinh.'
  },
  {
    id: 'san-pham',
    type: 'setting',
    name: 'Tất Cả Sản Phẩm',
    slug: 'san-pham',
    url: '/san-pham/',
    seo_title: 'Sản Phẩm Vật Liệu Xây Dựng Tại Quảng Trị | Báo Giá - VLXD Hoàng Yến',
    seo_description: 'Danh mục vật liệu xây dựng thô và thiết bị vệ sinh tại Quảng Trị. Báo giá sắt thép, xi măng, tôn lợp, gạch ốp lát tại Đông Hà.'
  },
  {
    id: 'lien-he',
    type: 'setting',
    name: 'Liên Hệ & Bản Đồ Cửa Hàng',
    slug: 'lien-he',
    url: '/lien-he/',
    seo_title: 'Liên Hệ & Bản Đồ Cửa Hàng | Siêu Thị VLXD Hoàng Yến Quảng Trị',
    seo_description: 'Thông tin liên hệ, hotline tư vấn kỹ thuật và vị trí cửa hàng VLXD Hoàng Yến tại 299 Lê Duẩn, TP. Đông Hà, Quảng Trị.'
  },
  {
    id: 'gioi-thieu',
    type: 'setting',
    name: 'Giới Thiệu Doanh Nghiệp',
    slug: 'gioi-thieu',
    url: '/gioi-thieu/',
    seo_title: 'Giới Thiệu Siêu Thị VLXD Hoàng Yến | Hơn 20 Năm Đồng Hành Cùng Quảng Trị',
    seo_description: 'Tìm hiểu về Siêu Thị VLXD Hoàng Yến - Đơn vị cung ứng vật liệu xây dựng và thiết bị vệ sinh hàng đầu tại Đông Hà, Quảng Trị từ năm 2003.'
  },
  {
    id: 'tin-tuc',
    type: 'setting',
    name: 'Tin Tức & Báo Giá',
    slug: 'tin-tuc',
    url: '/tin-tuc/',
    seo_title: 'Tin Tức & Cập Nhật Giá Vật Liệu Xây Dựng Quảng Trị | VLXD Hoàng Yến',
    seo_description: 'Cập nhật bản tin thị trường vật tư xây dựng, xu hướng thiết bị vệ sinh và kinh nghiệm chọn mua vật liệu tại Quảng Trị.'
  },
  {
    id: 'cau-hoi-thuong-gap',
    type: 'setting',
    name: 'Câu Hỏi Thường Gặp (FAQ)',
    slug: 'cau-hoi-thuong-gap',
    url: '/cau-hoi-thuong-gap/',
    seo_title: 'Câu Hỏi Thường Gặp Khi Mua VLXD Tại Quảng Trị | Hoàng Yến',
    seo_description: 'Giải đáp các thắc mắc phổ biến về quy cách vật liệu, phương thức đặt hàng, giao nhận và thanh toán tại VLXD Hoàng Yến.'
  },
  {
    id: 'chinh-sach-van-chuyen',
    type: 'setting',
    name: 'Chính Sách Vận Chuyển',
    slug: 'chinh-sach-van-chuyen',
    url: '/chinh-sach-van-chuyen/',
    seo_title: 'Chính Sách Giao Nhận & Vận Chuyển | VLXD Hoàng Yến Quảng Trị',
    seo_description: 'Thông tin phương thức giao nhận vật liệu xây dựng tận chân công trình tại Đông Hà và các huyện lân cận thuộc tỉnh Quảng Trị.'
  },
  {
    id: 'chinh-sach-thanh-toan',
    type: 'setting',
    name: 'Chính Sách Thanh Toán',
    slug: 'chinh-sach-thanh-toan',
    url: '/chinh-sach-thanh-toan/',
    seo_title: 'Chính Sách Thanh Toán | Siêu Thị VLXD Hoàng Yến Quảng Trị',
    seo_description: 'Quy trình thanh toán an toàn, minh bạch bằng tiền mặt hoặc chuyển khoản ngân hàng có xuất hóa đơn GTGT đầy đủ.'
  },
  {
    id: 'chinh-sach-doi-tra',
    type: 'setting',
    name: 'Chính Sách Đổi Trả & Kiểm Hàng',
    slug: 'chinh-sach-doi-tra',
    url: '/chinh-sach-doi-tra/',
    seo_title: 'Chính Sách Đổi Trả & Kiểm Hàng | VLXD Hoàng Yến',
    seo_description: 'Quy định kiểm tra số lượng, quy cách hàng hóa khi giao nhận và quy trình xử lý đổi trả vật tư hợp lệ.'
  }
];

// Unified item list
const allItems = [
  ...staticPages.map(p => ({
    type: 'setting' as const,
    typeName: 'Trang Cố Định',
    typeBadgeClass: 'badge-page',
    id: p.id,
    name: p.name,
    slug: p.slug,
    url: p.url,
    seo_title: p.seo_title,
    seo_description: p.seo_description,
    h1: ''
  })),
  ...categories.map(c => ({
    type: 'category' as const,
    typeName: c.parent_id ? 'Danh Mục Con' : 'Danh Mục Chính',
    typeBadgeClass: c.parent_id ? 'badge-subcat' : 'badge-cat',
    id: c.id,
    name: c.name,
    slug: c.slug,
    url: `/${c.slug}/`,
    seo_title: c.seo_title || c.name,
    seo_description: c.seo_description || c.description || '',
    h1: c.h1 || c.name
  })),
  ...brands.map(b => ({
    type: 'brand' as const,
    typeName: 'Thương Hiệu',
    typeBadgeClass: 'badge-brand',
    id: b.id,
    name: b.name,
    slug: b.slug,
    url: `/san-pham/${b.slug}/`,
    seo_title: b.seo_title || `${b.name} Tại Quảng Trị | Báo Giá - VLXD Hoàng Yến`,
    seo_description: b.seo_description || b.description || '',
    h1: ''
  })),
  ...posts.map(p => ({
    type: 'post' as const,
    typeName: 'Bài Viết',
    typeBadgeClass: 'badge-post',
    id: p.id,
    name: p.title,
    slug: p.slug,
    url: `/tin-tuc/${p.slug}/`,
    seo_title: p.seo_title || p.title,
    seo_description: p.seo_description || p.summary || '',
    h1: p.title
  })),
  ...products.map(pr => ({
    type: 'product' as const,
    typeName: 'Sản Phẩm',
    typeBadgeClass: 'badge-product',
    id: pr.id,
    name: pr.name,
    slug: pr.slug,
    url: `/${pr.slug}/`,
    seo_title: pr.seo_title || `${pr.name} Tại Quảng Trị - Báo Giá | VLXD Hoàng Yến`,
    seo_description: pr.seo_description || pr.short_description || '',
    h1: pr.name
  }))
];

// Pre-calculate lengths & statuses in frontmatter
const preparedItems = allItems.map(item => {
  const titleLen = item.seo_title ? item.seo_title.length : 0;
  const descLen = item.seo_description ? item.seo_description.length : 0;
  const isTitleGood = titleLen >= 40 && titleLen <= 65;
  const isDescGood = descLen >= 110 && descLen <= 165;
  return {
    ...item,
    titleLen,
    descLen,
    isTitleGood,
    isDescGood
  };
});

// Stats
const totalItems = allItems.length;
const totalCats = categories.length;
const totalBrands = brands.length;
const totalPages = staticPages.length;
const totalPosts = posts.length;
const totalProducts = products.length;
---

<AdminLayout title="Quản Lý Tiêu Đề & Meta SEO" activeNav="seo">
  <div class="seo-admin-page">
    
    <!-- Page Header -->
    <div class="page-header-seo">
      <div class="header-left">
        <div class="header-eyebrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          Tối Ưu Hóa Công Cụ Tìm Kiếm
        </div>
        <h1>Quản Lý Tiêu Đề & Meta SEO (Quick Edit)</h1>
        <p class="header-subtitle">
          Xem và chỉnh sửa trực tiếp <strong>Thẻ Tiêu Đề (Title Tag)</strong> và <strong>Thẻ Mô Tả (Meta Description)</strong> của toàn bộ Danh mục, Thương hiệu, Trang tĩnh, Bài viết và Sản phẩm mà không cần mở từng trang chi tiết.
        </p>
      </div>

      <div class="header-actions">
        <a href="/sitemap.xml" target="_blank" class="btn-sitemap-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Xem Sitemap XML ↗</span>
        </a>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="seo-stats-grid">
      <div class="seo-stat-card active" data-tab-trigger="all">
        <div class="stat-number">{totalItems}</div>
        <div class="stat-label">Tổng Số Trang Quản Lý</div>
      </div>
      <div class="seo-stat-card" data-tab-trigger="category">
        <div class="stat-number">{totalCats}</div>
        <div class="stat-label">Danh Mục Sản Phẩm</div>
      </div>
      <div class="seo-stat-card" data-tab-trigger="brand">
        <div class="stat-number">{totalBrands}</div>
        <div class="stat-label">Thương Hiệu</div>
      </div>
      <div class="seo-stat-card" data-tab-trigger="setting">
        <div class="stat-number">{totalPages}</div>
        <div class="stat-label">Trang Tĩnh Cố Định</div>
      </div>
      <div class="seo-stat-card" data-tab-trigger="post">
        <div class="stat-number">{totalPosts}</div>
        <div class="stat-label">Bài Viết Tin Tức</div>
      </div>
      <div class="seo-stat-card" data-tab-trigger="product">
        <div class="stat-number">{totalProducts}</div>
        <div class="stat-label">Sản Phẩm Đang Bán</div>
      </div>
    </div>

    <!-- Main Content Container -->
    <div class="seo-table-card">
      
      <!-- Filter Toolbar -->
      <div class="seo-toolbar">
        <!-- Tab Buttons -->
        <div class="seo-tabs-bar" role="tablist">
          <button type="button" class="tab-btn-pill active" data-type="all">Tất Cả ({totalItems})</button>
          <button type="button" class="tab-btn-pill" data-type="category">Danh Mục ({totalCats})</button>
          <button type="button" class="tab-btn-pill" data-type="brand">Thương Hiệu ({totalBrands})</button>
          <button type="button" class="tab-btn-pill" data-type="setting">Trang Cố Định ({totalPages})</button>
          <button type="button" class="tab-btn-pill" data-type="post">Bài Viết ({totalPosts})</button>
          <button type="button" class="tab-btn-pill" data-type="product">Sản Phẩm ({totalProducts})</button>
        </div>

        <!-- Search & Length Filter -->
        <div class="seo-filter-controls">
          <div class="search-input-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="seo-search-input" placeholder="Tìm kiếm theo tên trang, slug, tiêu đề..." class="search-input" />
            <button type="button" id="clear-search-btn" class="clear-btn" style="display: none;">&times;</button>
          </div>

          <select id="seo-status-filter" class="filter-select">
            <option value="all">Tất Cả Trạng Thái</option>
            <option value="good">✓ Chuẩn SEO (Title 45-65 kt, Meta 120-160 kt)</option>
            <option value="title_long">⚠️ Tiêu đề quá dài (trên 65 ký tự)</option>
            <option value="title_short">⚠️ Tiêu đề quá ngắn (dưới 40 ký tự)</option>
            <option value="meta_missing">⚠️ Thiếu thẻ Meta Description</option>
          </select>
        </div>
      </div>

      <!-- SEO Items Table -->
      <div class="table-responsive">
        <table class="seo-table" id="seo-items-table">
          <thead>
            <tr>
              <th style="width: 280px;">Trang & Đường Dẫn</th>
              <th>Tiêu Đề Trang (Title Tag)</th>
              <th>Thẻ Mô Tả (Meta Description)</th>
              <th style="width: 140px; text-align: center;">Thao Tác</th>
            </tr>
          </thead>
          <tbody id="seo-tbody">
            {preparedItems.map((item) => (
              <tr 
                class="seo-row" 
                data-type={item.type}
                data-id={item.id}
                data-name={item.name.toLowerCase()}
                data-slug={item.slug.toLowerCase()}
                data-title={item.seo_title.toLowerCase()}
                data-title-len={item.titleLen}
                data-desc-len={item.descLen}
              >
                  <!-- Col 1: Page & URL -->
                  <td class="col-page">
                    <div class="page-meta-box">
                      <div class="page-title-row">
                        <span class={`type-badge ${item.typeBadgeClass}`}>{item.typeName}</span>
                        <strong class="item-name">{item.name}</strong>
                      </div>
                      <div class="page-slug-row">
                        <span class="slug-text">{item.url}</span>
                        <a href={item.url} target="_blank" rel="noopener noreferrer" class="view-live-btn" title="Mở xem trang thực tế">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        </a>
                      </div>
                    </div>
                  </td>

                  <!-- Col 2: SEO Title -->
                  <td class="col-title">
                    <div class="title-cell-wrap">
                      <div class="title-text" id={`title-display-${item.type}-${item.id}`}>{item.seo_title}</div>
                      <div class="counter-badge-wrap">
                        <span class={`len-badge ${item.isTitleGood ? 'good' : (item.titleLen > 65 ? 'warning' : 'info')}`} id={`title-count-${item.type}-${item.id}`}>
                          {item.titleLen} ký tự {item.isTitleGood ? '✓' : (item.titleLen > 65 ? '⚠️ Quá dài' : '')}
                        </span>
                      </div>
                    </div>
                  </td>

                  <!-- Col 3: Meta Description -->
                  <td class="col-desc">
                    <div class="desc-cell-wrap">
                      <div class="desc-text" id={`desc-display-${item.type}-${item.id}`}>
                        {item.seo_description ? item.seo_description : <em class="empty-meta-text">Chưa cấu hình Meta Description</em>}
                      </div>
                      <div class="counter-badge-wrap">
                        <span class={`len-badge ${item.isDescGood ? 'good' : (item.descLen > 165 ? 'warning' : 'info')}`} id={`desc-count-${item.type}-${item.id}`}>
                          {item.descLen} ký tự {item.isDescGood ? '✓' : (item.descLen === 0 ? '⚠️ Thiếu' : '')}
                        </span>
                      </div>
                    </div>
                  </td>

                  <!-- Col 4: Action -->
                  <td class="col-actions">
                    <button 
                      type="button" 
                      class="btn-quick-edit"
                      data-edit-type={item.type}
                      data-edit-id={item.id}
                      data-edit-name={item.name}
                      data-edit-url={item.url}
                      data-edit-title={item.seo_title}
                      data-edit-desc={item.seo_description}
                      data-edit-h1={item.h1 || ''}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                      <span>Sửa Nhanh</span>
                    </button>
                  </td>
                </tr>
            ))}
          </tbody>
        </table>

        <div id="no-results-msg" class="no-results-box" style="display: none;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <p>Không tìm thấy trang nào phù hợp với từ khóa hoặc bộ lọc đã chọn.</p>
        </div>
      </div>

    </div>

    <!-- Quick Edit Modal -->
    <div id="quick-edit-modal" class="modal-overlay" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <div class="modal-header-info">
            <div class="modal-eyebrow">
              <span id="modal-type-badge" class="type-badge badge-cat">Danh Mục</span>
              <span id="modal-url-slug" class="modal-url-text">/xi-mang/</span>
            </div>
            <h3 id="modal-page-name">Chỉnh Sửa SEO: Xi Măng</h3>
          </div>
          <button type="button" id="modal-close-btn" class="modal-close-icon">&times;</button>
        </div>

        <form id="quick-seo-form" class="modal-body">
          <input type="hidden" id="modal-input-type" />
          <input type="hidden" id="modal-input-id" />

          <!-- Field 1: SEO Title -->
          <div class="form-group-seo">
            <div class="label-row">
              <label for="modal-input-title"><strong>Tiêu Đề Trang (Title Tag) *</strong></label>
              <span id="modal-title-counter" class="char-meter good">0 / 60 ký tự</span>
            </div>
            <input 
              type="text" 
              id="modal-input-title" 
              required 
              class="seo-input" 
              placeholder="Nhập tiêu đề trang hiển thị trên tab trình duyệt & Google..." 
            />
            <div class="progress-bar-wrap">
              <div id="modal-title-bar" class="progress-bar-inner good" style="width: 80%;"></div>
            </div>
            <small class="field-hint">💡 Độ dài lý tưởng: <strong>50 – 65 ký tự</strong>. Chứa từ khóa chính + thương hiệu Hoàng Yến.</small>
          </div>

          <!-- Field 2: Meta Description -->
          <div class="form-group-seo">
            <div class="label-row">
              <label for="modal-input-desc"><strong>Thẻ Mô Tả (Meta Description) *</strong></label>
              <span id="modal-desc-counter" class="char-meter good">0 / 155 ký tự</span>
            </div>
            <textarea 
              id="modal-input-desc" 
              rows="3" 
              class="seo-textarea" 
              placeholder="Nhập đoạn tóm tắt hấp dẫn hiển thị bên dưới tiêu đề trên Google Search..."
            ></textarea>
            <div class="progress-bar-wrap">
              <div id="modal-desc-bar" class="progress-bar-inner good" style="width: 80%;"></div>
            </div>
            <small class="field-hint">💡 Độ dài lý tưởng: <strong>125 – 160 ký tự</strong>. Tóm tắt súc tích, trung thực, có địa danh Quảng Trị.</small>
          </div>

          <!-- Field 3 (Conditional for categories): H1 tag -->
          <div class="form-group-seo" id="modal-h1-group" style="display: none;">
            <div class="label-row">
              <label for="modal-input-h1"><strong>Thẻ Tiêu Đề H1 Chính Của Trang</strong></label>
            </div>
            <input 
              type="text" 
              id="modal-input-h1" 
              class="seo-input" 
              placeholder="Tiêu đề H1 lớn nhất trên đầu trang danh mục..." 
            />
          </div>

          <!-- Live Google Search Result Preview (Google SERP Snippet) -->
          <div class="google-preview-box">
            <div class="preview-header">
              <div class="preview-title-wrap">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                <span>Xem Trước Hiển Thị Trên Google Tìm Kiếm (SERP Preview)</span>
              </div>
              <span class="preview-device-tag">Google Desktop & Mobile</span>
            </div>

            <div class="google-snippet-card">
              <div class="snippet-source">
                <div class="google-favicon">
                  <img src="/favicon.ico" alt="Favicon" width="16" height="16" onerror="this.style.display='none'" />
                </div>
                <div class="snippet-url-group">
                  <span class="snippet-domain">vlxdhoangyen.com</span>
                  <span class="snippet-path" id="preview-slug-text">https://vlxdhoangyen.com/xi-mang/</span>
                </div>
              </div>
              <div class="snippet-title" id="preview-title-text">
                Xi Măng Xây Dựng Tại Quảng Trị | Báo Giá Xi Măng - Hoàng Yến
              </div>
              <div class="snippet-desc" id="preview-desc-text">
