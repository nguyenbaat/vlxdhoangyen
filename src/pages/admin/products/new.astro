---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BlockEditor from '../../../components/admin/BlockEditor.astro';
import MediaManager from '../../../components/admin/MediaManager.astro';
import AIAssistantModal from '../../../components/admin/AIAssistantModal.astro';
import { ProductRepo, CategoryRepo, BrandRepo } from '../../../server/db/repo.js';

let errorMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get('name')?.toString().trim() || '';
    let slug = formData.get('slug')?.toString().trim() || '';
    const category_id = Number(formData.get('category_id')) || undefined;
    const brand_id = Number(formData.get('brand_id')) || null;
    const custom_badge = formData.get('custom_badge')?.toString().trim() || '';
    const sku = formData.get('sku')?.toString().trim() || '';
    const price = Number(formData.get('price')) || 0;
    const unit = formData.get('unit')?.toString().trim() || 'Bao';
    const short_description = formData.get('short_description')?.toString().trim() || '';
    const content = formData.get('content')?.toString() || '';
    const specifications = formData.get('specifications')?.toString() || '';
    const featured_image = formData.get('featured_image')?.toString().trim() || '';
    const gallery_str = formData.get('gallery')?.toString() || '';
    const seo_title = formData.get('seo_title')?.toString().trim() || name;
    const seo_description = formData.get('seo_description')?.toString().trim() || short_description;
    const is_featured = formData.get('is_featured') === 'on' ? 1 : 0;
    const is_in_stock = formData.get('is_in_stock') === 'on' ? 1 : 0;
    const status = formData.get('status')?.toString() || 'published';

    if (!name) {
      throw new Error('Vui lòng nhập tên sản phẩm.');
    }

    if (!slug) {
      slug = name
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    const gallery_alts_json = formData.get('gallery_alts_json')?.toString() || '';
    let imageItems: Array<{ url: string; alt?: string }> = [];
    
    if (gallery_alts_json) {
      try {
        const parsed = JSON.parse(gallery_alts_json);
        if (Array.isArray(parsed) && parsed.length > 0) {
          imageItems = parsed
            .filter(item => Boolean(item?.url))
            .map(item => ({
              url: item.url.trim(),
              alt: item.alt?.trim() || name
            }));
        }
      } catch (e) {}
    }

    if (imageItems.length === 0) {
      const images = gallery_str
        .split('\n')
        .map(s => s.trim())
        .filter(s => s.length > 0);

      if (featured_image && !images.includes(featured_image)) {
        images.unshift(featured_image);
      }
      imageItems = images.map(url => ({ url, alt: name }));
    }

    const finalFeaturedImage = featured_image || (imageItems[0]?.url || '');

    await ProductRepo.create({
      name,
      slug,
      category_id,
      brand_id,
      custom_badge,
      sku,
      price,
      unit,
      short_description,
      content,
      specifications,
      featured_image: finalFeaturedImage,
      seo_title,
      seo_description,
      is_featured,
      is_in_stock,
      status,
      images: imageItems
    });

    return Astro.redirect('/admin/products');
  } catch (err: any) {
    errorMsg = err.message;
  }
}

const categories = await CategoryRepo.getAll(false);
const brands = await BrandRepo.getAll();
---

<AdminLayout title="Thêm Sản Phẩm Mới (WordPress Style / AI)" activeNav="products">
  <div class="product-editor-page">
    
    <!-- Top Bar -->
    <div class="product-topbar">
      <div class="topbar-left">
        <a href="/admin/products" class="btn-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>Danh Sách Sản Phẩm</span>
        </a>
        <span class="topbar-divider">|</span>
        <h1 class="page-title">Thêm Sản Phẩm Mới</h1>
      </div>

      <div class="topbar-right">
        <!-- AI Generator Trigger Button -->
        <button type="button" id="btn-open-ai-product" class="btn-ai-sparkle">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span>✨ AI Viết Sản Phẩm & SEO</span>
        </button>
      </div>
    </div>

    {errorMsg && <div class="error-box">{errorMsg}</div>}

    <form method="POST" class="admin-form-card" id="product-form">
      <div class="form-grid-2">
        <div class="col-main">
          
          <div class="form-group-wp-title">
            <label for="name">Tên Sản Phẩm *</label>
            <input type="text" id="name" name="name" placeholder="Ví dụ: Xi Măng Bỉm Sơn PCB40 Con Voi..." class="wp-title-input" required />
          </div>

          <div class="wp-slug-bar">
            <span class="slug-label">Đường dẫn:</span>
            <span class="slug-domain">https://vlxdhoangyen.com/</span>
            <input type="text" id="slug" name="slug" placeholder="xi-mang-bim-son-pcb40" class="slug-input" />
            <button type="button" id="btn-sync-prod-slug" class="btn-slug-action">🔄 Tạo từ tên</button>
          </div>

          <div class="form-group" style="margin-top: 1rem;">
            <label for="short_description">Mô Tả Ngắn Sản Phẩm (Tóm tắt nổi bật)</label>
            <textarea id="short_description" name="short_description" rows="3" placeholder="Tóm tắt đặc tính nổi bật, quy cách và ứng dụng sản phẩm..."></textarea>
          </div>

          <div class="editor-section-card" style="margin-top: 1.5rem;">
            <BlockEditor
              initialContent=""
              name="content"
              id="product_content"
              label="1. Nội Dung Mô Tả Chi Tiết Sản Phẩm (Bài viết giới thiệu & ưu điểm)"
            />
          </div>

          <div class="editor-section-card" style="margin-top: 1.5rem;">
            <BlockEditor
              initialContent=""
              name="specifications"
              id="product_specs"
              label="2. Thông Số Kỹ Thuật & Barem Quy Cách (Chèn bảng thông số, quy cách mác)"
            />
          </div>

          <!-- Yoast SEO Box -->
          <div class="seo-fieldset">
            <div class="seo-header-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <h3>Tối Ưu SEO Sản Phẩm (Google Search)</h3>
            </div>
            
            <div class="form-group">
              <div class="label-flex">
                <label for="seo_title">SEO Title (Tiêu đề Google)</label>
                <span id="seo-title-len" class="badge-counter info">0 / 60 kt</span>
              </div>
              <input type="text" id="seo_title" name="seo_title" placeholder="Tên sản phẩm - Giá Tốt Quảng Trị | Siêu Thị VLXD Hoàng Yến" />
            </div>

            <div class="form-group">
              <div class="label-flex">
                <label for="seo_description">SEO Meta Description</label>
                <span id="seo-desc-len" class="badge-counter info">0 / 155 kt</span>
              </div>
              <textarea id="seo_description" name="seo_description" rows="2" placeholder="Mô tả chuẩn SEO thu hút khách click..."></textarea>
            </div>

            <!-- SERP Preview -->
            <div class="serp-preview-card">
              <div class="serp-url-row">
                <span class="serp-domain">https://vlxdhoangyen.com</span>
                <span class="serp-path" id="serp-path-preview">/duong-dan-san-pham/</span>
              </div>
              <div class="serp-title" id="serp-title-preview">Tên Sản Phẩm | Siêu Thị VLXD Hoàng Yến</div>
              <div class="serp-desc" id="serp-desc-preview">Mô tả sản phẩm xuất hiện trên công cụ tìm kiếm Google...</div>
            </div>
          </div>
        </div>

        <div class="col-side">
          <div class="side-card">
            <h4>Xuất Bản & Trạng Thái</h4>
            <div class="form-group">
              <label for="status">Trạng thái</label>
              <select id="status" name="status">
                <option value="published">Công khai (Published)</option>
                <option value="draft">Bản nháp (Draft)</option>
              </select>
            </div>
            <div class="checkbox-group">
              <label>
                <input type="checkbox" name="is_in_stock" checked />
                <span>Còn hàng trong kho</span>
              </label>
            </div>
            <div class="checkbox-group">
              <label>
                <input type="checkbox" name="is_featured" />
                <span>Sản phẩm nổi bật trang chủ</span>
              </label>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem; font-weight: 800; padding: 0.75rem;">
              LƯU SẢN PHẨM
            </button>
          </div>

          <div class="side-card">
            <h4>Phân Loại & Huy Hiệu (Badge)</h4>
            
            <div class="form-group">
              <label for="category_id">Danh mục sản phẩm</label>
              <select id="category_id" name="category_id">
                <option value="">-- Chọn danh mục --</option>
                {categories.map(c => (
                  <option value={c.id}>{c.parent_id ? `┗━━ ${c.name} (${c.parent_name})` : c.name}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="brand_id">Thương hiệu / Nhà máy</label>
              <select id="brand_id" name="brand_id">
                <option value="">-- Chọn thương hiệu --</option>
                {brands.map(b => (
                  <option value={b.id}>{b.name}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="custom_badge">Huy hiệu Nổi bật (Badge Tier-1)</label>
              <select id="preset_badge_select" class="form-select" onchange="const input=document.getElementById('custom_badge'); if(this.value){input.value=this.value;}">
                <option value="">-- Mặc định (Theo phân loại) --</option>
                <option value="Chuẩn Nhà Máy">Chuẩn Nhà Máy</option>
                <option value="Sản Phẩm Phân Phối">Sản Phẩm Phân Phối</option>
                <option value="Hàng Công Trình">Hàng Công Trình</option>
                <option value="Bán Chạy">Bán Chạy</option>
                <option value="Mới Về">Mới Về</option>
              </select>
              <input 
                type="text" 
                id="custom_badge" 
                name="custom_badge" 
                placeholder="Tự nhập nội dung huy hiệu tùy chỉnh..." 
                style="margin-top: 6px;" 
              />
            </div>

            <div class="form-group">
              <label for="sku">Mã sản phẩm (SKU)</label>
              <input type="text" id="sku" name="sku" placeholder="BS-PCB40" />
            </div>

            <div class="form-group">
              <label for="price">Giá bán (Nhập 0 nếu Liên hệ)</label>
              <input type="number" id="price" name="price" placeholder="0" />
            </div>

            <div class="form-group">
              <label for="unit">Đơn vị tính</label>
              <input type="text" id="unit" name="unit" placeholder="Bao, Cây, Kg, Mét, Bộ..." defaultValue="Bao" />
            </div>
          </div>

          <MediaManager
            featuredImage=""
            galleryImages={[]}
            featuredInputName="featured_image"
            galleryInputName="gallery"
            allowMultiple={true}
          />
        </div>
      </div>
    </form>

    <!-- AI Assistant Modal for Product -->
    <AIAssistantModal targetType="product" />

  </div>
</AdminLayout>

<style>
