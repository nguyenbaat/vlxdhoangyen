  .error-box {
    background: #fee2e2;
    color: #b91c1c;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .admin-form-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 2rem;
    align-items: start;
  }

  .form-group-wp-title {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
  }
  .form-group-wp-title label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .wp-title-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    font-family: inherit;
    padding: 0;
  }

  .wp-slug-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.45rem 0.75rem;
    font-size: 0.825rem;
  }
  .slug-label { font-weight: 700; color: #475569; }
  .slug-domain { color: #64748b; }
  .slug-input {
    flex: 1;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 0.825rem;
    font-family: monospace;
  }
  .btn-slug-action {
    background: #e2e8f0;
    border: none;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }
  .form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: #334155;
  }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    outline: none;
    font-family: inherit;
    box-sizing: border-box;
  }
