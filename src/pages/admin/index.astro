---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ProductRepo, CategoryRepo, BrandRepo, PostRepo, InquiryRepo } from '../../server/db/repo.js';

const totalProds = (await ProductRepo.getAll({ limit: 1 })).total;
const categories = await CategoryRepo.getMainCategories();
const brands = await BrandRepo.getAll();
const posts = await PostRepo.getAll('published');
const inquiries = await InquiryRepo.getAll();
const newInquiries = inquiries.filter(i => i.status === 'new');
---

<AdminLayout title="Bảng Điều Khiển Tổng Quan" activeNav="dashboard">
  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon-wrap" style="background: #fee2e2; color: #ef4444;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-val">{newInquiries.length}</span>
        <span class="stat-title">Yêu Cầu Báo Giá Mới</span>
      </div>
      <a href="/admin/inquiries" class="stat-link">Xem chi tiết &rarr;</a>
    </div>

    <div class="stat-card">
      <div class="stat-icon-wrap" style="background: #e0f2fe; color: #0284c7;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-val">{totalProds}</span>
        <span class="stat-title">Tổng Số Sản Phẩm</span>
      </div>
      <a href="/admin/products" class="stat-link">Quản lý sản phẩm &rarr;</a>
    </div>

    <div class="stat-card">
      <div class="stat-icon-wrap" style="background: #fef3c7; color: #d97706;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-val">{categories.length}</span>
        <span class="stat-title">Danh Mục Vật Tư</span>
      </div>
      <a href="/admin/categories" class="stat-link">Quản lý danh mục &rarr;</a>
    </div>

    <div class="stat-card">
      <div class="stat-icon-wrap" style="background: #dcfce7; color: #16a34a;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-val">{brands.length}</span>
        <span class="stat-title">Thương Hiệu Đối Tác</span>
      </div>
      <a href="/admin/brands" class="stat-link">Quản lý thương hiệu &rarr;</a>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions-bar">
    <span class="quick-label">Thao tác nhanh:</span>
    <a href="/admin/products/new" class="btn btn-primary btn-sm">+ Thêm Sản Phẩm Mới</a>
    <a href="/admin/categories" class="btn btn-navy btn-sm">+ Thêm Danh Mục</a>
    <a href="/admin/posts" class="btn btn-outline btn-sm">+ Viết Bài Báo Giá</a>
  </div>

  <!-- Recent Inquiries Table -->
  <div class="card-table-wrap">
    <div class="card-header-row">
      <h2>Yêu Cầu Báo Giá Gần Đây ({inquiries.length})</h2>
      <a href="/admin/inquiries" class="btn btn-navy btn-sm">Xem Toàn Bộ</a>
    </div>

    {inquiries.length > 0 ? (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Khách Hàng</th>
              <th>Số Điện Thoại</th>
              <th>Công Trình</th>
              <th>Nội Dung Vật Tư</th>
              <th>Thời Gian</th>
              <th>Trạng Thái</th>
            </tr>
          </thead>
          <tbody>
            {inquiries.slice(0, 10).map(inq => (
              <tr>
                <td>#{inq.id}</td>
                <td><strong>{inq.customer_name}</strong></td>
                <td>
                  <a href={`tel:${inq.customer_phone}`} class="phone-tag">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{inq.customer_phone}
                  </a>
                </td>
                <td>{inq.address || 'Quảng Trị'}</td>
                <td class="notes-cell">{inq.notes || 'Cần báo giá chung'}</td>
                <td>{new Date(inq.created_at).toLocaleString('vi-VN')}</td>
                <td>
                  <span class={`status-pill status-${inq.status}`}>
                    {inq.status === 'new' ? 'Mới' : inq.status === 'contacted' ? 'Đã liên hệ' : 'Hoàn thành'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="empty-inq-box">
        <p>Chưa có yêu cầu báo giá nào mới.</p>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .stat-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }
  .stat-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .stat-val {
    display: block;
    font-size: 1.8rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--color-primary-dark);
  }
  .stat-title {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .stat-link {
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .quick-actions-bar {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .quick-label {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .card-table-wrap {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .card-header-row h2 {
    font-size: 1.25rem;
  }

  .table-responsive {
    overflow-x: auto;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .admin-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    background: #f8fafc;
    border-bottom: 2px solid var(--border-subtle);
    color: var(--text-muted);
    font-weight: 700;
  }
  .admin-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }
  .notes-cell {
    max-width: 250px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .phone-tag {
    color: var(--color-accent);
    font-weight: 700;
  }
  .status-pill {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .status-new {
    background: #fee2e2;
    color: #ef4444;
  }
  .status-contacted {
    background: #fef3c7;
    color: #d97706;
  }
  .status-completed {
    background: #dcfce7;
    color: #16a34a;
  }

  .empty-inq-box {
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .stats-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .stats-grid { grid-template-columns: 1fr; }
  }
</style>
