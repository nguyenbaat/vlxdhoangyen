---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { InquiryRepo } from '../../../server/db/repo.js';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action')?.toString();
  const id = Number(formData.get('id'));

  if (action === 'update_status' && id) {
    const status = formData.get('status')?.toString() || 'new';
    await InquiryRepo.updateStatus(id, status);
  } else if (action === 'delete' && id) {
    await InquiryRepo.delete(id);
  }

  return Astro.redirect('/admin/inquiries');
}

const inquiries = await InquiryRepo.getAll();
---

<AdminLayout title="Quản Lý Yêu Cầu Báo Giá Khách Hàng" activeNav="inquiries">
  <div class="inquiry-mgmt-wrap">
    <div class="header-action-row">
      <p class="subtitle">Tổng cộng <strong>{inquiries.length}</strong> khách hàng đã gửi yêu cầu tư vấn / báo giá</p>
    </div>

    <div class="table-card">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Khách Hàng</th>
              <th>Điện Thoại / Zalo</th>
              <th>Email / Địa Chỉ</th>
              <th>Vật Tư Yêu Cầu</th>
              <th>Ngày Gửi</th>
              <th>Trạng Thái</th>
              <th>Thao Tác</th>
            </tr>
          </thead>
          <tbody>
            {inquiries.map(inq => (
              <tr>
                <td>#{inq.id}</td>
                <td>
                  <strong>{inq.customer_name}</strong>
                  {inq.product_name && <div class="prod-badge">SP: {inq.product_name}</div>}
                </td>
                <td>
                  <a href={`tel:${inq.customer_phone}`} class="phone-link">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{inq.customer_phone}
                  </a>
                </td>
                <td>
                  <div>{inq.address || '—'}</div>
                  {inq.customer_email && <small style="color: var(--text-muted);">{inq.customer_email}</small>}
                </td>
                <td class="notes-col">
                  <p>{inq.notes || 'Cần báo giá chung'}</p>
                </td>
                <td>{new Date(inq.created_at).toLocaleString('vi-VN')}</td>
                <td>
                  <form method="POST" class="inline-status-form">
                    <input type="hidden" name="action" value="update_status" />
                    <input type="hidden" name="id" value={inq.id} />
                    <select name="status" onchange="this.form.submit()" class={`status-select select-${inq.status}`}>
                      <option value="new" selected={inq.status === 'new'}>Mới tiếp nhận</option>
                      <option value="contacted" selected={inq.status === 'contacted'}>Đã liên hệ</option>
                      <option value="completed" selected={inq.status === 'completed'}>Hoàn thành</option>
                    </select>
                  </form>
                </td>
                <td>
                  <form method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa yêu cầu này?');">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={inq.id} />
                    <button type="submit" class="delete-btn" title="Xóa" style="display: inline-flex; align-items: center; justify-content: center;">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .inquiry-mgmt-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .header-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .table-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .table-responsive {
    overflow-x: auto;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .admin-table th {
    text-align: left;
    padding: 0.85rem 1rem;
    background: #f8fafc;
    border-bottom: 2px solid var(--border-subtle);
    color: var(--text-muted);
    font-weight: 700;
  }
  .admin-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }
  .phone-link {
    color: var(--color-accent);
    font-weight: 700;
  }
  .prod-badge {
    font-size: 0.75rem;
    background: #e0f2fe;
    color: #0284c7;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    margin-top: 0.2rem;
  }
  .notes-col {
    max-width: 250px;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .status-select {
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 700;
    border: 1px solid var(--border-medium);
    cursor: pointer;
  }
  .select-new { background: #fee2e2; color: #b91c1c; border-color: #fca5a5; }
  .select-contacted { background: #fef3c7; color: #b45309; border-color: #fde68a; }
  .select-completed { background: #dcfce7; color: #15803d; border-color: #86efac; }

  .delete-btn {
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    background: #fee2e2;
    color: #ef4444;
    transition: background-color 0.2s ease;
  }
  .delete-btn:hover {
    background: #fecaca;
  }
</style>
