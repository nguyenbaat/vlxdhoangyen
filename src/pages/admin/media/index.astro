<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Toast function
    const toast = document.getElementById('media_toast');
    const toastText = document.getElementById('media_toast_text');
    let toastTimer = null;

    function showToast(msg) {
      if (!toast) return;
      if (toastText) toastText.textContent = msg;
      toast.style.display = 'flex';
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.style.display = 'none';
      }, 3000);
    }

    // 2. Copy URL buttons on cards
    document.querySelectorAll('.btn-copy-url').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const url = btn.getAttribute('data-copy');
        if (url) {
          const fullUrl = url.startsWith('http') ? url : window.location.origin + url;
          navigator.clipboard.writeText(fullUrl).then(() => {
            showToast(`Đã sao chép link: ${url}`);
          }).catch(() => {
            prompt('Sao chép đường dẫn ảnh:', fullUrl);
          });
        }
      });
    });

    // 3. Edit Modal Handlers
    const editModal = document.getElementById('edit_media_modal');
    const closeEditModalBtn = document.getElementById('btn_close_edit_modal');
    const cancelEditBtn = document.getElementById('btn_cancel_edit');
    const editIdInput = document.getElementById('edit_media_id');
    const editUrlInput = document.getElementById('edit_url');
    const editFilenameInput = document.getElementById('edit_filename');
    const editAltInput = document.getElementById('edit_alt');
    const editPreviewImg = document.getElementById('edit_preview_img');
    const editInfoSize = document.getElementById('edit_info_size');
    const editInfoSource = document.getElementById('edit_info_source');
    const editBtnOpenTab = document.getElementById('edit_btn_open_tab');
    const boxReplaceFile = document.getElementById('box_replace_file');
    const btnModalDelete = document.getElementById('btn_modal_delete');
    const copyModalUrlBtn = document.getElementById('btn_copy_modal_url');

    function openEditModal(card) {
      const id = card.getAttribute('data-id');
      const url = card.getAttribute('data-url');
      const name = card.getAttribute('data-name');
      const alt = card.getAttribute('data-alt');
      const size = card.getAttribute('data-size');
      const isStatic = card.getAttribute('data-static') === 'true';

      if (editIdInput) editIdInput.value = id;
      if (editUrlInput) editUrlInput.value = url;
      if (editFilenameInput) {
        editFilenameInput.value = name;
        editFilenameInput.readOnly = isStatic;
      }
      if (editAltInput) {
        editAltInput.value = alt;
        editAltInput.readOnly = isStatic;
      }
      if (editPreviewImg) editPreviewImg.src = url;
      if (editInfoSize) editInfoSize.textContent = size;
      if (editInfoSource) editInfoSource.textContent = isStatic ? 'Thư mục tĩnh (Static)' : 'Kho lưu trữ MySQL';
      if (editBtnOpenTab) editBtnOpenTab.href = url;

      if (boxReplaceFile) boxReplaceFile.style.display = isStatic ? 'none' : 'block';
      if (btnModalDelete) {
        btnModalDelete.style.display = isStatic ? 'none' : 'inline-flex';
        btnModalDelete.setAttribute('data-target-id', id);
        btnModalDelete.setAttribute('data-target-name', name);
      }

      if (editModal) editModal.style.display = 'flex';
    }

    document.querySelectorAll('.media-item-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.btn-copy-url') || e.target.closest('.btn-delete-media')) return;
        openEditModal(card);
      });
    });

    closeEditModalBtn?.addEventListener('click', () => { editModal.style.display = 'none'; });
    cancelEditBtn?.addEventListener('click', () => { editModal.style.display = 'none'; });
    if (editModal) {
      editModal.addEventListener('click', (e) => {
        if (e.target === editModal) editModal.style.display = 'none';
      });
    }

    copyModalUrlBtn?.addEventListener('click', () => {
      if (editUrlInput?.value) {
        const fullUrl = editUrlInput.value.startsWith('http') ? editUrlInput.value : window.location.origin + editUrlInput.value;
        navigator.clipboard.writeText(fullUrl).then(() => {
          showToast(`Đã sao chép link: ${editUrlInput.value}`);
        });
      }
    });

    // 4. Delete handler
    const deleteForm = document.getElementById('form_delete_media');
    const deleteTargetId = document.getElementById('delete_target_id');

    function confirmDelete(id, name) {
      if (confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn hình ảnh "${name}" (ID #${id}) khỏi kho MySQL?`)) {
        if (deleteTargetId && deleteForm) {
          deleteTargetId.value = id;
          deleteForm.submit();
        }
      }
    }

    document.querySelectorAll('.btn-delete-media').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-del-id');
        const name = btn.getAttribute('data-del-name');
        confirmDelete(id, name);
      });
    });

    btnModalDelete?.addEventListener('click', () => {
      const id = btnModalDelete.getAttribute('data-target-id');
      const name = btnModalDelete.getAttribute('data-target-name');
      confirmDelete(id, name);
    });

    // Watermark Generator Function (HTML5 Canvas)
    async function applyWatermark(file, options = {}) {
      if (!file || !file.type.startsWith('image/') || file.type === 'image/svg+xml') {
        return file;
      }

      const {
        type = 'text',
        text = 'vlxdhoangyen.com',
        logoUrl = '/favicon.png',
        position = 'bottom-right'
      } = options;

      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = () => {
          const img = new Image();
          img.onload = async () => {
            try {
              const canvas = document.createElement('canvas');
              canvas.width = img.naturalWidth;
              canvas.height = img.naturalHeight;
              const ctx = canvas.getContext('2d');
              if (!ctx) {
                resolve(file);
                return;
              }

              // 1. Draw original base image
              ctx.drawImage(img, 0, 0);

              const w = canvas.width;
              const h = canvas.height;
              const minDim = Math.min(w, h);

              // Relative responsive font and logo sizing
              const baseFontSize = Math.max(16, Math.round(minDim * 0.038));
              const logoSize = Math.max(26, Math.round(minDim * 0.075));
              const padding = Math.max(16, Math.round(minDim * 0.03));

              // Load logo if needed
              let logoImg = null;
              if (type === 'logo' || type === 'both') {
                try {
                  logoImg = await new Promise((res) => {
                    const lImg = new Image();
                    lImg.crossOrigin = 'anonymous';
                    lImg.onload = () => res(lImg);
                    lImg.onerror = () => res(null);
                    lImg.src = logoUrl;
                  });
                } catch (e) {
                  logoImg = null;
                }
              }

              ctx.save();

              if (position === 'diagonal') {
                // Diagonal Center Stamp
                ctx.translate(w / 2, h / 2);
                ctx.rotate(-Math.PI / 6); // -30 deg

                const diagFontSize = Math.max(22, Math.round(minDim * 0.055));
                ctx.font = `900 ${diagFontSize}px 'Inter', 'Segoe UI', Arial, sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';

                // Embossed shadow + outline + fill
                ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
                ctx.fillText(text, 2, 2);

                ctx.strokeStyle = 'rgba(0, 0, 0, 0.6)';
                ctx.lineWidth = Math.max(2, diagFontSize * 0.06);
                ctx.strokeText(text, 0, 0);

                ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
                ctx.fillText(text, 0, 0);

                if (logoImg && (type === 'logo' || type === 'both')) {
                  const dLogoSize = logoSize * 1.4;
                  ctx.drawImage(logoImg, -text.length * diagFontSize * 0.28 - dLogoSize - 12, -dLogoSize / 2, dLogoSize, dLogoSize);
                }
              } else {
                // Embossed Badge / Pill Watermark
                const font = `bold ${baseFontSize}px 'Inter', 'Segoe UI', Arial, sans-serif`;
                ctx.font = font;
                let textWidth = (type === 'text' || type === 'both') ? ctx.measureText(text).width : 0;

                let badgeW = 0;
                let badgeH = 0;
                const itemGap = 8;
                const padX = 14;
                const padY = 8;

                if (type === 'both' && logoImg) {
                  badgeW = logoSize + itemGap + textWidth + padX * 2;
                  badgeH = Math.max(logoSize, baseFontSize) + padY * 2;
                } else if (type === 'logo' && logoImg) {
                  badgeW = logoSize + padX * 1.5;
                  badgeH = logoSize + padY * 1.5;
                } else {
                  badgeW = textWidth + padX * 2;
                  badgeH = baseFontSize * 1.4 + padY * 2;
                }

                let posX = w - badgeW - padding;
                let posY = h - badgeH - padding;

                if (position === 'bottom-left') {
                  posX = padding;
                  posY = h - badgeH - padding;
                } else if (position === 'top-right') {
                  posX = w - badgeW - padding;
                  posY = padding;
                } else if (position === 'top-left') {
                  posX = padding;
                  posY = padding;
                } else if (position === 'center') {
                  posX = (w - badgeW) / 2;
                  posY = (h - badgeH) / 2;
                }

                // Draw translucent embossed backdrop pill
                const radius = Math.min(8, badgeH / 2);
                ctx.save();
                ctx.beginPath();
                if (ctx.roundRect) {
                  ctx.roundRect(posX, posY, badgeW, badgeH, radius);
                } else {
                  ctx.rect(posX, posY, badgeW, badgeH);
                }
                ctx.fillStyle = 'rgba(15, 23, 42, 0.55)';
                ctx.fill();
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
                ctx.lineWidth = 1;
                ctx.stroke();
                ctx.restore();

                let curX = posX + padX;
                const midY = posY + badgeH / 2;

                // Draw Logo
                if (logoImg && (type === 'logo' || type === 'both')) {
                  const lY = midY - logoSize / 2;
                  ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
                  ctx.shadowBlur = 4;
                  ctx.drawImage(logoImg, curX, lY, logoSize, logoSize);
                  ctx.shadowBlur = 0;
                  curX += logoSize + itemGap;
                }

                // Draw Embossed Text
                if (type === 'text' || type === 'both') {
                  ctx.font = font;
                  ctx.textBaseline = 'middle';
                  ctx.textAlign = 'left';

                  // 3D Embossed shadow
                  ctx.shadowColor = 'rgba(0, 0, 0, 0.9)';
                  ctx.shadowBlur = 3;
                  ctx.shadowOffsetX = 1;
                  ctx.shadowOffsetY = 1;

                  // Dark border stroke
                  ctx.strokeStyle = 'rgba(0, 0, 0, 0.7)';
                  ctx.lineWidth = Math.max(1.5, baseFontSize * 0.06);
                  ctx.strokeText(text, curX, midY);

                  // Crisp white text fill
                  ctx.fillStyle = '#ffffff';
                  ctx.fillText(text, curX, midY);
                }
              }

              ctx.restore();

              // Output converted blob to File object
              const mime = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
              canvas.toBlob((blob) => {
                if (!blob) {
                  resolve(file);
                  return;
                }
                const newFile = new File([blob], file.name, {
                  type: mime,
                  lastModified: Date.now()
                });
                resolve(newFile);
              }, mime, 0.92);

            } catch (err) {
              console.error('[Watermark] Processing error:', err);
              resolve(file);
            }
          };
          img.onerror = () => resolve(file);
          img.src = reader.result;
        };
        reader.onerror = () => resolve(file);
        reader.readAsDataURL(file);
      });
    }

    // 5. Upload Modal Handlers
    const uploadModal = document.getElementById('upload_media_modal');
    const openUploadModalBtn = document.getElementById('btn_open_upload_modal');
    const closeUploadModalBtn = document.getElementById('btn_close_upload_modal');
    const cancelUploadBtn = document.getElementById('btn_cancel_upload');
    const modalDropzone = document.getElementById('modal_upload_dropzone');
    const modalFileInput = document.getElementById('modal_file_input');
    const btnBrowseFiles = document.getElementById('btn_browse_files');
    const selectedFilesPreview = document.getElementById('upload_selected_files_list');
    const formUploadMedia = document.getElementById('form_upload_media');
    const btnSubmitUpload = document.getElementById('btn_submit_upload');
    const btnUploadText = document.getElementById('btn_upload_text');
    const modalWmEnable = document.getElementById('modal_wm_enable');
    const modalWmOptionsBody = document.getElementById('modal_wm_options_body');

    if (modalWmEnable && modalWmOptionsBody) {
      modalWmEnable.addEventListener('change', () => {
        modalWmOptionsBody.style.opacity = modalWmEnable.checked ? '1' : '0.45';
        modalWmOptionsBody.style.pointerEvents = modalWmEnable.checked ? 'auto' : 'none';
      });
    }

    openUploadModalBtn?.addEventListener('click', () => {
      if (uploadModal) uploadModal.style.display = 'flex';
    });
    closeUploadModalBtn?.addEventListener('click', () => { uploadModal.style.display = 'none'; });
    cancelUploadBtn?.addEventListener('click', () => { uploadModal.style.display = 'none'; });
    if (uploadModal) {
      uploadModal.addEventListener('click', (e) => {
        if (e.target === uploadModal) uploadModal.style.display = 'none';
      });
    }

    btnBrowseFiles?.addEventListener('click', (e) => {
      e.stopPropagation();
      modalFileInput?.click();
    });
    modalDropzone?.addEventListener('click', () => {
      modalFileInput?.click();
    });

    modalFileInput?.addEventListener('change', () => {
      if (modalFileInput.files && modalFileInput.files.length > 0) {
        const count = modalFileInput.files.length;
        if (selectedFilesPreview) {
          selectedFilesPreview.textContent = `Đã chọn ${count} tệp: ${Array.from(modalFileInput.files).map(f => f.name).slice(0, 3).join(', ')}${count > 3 ? '...' : ''}`;
        }
      }
    });

    if (modalDropzone) {
      ['dragenter', 'dragover'].forEach(name => {
        modalDropzone.addEventListener(name, (e) => {
          e.preventDefault();
          modalDropzone.classList.add('drag-over');
        });
      });
      ['dragleave', 'drop'].forEach(name => {
        modalDropzone.addEventListener(name, (e) => {
          e.preventDefault();
          modalDropzone.classList.remove('drag-over');
        });
      });
      modalDropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0 && modalFileInput) {
          modalFileInput.files = dt.files;
          modalFileInput.dispatchEvent(new Event('change'));
        }
      });
    }

    let isUploading = false;
    if (formUploadMedia) {
      formUploadMedia.addEventListener('submit', async (e) => {
        if (isUploading) return;
        const isWatermarkEnabled = modalWmEnable?.checked;

        if (isWatermarkEnabled && modalFileInput && modalFileInput.files && modalFileInput.files.length > 0) {
          e.preventDefault();
          isUploading = true;

          const wmTypeEl = document.querySelector('input[name="modal_wm_type"]:checked');
          const wmType = wmTypeEl ? wmTypeEl.value : 'text';
          const wmPositionEl = document.getElementById('modal_wm_position');
          const wmPosition = wmPositionEl ? wmPositionEl.value : 'bottom-right';

          if (btnSubmitUpload) btnSubmitUpload.disabled = true;
          if (btnUploadText) btnUploadText.textContent = 'ĐANG ĐÓNG DẤU & XỬ LÝ ẢNH...';

          try {
            const dt = new DataTransfer();
            for (let i = 0; i < modalFileInput.files.length; i++) {
              const processedFile = await applyWatermark(modalFileInput.files[i], {
                type: wmType,
                text: 'vlxdhoangyen.com',
                logoUrl: '/favicon.png',
                position: wmPosition
              });
              dt.items.add(processedFile);
            }
            modalFileInput.files = dt.files;
            formUploadMedia.submit();
          } catch (err) {
            console.error('[Upload Modal] Error applying watermark:', err);
            formUploadMedia.submit();
          }
        }
      });
    }
  });
</script>
