---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { listMediaFull, deleteMedia, updateMedia, saveMedia } from '../../../server/db/media.js';

let errorMsg = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();
    const id = Number(formData.get('id'));

    if (action === 'delete' && id) {
      await deleteMedia(id);
      successMsg = `Đã xóa hình ảnh #${id} thành công!`;
    } else if (action === 'update' && id) {
      const filename = formData.get('filename')?.toString().trim();
      const alt_text = formData.get('alt_text')?.toString().trim();
      const replaceFile = formData.get('replace_file');

      const updates: any = {};
      if (filename) updates.filename = filename;
      if (alt_text !== undefined) updates.alt_text = alt_text;

      if (replaceFile instanceof File && replaceFile.size > 0) {
        updates.data = Buffer.from(await replaceFile.arrayBuffer());
        updates.mime_type = replaceFile.type;
        updates.file_size = replaceFile.size;
      }

      await updateMedia(id, updates);
      successMsg = `Đã cập nhật thông tin hình ảnh #${id} thành công!`;
    } else if (action === 'upload') {
      const files = formData.getAll('upload_files').filter((item): item is File => item instanceof File && item.size > 0);
      const alt_text = formData.get('upload_alt')?.toString().trim() || '';

      if (!files.length) {
        throw new Error('Vui lòng chọn ít nhất một file ảnh để tải lên.');
      }

      for (const file of files) {
        const data = Buffer.from(await file.arrayBuffer());
        await saveMedia(file.name.slice(0, 255), file.type, data, alt_text);
      }
      successMsg = `Đã tải lên ${files.length} hình ảnh mới vào kho MySQL thành công!`;
    }
  } catch (err: any) {
    errorMsg = err.message || 'Đã có lỗi xảy ra';
  }
}

// 1. Fetch DB Media
const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const sourceFilter = url.searchParams.get('source') || 'all';

const dbData = await listMediaFull({ search, limit: 1000 });
const dbItems = dbData.items;

// 2. Scan Static Public Images
const staticItems: Array<{
  id: string;
  filename: string;
  mime_type: string;
  file_size: number;
  alt_text: string;
  created_at: string;
  url: string;
  is_static: boolean;
}> = [];

const publicRoot = path.join(process.cwd(), 'public');
const dirsToScan = [
  path.join(process.cwd(), 'uploads'),
  path.join(publicRoot, 'images', 'uploads'),
  path.join(publicRoot, 'images', 'danh-muc'),
  path.join(publicRoot, 'images'),
  publicRoot
];

for (const dir of dirsToScan) {
  if (!fs.existsSync(dir)) continue;
  try {
    const entries = fs.readdirSync(dir, { withFileTypes: true });
    for (const ent of entries) {
      if (ent.isDirectory()) continue;
      const ext = path.extname(ent.name).toLowerCase();
      if (!['.jpg', '.jpeg', '.png', '.webp', '.gif', '.svg'].includes(ext)) continue;

      const fullPath = path.join(dir, ent.name);
      const stats = fs.statSync(fullPath);
      const webUrl = dir === dirsToScan[0]
        ? `/images/uploads/${ent.name}`
        : fullPath.replace(publicRoot, '').replace(/\\/g, '/');

      if (!staticItems.some(i => i.url === webUrl)) {
        staticItems.push({
          id: `static_${ent.name}`,
          filename: ent.name,
          mime_type: ext === '.png' ? 'image/png' : (ext === '.webp' ? 'image/webp' : 'image/jpeg'),
          file_size: stats.size,
          alt_text: ent.name.replace(ext, '').replace(/[-_]/g, ' '),
          created_at: stats.mtime.toISOString(),
          url: webUrl.startsWith('/') ? webUrl : `/${webUrl}`,
          is_static: true
        });
      }
    }
  } catch (e) {}
}

let allMediaItems = [...dbItems, ...staticItems];

if (sourceFilter === 'mysql') {
  allMediaItems = dbItems;
} else if (sourceFilter === 'static') {
  allMediaItems = staticItems as any;
}

if (search) {
  const q = search.toLowerCase().trim();
  allMediaItems = allMediaItems.filter(i => 
    i.filename.toLowerCase().includes(q) || 
    (i.alt_text && i.alt_text.toLowerCase().includes(q)) ||
    i.url.toLowerCase().includes(q)
  );
}

function formatBytes(bytes: number) {
  if (bytes === 0) return '0 Bytes';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

const totalStorageBytes = dbData.totalSize + staticItems.reduce((acc, i) => acc + i.file_size, 0);
---

<AdminLayout title="Quản Lý Media & Thư Viện Ảnh" activeNav="media">
  <div class="tail-mgmt-wrap">
    
    <!-- Top Alert Messages -->
    {successMsg && (
      <div class="tail-alert tail-alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>{successMsg}</span>
      </div>
    )}
    {errorMsg && (
      <div class="tail-alert tail-alert-error">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span>{errorMsg}</span>
      </div>
    )}

    <!-- Stats Row Cards -->
    <div class="media-stats-grid">
      <div class="media-stat-card">
        <div class="stat-icon-box bg-blue">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Tổng số hình ảnh</span>
          <strong class="stat-value">{allMediaItems.length} <small>tệp</small></strong>
        </div>
      </div>

      <div class="media-stat-card">
        <div class="stat-icon-box bg-emerald">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Kho lưu trữ MySQL</span>
          <strong class="stat-value">{dbData.total} <small>ảnh tải lên</small></strong>
        </div>
      </div>

      <div class="media-stat-card">
        <div class="stat-icon-box bg-amber">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Ảnh tĩnh thư mục</span>
          <strong class="stat-value">{staticItems.length} <small>tệp</small></strong>
        </div>
      </div>

      <div class="media-stat-card">
        <div class="stat-icon-box bg-purple">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Dung lượng ước tính</span>
          <strong class="stat-value">{formatBytes(totalStorageBytes)}</strong>
        </div>
      </div>
    </div>

    <!-- TailAdmin Controls Bar -->
    <div class="tail-controls-bar" style="margin-top: 1.25rem;">
      <div class="tail-controls-left">
        <!-- Search form -->
        <form method="GET" class="tail-search-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" name="q" value={search} placeholder="Tìm theo tên file, thẻ ALT, đường dẫn..." class="tail-search-input" />
          {sourceFilter !== 'all' && <input type="hidden" name="source" value={sourceFilter} />}
        </form>

        <!-- Source Filter -->
        <div class="tail-filter-group">
          <a href={`/admin/media?source=all${search ? `&q=${encodeURIComponent(search)}` : ''}`} class={`tail-filter-btn ${sourceFilter === 'all' ? 'active' : ''}`}>Tất cả</a>
          <a href={`/admin/media?source=mysql${search ? `&q=${encodeURIComponent(search)}` : ''}`} class={`tail-filter-btn ${sourceFilter === 'mysql' ? 'active' : ''}`}>Kho MySQL ({dbData.total})</a>
          <a href={`/admin/media?source=static${search ? `&q=${encodeURIComponent(search)}` : ''}`} class={`tail-filter-btn ${sourceFilter === 'static' ? 'active' : ''}`}>Ảnh tĩnh ({staticItems.length})</a>
        </div>
      </div>

      <div class="tail-controls-right">
        <!-- Upload Trigger Button -->
        <button type="button" class="btn btn-primary btn-upload-trigger" id="btn_open_upload_modal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>TẢI ẢNH MỚI LÊN</span>
        </button>
      </div>
    </div>

    <!-- Media Assets Grid Container -->
    <div class="media-library-panel">
      {allMediaItems.length === 0 ? (
        <div class="media-empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <h3>Không tìm thấy hình ảnh nào</h3>
          <p>Thử tìm kiếm với từ khóa khác hoặc bấm nút "Tải Ảnh Mới Lên" phía trên.</p>
        </div>
      ) : (
        <div class="media-cards-grid">
          {allMediaItems.map((item) => (
            <div class="media-item-card" data-id={item.id} data-url={item.url} data-name={item.filename} data-alt={item.alt_text || ''} data-size={formatBytes(item.file_size)} data-static={item.is_static ? "true" : "false"}>
              <div class="media-item-thumb-wrapper">
                <img src={item.url} alt={item.alt_text || item.filename} loading="lazy" class="media-item-img" />
                <span class="media-source-pill">{item.is_static ? 'Tĩnh' : 'MySQL'}</span>
              </div>
              
              <div class="media-item-meta">
                <div class="media-item-name" title={item.filename}>{item.filename}</div>
                
                <div class="media-item-alt" title={item.alt_text || 'Chưa có thẻ ALT'}>
                  {item.alt_text ? (
                    <span class="alt-badge good">🏷️ {item.alt_text}</span>
                  ) : (
                    <span class="alt-badge empty">⚠️ Chưa đặt ALT</span>
                  )}
                </div>

                <div class="media-item-subline">
                  <span class="media-size-text">{formatBytes(item.file_size)}</span>
                  <span class="media-ext-tag">{item.filename.split('.').pop()?.toUpperCase()}</span>
                </div>
              </div>

              <div class="media-item-actions">
                <button type="button" class="media-act-btn btn-edit-media" title="Chỉnh sửa link, ALT, tên ảnh, thay file">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                  <span>Sửa</span>
                </button>

                <button type="button" class="media-act-btn btn-copy-url" data-copy={item.url} title="Sao chép đường dẫn URL">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  <span>Link</span>
                </button>

                {!item.is_static && (
                  <button type="button" class="media-act-btn btn-delete-media" data-del-id={item.id} data-del-name={item.filename} title="Xóa hình ảnh">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- =========================================================================
         1. MODAL CHỈNH SỬA MEDIA (LINK / ALT / TÊN / FILE THAY THẾ)
         ========================================================================= -->
    <div class="media-modal-overlay" id="edit_media_modal" style="display: none;">
      <div class="media-modal-dialog edit-dialog">
        <div class="media-modal-header">
          <div class="header-title-flex">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            <h3>Chỉnh Sửa Chi Tiết Hình Ảnh & Thẻ ALT</h3>
          </div>
          <button type="button" class="media-modal-close" id="btn_close_edit_modal">&times;</button>
        </div>

        <form method="POST" enctype="multipart/form-data" class="edit-media-form" id="form_edit_media">
          <input type="hidden" name="action" value="update" />
          <input type="hidden" name="id" id="edit_media_id" />

          <div class="edit-modal-grid">
            <!-- Left Preview Side -->
            <div class="edit-modal-preview">
              <div class="preview-img-container">
                <img id="edit_preview_img" src="" alt="" />
              </div>
              <div class="preview-info-box">
                <div class="info-row">
                  <span>Dung lượng:</span>
                  <strong id="edit_info_size">-</strong>
                </div>
                <div class="info-row">
                  <span>Nguồn lưu trữ:</span>
                  <strong id="edit_info_source">-</strong>
                </div>
              </div>
              <a href="#" target="_blank" id="edit_btn_open_tab" class="btn-open-newtab">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                <span>Mở ảnh kích thước gốc ↗</span>
              </a>
            </div>

            <!-- Right Edit Fields -->
            <div class="edit-modal-fields">
              <!-- Field 1: Đường dẫn link ảnh -->
              <div class="form-group-tail">
                <label for="edit_url">Đường Dẫn URL Hình Ảnh</label>
                <div class="input-with-action">
                  <input type="text" id="edit_url" readonly class="tail-input readonly-input" />
                  <button type="button" class="btn btn-secondary" id="btn_copy_modal_url" title="Sao chép đường dẫn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    <span>Copy URL</span>
                  </button>
                </div>
                <span class="field-hint">Dùng đường dẫn này để chèn vào sản phẩm, bài viết hoặc banner.</span>
              </div>

              <!-- Field 2: Tên file ảnh -->
              <div class="form-group-tail">
                <label for="edit_filename">Tên File Hình Ảnh (Filename)</label>
                <input type="text" id="edit_filename" name="filename" class="tail-input" required />
                <span class="field-hint">Tên file nên viết không dấu, gạch ngang nối liền (Ví dụ: <code>thep-d16-hoa-phat.webp</code>).</span>
              </div>

              <!-- Field 3: Thẻ ALT text SEO -->
              <div class="form-group-tail">
                <label for="edit_alt">Thẻ ALT Text (Tối ưu hóa SEO)</label>
                <input type="text" id="edit_alt" name="alt_text" class="tail-input" placeholder="Nhập mô tả hình ảnh cho Googlebot & AI..." />
                <span class="field-hint">Mô tả rõ nội dung vật liệu, quy cách và thương hiệu (Ví dụ: <em>Thép cây D16 Hòa Phát tại kho VLXD Hoàng Yến Quảng Trị</em>).</span>
              </div>

              <!-- Field 4: Thay thế file ảnh mới -->
              <div class="form-group-tail replace-file-box" id="box_replace_file">
                <label for="edit_replace_file">Thay Thế File Ảnh Mới (Giữ nguyên ID & URL)</label>
                <input type="file" id="edit_replace_file" name="replace_file" accept="image/*" class="tail-file-input" />
                <span class="field-hint">Chọn ảnh mới nếu muốn thay đổi hình ảnh mà không làm gãy liên kết cũ.</span>
              </div>
            </div>
          </div>

          <div class="media-modal-footer">
            <div class="footer-left">
              <button type="button" class="btn btn-danger-outline" id="btn_modal_delete" style="display: none;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Xóa Ảnh</span>
              </button>
            </div>
            <div class="footer-right">
              <button type="button" class="btn btn-secondary" id="btn_cancel_edit">Hủy Bỏ</button>
              <button type="submit" class="btn btn-primary" id="btn_save_edit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                <span>LƯU THAY ĐỔI</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- =========================================================================
         2. MODAL TẢI ẢNH MỚI LÊN (UPLOAD MODAL)
         ========================================================================= -->
    <div class="media-modal-overlay" id="upload_media_modal" style="display: none;">
      <div class="media-modal-dialog upload-dialog">
        <div class="media-modal-header">
          <div class="header-title-flex">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            <h3>Tải Ảnh Mới Lên Hệ Thống</h3>
          </div>
          <button type="button" class="media-modal-close" id="btn_close_upload_modal">&times;</button>
        </div>

        <form method="POST" enctype="multipart/form-data" class="upload-media-form" id="form_upload_media">
          <input type="hidden" name="action" value="upload" />

          <div class="upload-dropzone-large" id="modal_upload_dropzone">
            <input type="file" id="modal_file_input" name="upload_files" accept="image/*" multiple required style="display: none;" />
            <div class="dropzone-large-inner">
              <div class="dropzone-circle-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
              <strong class="dropzone-title">Kéo & thả file ảnh vào đây hoặc bấm để duyệt file</strong>
              <span class="dropzone-sub">Hỗ trợ JPG, PNG, WebP, GIF, SVG (Chọn nhiều ảnh cùng lúc, tối đa 10MB/ảnh)</span>
              <button type="button" class="btn btn-primary" id="btn_browse_files">Chọn file từ máy tính</button>
              <div id="upload_selected_files_list" class="selected-files-preview"></div>
            </div>
          </div>

          <!-- Watermark Options Panel in Upload Modal -->
          <div class="modal-watermark-panel" id="modal_watermark_panel">
            <div class="mwm-header">
              <label class="mwm-toggle-label">
                <input type="checkbox" id="modal_wm_enable" checked class="mwm-checkbox" />
                <span class="mwm-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  <strong>Đóng dấu Watermark bản quyền khi tải ảnh</strong>
                </span>
              </label>
              <span class="mwm-hint">Chống sao chép hình ảnh VLXD Hoàng Yến</span>
            </div>

            <div class="mwm-options-row" id="modal_wm_options_body">
              <div class="mwm-field">
                <span class="mwm-sublabel">Kiểu đóng dấu:</span>
                <div class="mwm-radios">
                  <label class="mwm-radio-item">
                    <input type="radio" name="modal_wm_type" value="text" checked />
