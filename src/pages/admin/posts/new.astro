---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BlockEditor from '../../../components/admin/BlockEditor.astro';
import MediaManager from '../../../components/admin/MediaManager.astro';
import AIAssistantModal from '../../../components/admin/AIAssistantModal.astro';
import { PostRepo } from '../../../server/db/repo.js';

let errorMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const title = formData.get('title')?.toString().trim() || '';
    let slug = formData.get('slug')?.toString().trim() || '';
    const summary = formData.get('summary')?.toString().trim() || '';
    const content = formData.get('content')?.toString() || '';
    const featured_image = formData.get('featured_image')?.toString().trim() || '';
    const seo_title = formData.get('seo_title')?.toString().trim() || title;
    const seo_description = formData.get('seo_description')?.toString().trim() || summary;
    const status = formData.get('status')?.toString() || 'published';

    if (!title) throw new Error('Vui lòng nhập tiêu đề bài viết.');
    if (!slug) {
      slug = title
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    const newId = await PostRepo.create({
      title,
      slug,
      summary,
      content,
      featured_image,
      seo_title,
      seo_description,
      status
    });

    return Astro.redirect('/admin/posts');
  } catch (err: any) {
    errorMsg = err.message;
  }
}
---

<AdminLayout title="Thêm Bài Viết Mới (WordPress Style)" activeNav="posts">
  <div class="wp-editor-page">
    
    <!-- Top Bar -->
    <div class="wp-topbar">
      <div class="topbar-left">
        <a href="/admin/posts" class="btn-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>Danh Sách Bài Viết</span>
        </a>
        <span class="topbar-divider">|</span>
        <h1 class="wp-page-title">Thêm Bài Viết Mới</h1>
      </div>

      <div class="topbar-right">
        <!-- AI Writer Trigger Button -->
        <button type="button" id="btn-open-ai-assistant" class="btn-ai-sparkle">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span>✨ AI Viết Bài Tự Động</span>
        </button>
      </div>
    </div>

    {errorMsg && <div class="alert alert-error">{errorMsg}</div>}

    <!-- WordPress 2-Column Form Layout -->
    <form method="POST" id="post-wp-form" class="wp-editor-layout">
      
      <!-- MAIN COLUMN (Left: Title, Slug, Content, SEO) -->
      <div class="wp-main-col">
        
        <!-- Title Input (Large WordPress Gutenberg Style) -->
        <div class="wp-title-box">
          <input 
            type="text" 
            id="post_title" 
            name="title" 
            required 
            placeholder="Thêm tiêu đề bài viết..." 
            class="wp-title-input" 
          />
        </div>

        <!-- Permalink / Slug Bar -->
        <div class="wp-slug-bar">
          <span class="slug-label">Liên kết tĩnh:</span>
          <span class="slug-domain">https://vlxdhoangyen.com/tin-tuc/</span>
          <input type="text" id="post_slug" name="slug" placeholder="duong-dan-bai-viet" class="slug-input" />
          <button type="button" id="btn-sync-slug" class="btn-slug-action" title="Tạo lại slug từ tiêu đề">🔄 Đồng bộ</button>
        </div>

        <!-- Excerpt / Summary -->
        <div class="wp-meta-box">
          <div class="meta-box-header">
            <h4>Đoạn Tóm Tắt Mở Đầu (Excerpt)</h4>
          </div>
          <div class="meta-box-body">
            <textarea 
              id="post_summary" 
              name="summary" 
              rows="3" 
              placeholder="Đoạn giới thiệu ngắn thu hút người đọc (120 - 160 ký tự)..."
              class="wp-textarea"
            ></textarea>
          </div>
        </div>

        <!-- Gutenberg Block Editor -->
        <div class="wp-content-box">
          <BlockEditor 
            id="post_content" 
            name="content" 
            label="Nội Dung Bài Viết Chi Tiết (Gutenberg Block Editor)" 
          />
        </div>

        <!-- Yoast/RankMath SEO Box -->
        <div class="wp-meta-box seo-meta-box">
          <div class="meta-box-header">
            <div class="seo-header-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <h4>Tối Ưu Hóa Tìm Kiếm (Yoast / RankMath SEO)</h4>
            </div>
          </div>
          <div class="meta-box-body">
            
            <div class="form-group-wp">
              <div class="label-flex">
                <label for="post_seo_title">Tiêu Đề SEO (SEO Title Tag)</label>
                <span id="seo-title-len" class="badge-counter info">0 / 60 kt</span>
              </div>
              <input type="text" id="post_seo_title" name="seo_title" placeholder="Tiêu đề hiển thị trên Google..." class="wp-input" />
            </div>

            <div class="form-group-wp">
              <div class="label-flex">
                <label for="post_seo_desc">Thẻ Mô Tả (Meta Description)</label>
                <span id="seo-desc-len" class="badge-counter info">0 / 155 kt</span>
              </div>
              <textarea id="post_seo_desc" name="seo_description" rows="3" placeholder="Đoạn trích mô tả xuất hiện trên Google..." class="wp-textarea"></textarea>
            </div>

            <!-- Live Google SERP Snippet Preview -->
            <div class="google-preview-container">
              <div class="preview-label">Xem Trước Kết Quả Tìm Kiếm Google</div>
              <div class="serp-preview-card">
                <div class="serp-url-row">
                  <span class="serp-domain">https://vlxdhoangyen.com</span>
                  <span class="serp-path" id="serp-path-preview">/tin-tuc/duong-dan-bai-viet/</span>
                </div>
                <div class="serp-title" id="serp-title-preview">Tiêu Đề Bài Viết | Siêu Thị VLXD Hoàng Yến</div>
                <div class="serp-desc" id="serp-desc-preview">Đoạn tóm tắt bài viết xuất hiện trên công cụ tìm kiếm Google...</div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- SIDEBAR COLUMN (Right: Publish Box, Image, Category, Status) -->
      <div class="wp-sidebar-col">
        
        <!-- 1. Publish Box -->
        <div class="wp-sidebar-box publish-box">
          <div class="sidebar-box-header">
            <h4>Đăng Bài</h4>
          </div>
          <div class="sidebar-box-body">
            <div class="publish-option">
              <label for="post_status">Trạng thái:</label>
              <select id="post_status" name="status" class="wp-select">
                <option value="published" selected>Xuất bản ngay (Public)</option>
                <option value="draft">Bản nháp (Draft)</option>
                <option value="pending">Chờ xét duyệt</option>
              </select>
            </div>

            <div class="publish-info-row">
              <span>Khả năng hiển thị:</span>
              <strong>Công khai toàn mạng</strong>
            </div>

            <div class="publish-actions-footer">
              <button type="submit" class="btn btn-primary btn-publish">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                <span>ĐĂNG BÀI VIẾT</span>
              </button>
            </div>
          </div>
        </div>

        <!-- 2. Featured Image Box (Media Manager / MySQL) -->
        <div class="wp-sidebar-box image-box">
          <div class="sidebar-box-header">
            <h4>Ảnh Đại Diện Bài Viết</h4>
          </div>
          <div class="sidebar-box-body">
            <div class="image-preview-wrapper" id="featured-img-preview-box">
              <img id="featured-img-preview" src="https://vlxdhoangyen.com/wp-content/uploads/2025/07/VAT-LIEU-XAY-DUNG-1920-x-731-px-4.png" alt="Ảnh đại diện" class="featured-img-tag" />
            </div>

            <div class="form-group-wp" style="margin-top: 10px;">
              <input type="text" id="featured_image" name="featured_image" placeholder="URL hình ảnh..." class="wp-input" />
            </div>

            <div style="margin-top: 8px;">
              <MediaManager targetInputId="featured_image" buttonText="Chọn từ Thư Viện MySQL" />
            </div>
          </div>
        </div>

        <!-- 3. Chuyên Mục / Danh Mục -->
        <div class="wp-sidebar-box">
          <div class="sidebar-box-header">
            <h4>Chuyên Mục Bài Viết</h4>
          </div>
          <div class="sidebar-box-body">
            <div class="category-checkbox-list">
              <label class="checkbox-item">
                <input type="radio" name="category_slug" value="tin-tuc" checked />
                <span>Bảng Báo Giá VLXD & Tin Tức</span>
              </label>
              <label class="checkbox-item">
                <input type="radio" name="category_slug" value="kinh-nghiem" />
                <span>Cẩm Nang Kỹ Thuật Xây Dựng</span>
              </label>
              <label class="checkbox-item">
                <input type="radio" name="category_slug" value="thiet-bi-ve-sinh" />
                <span>Thiết Bị Vệ Sinh & Nội Thất</span>
              </label>
            </div>
          </div>
        </div>

        <!-- 4. Tác Giả & EEAT -->
        <div class="wp-sidebar-box">
          <div class="sidebar-box-header">
            <h4>Tác Giả (EEAT)</h4>
          </div>
          <div class="sidebar-box-body">
            <select class="wp-select">
              <option>Chuyên viên Marketing – VLXD Hoàng Yến</option>
              <option>Hoàng Yến (CEO & Sáng lập)</option>
              <option>Thế Anh (Giám đốc điều hành)</option>
            </select>
          </div>
        </div>

      </div>

    </form>

    <!-- AI Assistant Modal Component -->
    <AIAssistantModal targetType="post" />

  </div>
</AdminLayout>

<style>
