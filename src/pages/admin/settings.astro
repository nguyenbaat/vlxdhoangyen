---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SettingsRepo } from '../../server/db/repo.js';

let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const fields = [
      'company_name',
      'brand_name',
      'tax_id',
      'founding_year',
      'address',
      'hotline_main',
      'hotline_alt',
      'contact_person_main',
      'contact_person_alt',
      'email',
      'zalo_url',
      'facebook_url',
      'youtube_url',
      'instagram_url',
      'twitter_url',
      'maps_embed_url',
      'logo_url',
      'banner_url',
      'default_seo_title',
      'default_seo_desc',
      'ai_provider',
      'gemini_api_key',
      'gemini_model',
      'openai_api_key',
      'openai_model',
      'ai_system_prompt'
    ];

    for (const field of fields) {
      const val = formData.get(field)?.toString() || '';
      await SettingsRepo.update(field, val);
    }

    successMsg = 'Đã lưu cấu hình cài đặt hệ thống & API AI thành công!';
  } catch (err: any) {
    errorMsg = err.message;
  }
}

const settings = await SettingsRepo.getAll();
---

<AdminLayout title="Cài Đặt Hệ Thống & Thông Tin Doanh Nghiệp" activeNav="settings">
  <div class="settings-container">
    {successMsg && <div class="alert alert-success">{successMsg}</div>}
    {errorMsg && <div class="alert alert-error">{errorMsg}</div>}

    <form method="POST" class="settings-form">
      <div class="settings-card">
        <h3>1. Thông Tin Pháp Nhân & Nhận Diện Thương Hiệu</h3>
        <div class="form-grid-2">
          <div class="form-group">
            <label for="company_name">Tên pháp nhân công ty (Đăng ký kinh doanh)</label>
            <input type="text" id="company_name" name="company_name" value={settings.company_name} required />
          </div>
          <div class="form-group">
            <label for="brand_name">Tên thương hiệu giao dịch</label>
            <input type="text" id="brand_name" name="brand_name" value={settings.brand_name} required />
          </div>
          <div class="form-group">
            <label for="tax_id">Mã số thuế (MST)</label>
            <input type="text" id="tax_id" name="tax_id" value={settings.tax_id} required />
          </div>
          <div class="form-group">
            <label for="founding_year">Năm thành lập</label>
            <input type="text" id="founding_year" name="founding_year" value={settings.founding_year} />
          </div>
        </div>
      </div>
      <div class="settings-card">
        <h3>2. Đường Dây Nóng & Liên Hệ</h3>
        <div class="form-grid-2">
          <div class="form-group">
            <label for="hotline_main">Hotline chính (Tư vấn kỹ thuật & Báo giá)</label>
            <input type="text" id="hotline_main" name="hotline_main" value={settings.hotline_main} required />
          </div>
          <div class="form-group">
            <label for="contact_person_main">Người phụ trách hotline chính</label>
            <input type="text" id="contact_person_main" name="contact_person_main" value={settings.contact_person_main} />
          </div>
          <div class="form-group">
            <label for="hotline_alt">Hotline điều hành / CEO</label>
            <input type="text" id="hotline_alt" name="hotline_alt" value={settings.hotline_alt} required />
          </div>
          <div class="form-group">
            <label for="contact_person_alt">Người phụ trách hotline CEO</label>
            <input type="text" id="contact_person_alt" name="contact_person_alt" value={settings.contact_person_alt} />
          </div>
          <div class="form-group" style="grid-column: 1 / -1;">
            <label for="address">Địa chỉ Showroom / Trụ sở chính</label>
            <input type="text" id="address" name="address" value={settings.address} required />
          </div>
          <div class="form-group" style="grid-column: 1 / -1;">
            <label for="email">Email tiếp nhận báo giá</label>
            <input type="email" id="email" name="email" value={settings.email} required />
          </div>
        </div>
      </div>
      <div class="settings-card">
        <h3>3. Mạng Xã Hội, Logo & Bản Đồ</h3>
        <div class="form-grid-2">
          <div class="form-group">
            <label for="zalo_url">Liên kết Chat Zalo</label>
            <input type="url" id="zalo_url" name="zalo_url" value={settings.zalo_url} />
          </div>
          <div class="form-group">
            <label for="facebook_url">Fanpage Facebook</label>
            <input type="url" id="facebook_url" name="facebook_url" value={settings.facebook_url} />
          </div>
          <div class="form-group">
            <label for="youtube_url">Kênh YouTube</label>
            <input type="url" id="youtube_url" name="youtube_url" value={settings.youtube_url} />
          </div>
          <div class="form-group">
            <label for="instagram_url">Instagram URL</label>
            <input type="url" id="instagram_url" name="instagram_url" value={settings.instagram_url || ''} />
          </div>
          <div class="form-group">
            <label for="twitter_url">Twitter / X URL</label>
            <input type="url" id="twitter_url" name="twitter_url" value={settings.twitter_url} />
          </div>
          <div class="form-group">
            <label for="logo_url">URL Logo Website</label>
            <input type="url" id="logo_url" name="logo_url" value={settings.logo_url} />
          </div>
          <div class="form-group">
            <label for="banner_url">URL Banner Trang Chủ</label>
            <input type="url" id="banner_url" name="banner_url" value={settings.banner_url} />
          </div>
          <div class="form-group" style="grid-column: 1 / -1;">
            <label for="maps_embed_url">Mã nhúng iframe Google Maps (src)</label>
            <input type="text" id="maps_embed_url" name="maps_embed_url" value={settings.maps_embed_url} />
          </div>
        </div>
      </div>
      <div class="settings-card">
        <h3>4. Cấu Hình SEO Mặc Định</h3>
        <div class="form-group">
          <label for="default_seo_title">Tiêu Đề Trang Chủ Mặc Định (SEO Title)</label>
          <input type="text" id="default_seo_title" name="default_seo_title" value={settings.default_seo_title} required />
        </div>
        <div class="form-group">
          <label for="default_seo_desc">Mô Tả Trang Chủ Mặc Định (Meta Description)</label>
          <textarea id="default_seo_desc" name="default_seo_desc" rows="3" required>{settings.default_seo_desc}</textarea>
        </div>
      </div>

      <!-- 5. AI GENERATOR & API CONNECT -->
      <div class="settings-card ai-settings-card">
        <div class="card-header-flex">
          <div>
            <h3>5. Kết Nối API AI Generator (Gemini & OpenAI GPT)</h3>
            <p class="section-subtext">Cấu hình API Key để tự động tạo nội dung bài viết, mô tả sản phẩm, tiêu đề và thẻ meta SEO theo quy chuẩn.</p>
          </div>
          <span class="ai-chip-badge">AI Assistant</span>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label for="ai_provider">Nhà Cung Cấp AI Mặc Định:</label>
          <select id="ai_provider" name="ai_provider" class="form-select-lg">
            <option value="gemini" selected={settings.ai_provider !== 'openai'}>Google Gemini API (Khuyên dùng - Nhanh, Hỗ trợ Vision phân tích ảnh & Miễn phí/Chi phí thấp)</option>
            <option value="openai" selected={settings.ai_provider === 'openai'}>OpenAI GPT API (GPT-4o, GPT-4o-mini)</option>
          </select>
        </div>

        <!-- Google Gemini Section -->
        <div class="ai-provider-box" id="gemini-config-box">
          <div class="provider-box-header">
            <div class="provider-icon gemini-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 24C12 17.3726 6.62742 12 0 12C6.62742 12 12 6.62742 12 0C12 6.62742 17.3726 12 24 12C17.3726 12 12 17.3726 12 24Z"/></svg>
            </div>
            <strong>Cấu Hình Google Gemini API</strong>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="gemini_api_key">Gemini API Key</label>
              <div class="password-input-wrap">
                <input 
                  type="password" 
                  id="gemini_api_key" 
                  name="gemini_api_key" 
                  value={settings.gemini_api_key || ''} 
                  placeholder="AIzaSy..." 
                />
                <button type="button" class="btn-toggle-key" data-target="gemini_api_key">Hiện</button>
              </div>
              <small class="key-hint">Lấy API Key miễn phí tại: <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer">Google AI Studio ↗</a></small>
            </div>

            <div class="form-group">
              <label for="gemini_model_select">Gemini Model (Chọn từ danh sách hoặc tự nhập)</label>
              <div class="model-select-wrap">
                <select id="gemini_model_select" class="form-select">
                  <option value="gemini-3.6-flash" selected={settings.gemini_model === 'gemini-3.6-flash'}>gemini-3.6-flash (Mới nhất 3.6 - Cân bằng tốc độ & trí thông minh)</option>
                  <option value="gemini-3.5-flash" selected={settings.gemini_model === 'gemini-3.5-flash'}>gemini-3.5-flash (Gemini 3.5 Flash)</option>
                  <option value="gemini-3.5-flash-lite" selected={settings.gemini_model === 'gemini-3.5-flash-lite'}>gemini-3.5-flash-lite (Gemini 3.5 Flash-Lite - Tiết kiệm chi phí)</option>
                  <option value="gemini-3.1-flash-lite" selected={settings.gemini_model === 'gemini-3.1-flash-lite'}>gemini-3.1-flash-lite (Gemini 3.1 Flash-Lite)</option>
                  <option value="gemini-2.5-flash" selected={settings.gemini_model === 'gemini-2.5-flash'}>gemini-2.5-flash (Gemini 2.5 Flash - Khuyên dùng)</option>
                  <option value="gemini-2.5-pro" selected={settings.gemini_model === 'gemini-2.5-pro'}>gemini-2.5-pro (Gemini 2.5 Pro - Suy luận chuyên sâu)</option>
                  <option value="gemini-2.0-flash" selected={settings.gemini_model === 'gemini-2.0-flash'}>gemini-2.0-flash (Gemini 2.0 Flash)</option>
                  <option value="gemini-1.5-flash" selected={settings.gemini_model === 'gemini-1.5-flash'}>gemini-1.5-flash (Gemini 1.5 Flash)</option>
                  <option value="gemini-1.5-pro" selected={settings.gemini_model === 'gemini-1.5-pro'}>gemini-1.5-pro (Gemini 1.5 Pro)</option>
                  <option value="__custom__" selected={!['gemini-3.6-flash','gemini-3.5-flash','gemini-3.5-flash-lite','gemini-3.1-flash-lite','gemini-2.5-flash','gemini-2.5-pro','gemini-2.0-flash','gemini-1.5-flash','gemini-1.5-pro'].includes(settings.gemini_model || 'gemini-3.6-flash')}>Tự nhập Model ID khác...</option>
                </select>
                <input 
                  type="text" 
                  id="gemini_model" 
                  name="gemini_model" 
                  value={settings.gemini_model || 'gemini-3.6-flash'} 
                  class="form-input" 
                  style={['gemini-3.6-flash','gemini-3.5-flash','gemini-3.5-flash-lite','gemini-3.1-flash-lite','gemini-2.5-flash','gemini-2.5-pro','gemini-2.0-flash','gemini-1.5-flash','gemini-1.5-pro'].includes(settings.gemini_model || 'gemini-3.6-flash') ? 'display:none; margin-top: 8px;' : 'margin-top: 8px;'}
                  placeholder="Nhập Model ID chính xác (vd: gemini-2.5-flash)..."
                />
              </div>
              <small class="key-hint">💡 Đã hỗ trợ trọn bộ dòng Gemini 3 (3.6 Flash, 3.5 Flash, 3.5 Flash-Lite, 3.1 Flash-Lite) và 2.5.</small>
            </div>
          </div>
        </div>

        <!-- OpenAI Section -->
        <div class="ai-provider-box" id="openai-config-box" style="margin-top: 1rem;">
          <div class="provider-box-header">
            <div class="provider-icon openai-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47/ 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zm-1.22-9.45a4.476 4.476 0 0 1 2.34-1.974v5.676a.784.784 0 0 0 .392.681l5.844 3.37-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.38 8.854zm16.597 3.859l-5.843-3.37 2.02-1.168a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.402-.68zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 10.23V7.897a.08.08 0 0 1 .033-.061l4.839-2.791a4.5 4.5 0 0 1 6.68 5.612zM10.164 13.5l-2.01-1.16a.08.08 0 0 1-.038-.057V6.7a4.5 4.5 0 0 1 7.374-3.454l-.141.08-4.78 2.76a.795.795 0 0 0-.392.681v6.733h-.007z"/></svg>
            </div>
            <strong>Cấu Hình OpenAI GPT API</strong>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="openai_api_key">OpenAI API Key</label>
              <div class="password-input-wrap">
                <input 
                  type="password" 
                  id="openai_api_key" 
                  name="openai_api_key" 
                  value={settings.openai_api_key || ''} 
                  placeholder="sk-proj-..." 
                />
                <button type="button" class="btn-toggle-key" data-target="openai_api_key">Hiện</button>
              </div>
              <small class="key-hint">Lấy API Key tại: <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer">OpenAI Platform ↗</a></small>
            </div>

            <div class="form-group">
              <label for="openai_model_select">OpenAI Model (Chọn từ danh sách hoặc tự nhập)</label>
              <div class="model-select-wrap">
                <select id="openai_model_select" class="form-select">
                  <option value="gpt-4o-mini" selected={settings.openai_model === 'gpt-4o-mini'}>gpt-4o-mini (Tiết kiệm, tốc độ cao & chất lượng tốt)</option>
                  <option value="gpt-4o" selected={settings.openai_model === 'gpt-4o'}>gpt-4o (Model flagship thông minh toàn diện)</option>
                  <option value="gpt-4.5-preview" selected={settings.openai_model === 'gpt-4.5-preview'}>gpt-4.5-preview (Thế hệ GPT-4.5 mới nhất)</option>
                  <option value="o3-mini" selected={settings.openai_model === 'o3-mini'}>o3-mini (Tư duy logic & toán học cao cấp)</option>
                  <option value="o1" selected={settings.openai_model === 'o1'}>o1 (Mô hình suy luận chuyên sâu)</option>
                  <option value="gpt-3.5-turbo" selected={settings.openai_model === 'gpt-3.5-turbo'}>gpt-3.5-turbo (Cơ bản)</option>
                  <option value="__custom__" selected={!['gpt-4o-mini','gpt-4o','gpt-4.5-preview','o3-mini','o1','gpt-3.5-turbo'].includes(settings.openai_model || 'gpt-4o-mini')}>Tự nhập Model ID khác...</option>
                </select>
                <input 
                  type="text" 
                  id="openai_model" 
                  name="openai_model" 
                  value={settings.openai_model || 'gpt-4o-mini'} 
                  class="form-input" 
                  style={['gpt-4o-mini','gpt-4o','gpt-4.5-preview','o3-mini','o1','gpt-3.5-turbo'].includes(settings.openai_model || 'gpt-4o-mini') ? 'display:none; margin-top: 8px;' : 'margin-top: 8px;'}
                  placeholder="Nhập Model ID chính xác (vd: gpt-4o)..."
                />
              </div>
              <small class="key-hint">💡 Hỗ trợ gpt-4o, gpt-4o-mini, gpt-4.5-preview, o3-mini...</small>
            </div>
          </div>
        </div>

        <!-- AI Test Connection Button & Status -->
        <div class="ai-test-row">
          <button type="button" id="btn-test-ai" class="btn btn-outline btn-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span>Kiểm Tra Kết Nối AI (Test API)</span>
          </button>
          <span id="ai-test-status" class="test-status-tag" style="display: none;"></span>
        </div>

        <!-- Custom System Prompt for AI Generator -->
        <div class="form-group" style="margin-top: 1.25rem;">
          <label for="ai_system_prompt">Quy Chuẩn Biên Tập & System Prompt (Tùy biến):</label>
          <textarea 
            id="ai_system_prompt" 
            name="ai_system_prompt" 
            rows="5" 
            placeholder="Nhập hướng dẫn riêng cho AI khi tạo bài viết và sản phẩm..."
          >{settings.ai_system_prompt || `Bạn là chuyên viên biên tập nội dung SEO cho Siêu Thị VLXD Hoàng Yến tại 299 Lê Duẩn, Phường Đông Hà, Tỉnh Quảng Trị (Hotline: 0946.575.579).
Mục tiêu: Chính xác > Hữu ích > Trung lập > SEO.
Quy tắc:
- Không bịa đặt giá tiền cụ thể hoặc cam kết giá rẻ nhất (hướng dẫn khách liên hệ hotline để nhận báo giá hiện hành).
- Không tự suy diễn bảo hành/đổi trả/tồn kho ảo.
- Chỉ mô tả đúng quy cách, đặc tính kỹ thuật, ứng dụng thi công và hướng dẫn bảo quản vật tư.
- Định dạng bài viết rõ ràng với các thẻ Markdown: Tiêu đề H2/H3, Bảng thông số kỹ thuật, Danh sách gạch đầu dòng, Lưu ý công trình và 3-5 câu hỏi thường gặp (FAQ).`}</textarea>
          <small class="field-hint">💡 AI Generator sẽ tự động tuân theo bộ quy chuẩn trên khi tự động sinh nội dung sản phẩm và bài viết.</small>
        </div>

      </div>

      <button type="submit" class="btn btn-primary btn-lg" style="margin-top: 1rem; display: inline-flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Lưu Thay Đổi Cài Đặt
      </button>
    </form>
  </div>
</AdminLayout>

<style>
  .settings-container {
    max-width: 900px;
  }
  .settings-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }
  .settings-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
    padding-bottom: 0;
    border-bottom: none;
  }

  .card-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-subtext {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 4px 0 0 0;
  }

  .ai-chip-badge {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .form-select-lg {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    background: #ffffff;
    font-weight: 600;
    color: #1e293b;
  }

  .ai-provider-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.25rem;
  }

  .provider-box-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1rem;
    color: #0f172a;
    font-size: 0.95rem;
  }

  .provider-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gemini-icon { background: #dbeafe; color: #2563eb; }
  .openai-icon { background: #10a37f; color: #ffffff; }

  .password-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .password-input-wrap input {
    padding-right: 50px !important;
  }

  .btn-toggle-key {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: #e2e8f0;
    border: none;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
  }

  .key-hint {
    display: block;
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 4px;
  }

  .ai-test-row {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .test-status-tag {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .test-status-tag.success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .test-status-tag.error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
  .test-status-tag.loading { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }

  .field-hint {
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 4px;
    display: block;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .form-group input, .form-group textarea, .form-group select {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    outline: none;
    box-sizing: border-box;
  }
  .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
    border-color: var(--color-primary);
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .alert-success { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
  .alert-error { background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; }

  @media (max-width: 640px) {
    .form-grid-2 { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Show/Hide Password buttons
    document.querySelectorAll('.btn-toggle-key').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement;
        if (input) {
          if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = 'Ẩn';
          } else {
            input.type = 'password';
            btn.textContent = 'Hiện';
          }
        }
      });
    });

    // Model Select Change Handlers
    const geminiSelect = document.getElementById('gemini_model_select') as HTMLSelectElement;
    const geminiInput = document.getElementById('gemini_model') as HTMLInputElement;
    geminiSelect?.addEventListener('change', () => {
      if (geminiSelect.value === '__custom__') {
        geminiInput.style.display = 'block';
        geminiInput.value = '';
        geminiInput.focus();
      } else {
        geminiInput.style.display = 'none';
        geminiInput.value = geminiSelect.value;
      }
    });

    const openaiSelect = document.getElementById('openai_model_select') as HTMLSelectElement;
    const openaiInput = document.getElementById('openai_model') as HTMLInputElement;
    openaiSelect?.addEventListener('change', () => {
      if (openaiSelect.value === '__custom__') {
        openaiInput.style.display = 'block';
        openaiInput.value = '';
        openaiInput.focus();
      } else {
        openaiInput.style.display = 'none';
        openaiInput.value = openaiSelect.value;
      }
    });

    // Test AI Connection button
    const testBtn = document.getElementById('btn-test-ai') as HTMLButtonElement;
    const testStatus = document.getElementById('ai-test-status');

    testBtn?.addEventListener('click', async () => {
      const provider = (document.getElementById('ai_provider') as HTMLSelectElement)?.value || 'gemini';
      const geminiKey = (document.getElementById('gemini_api_key') as HTMLInputElement)?.value.trim();
      const geminiModel = (document.getElementById('gemini_model') as HTMLInputElement)?.value.trim() || 'gemini-2.5-flash';
      const openaiKey = (document.getElementById('openai_api_key') as HTMLInputElement)?.value.trim();
      const openaiModel = (document.getElementById('openai_model') as HTMLInputElement)?.value.trim() || 'gpt-4o-mini';

      if (provider === 'gemini' && !geminiKey) {
        alert('Vui lòng nhập Gemini API Key trước khi kiểm tra.');
        return;
      }
      if (provider === 'openai' && !openaiKey) {
        alert('Vui lòng nhập OpenAI API Key trước khi kiểm tra.');
        return;
      }

      testBtn.disabled = true;
      if (testStatus) {
        testStatus.style.display = 'inline-block';
        testStatus.className = 'test-status-tag loading';
        testStatus.textContent = 'Đang kiểm tra kết nối API...';
      }

      try {
        const res = await fetch('/api/admin/ai-generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'test',
            provider,
            gemini_key: geminiKey,
            gemini_model: geminiModel,
            openai_key: openaiKey,
            openai_model: openaiModel
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          if (testStatus) {
            testStatus.className = 'test-status-tag success';
            testStatus.textContent = `✓ Kết nối thành công tới ${provider.toUpperCase()} (${data.model})! Phản hồi: "${data.reply}"`;
          }
        } else {
          throw new Error(data.error || 'Kiểm tra kết nối thất bại.');
        }
      } catch (err: any) {
        if (testStatus) {
          testStatus.className = 'test-status-tag error';
          testStatus.textContent = `✗ Lỗi kết nối: ${err.message}`;
        }
      } finally {
        testBtn.disabled = false;
      }
    });
  });
</script>
