</style>

<script>
  // Industrial Quote Form Handling
  const quoteForm = document.getElementById('home-quote-form') as HTMLFormElement;
  const submitBtn = document.getElementById('q-submit-btn') as HTMLButtonElement;
  const statusMsg = document.getElementById('q-status-msg');

  if (quoteForm && submitBtn && statusMsg) {
    quoteForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Đang gửi yêu cầu...</span>';

      const formData = new FormData(quoteForm);
      const payload = {
        customer_name: formData.get('customer_name'),
        customer_phone: formData.get('customer_phone'),
        address: formData.get('address'),
        notes: formData.get('notes'),
        product_name: 'Báo Giá Tổng Hợp Dự Án'
      };

      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          statusMsg.className = 'status-msg success';
          statusMsg.style.display = 'block';
          statusMsg.textContent = 'Đã gửi yêu cầu thành công! Kỹ sư Hoàng Yến sẽ gọi lại báo giá ngay.';
          quoteForm.reset();
        } else {
          throw new Error(data.error || 'Có lỗi xảy ra.');
        }
      } catch (err: any) {
        statusMsg.className = 'status-msg error';
        statusMsg.style.display = 'block';
        statusMsg.textContent = 'Lỗi: ' + err.message;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Gửi Yêu Cầu Báo Giá Ngay</span>';
      }
    });
  }
</script>
