---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { CategoryRepo, ProductRepo, BrandRepo, PostRepo, SettingsRepo } from '../server/db/repo.js';

const settings = await SettingsRepo.getAll();
const vlxdCategories = await CategoryRepo.getMainCategories('vlxd');
const noiThatCategories = await CategoryRepo.getMainCategories('noi-that');
const featuredProducts = await ProductRepo.getFeatured(8);
const { total: totalProductsCount } = await ProductRepo.getAll({ limit: 1, status: 'published' });
const brands = (await BrandRepo.getAll()).filter(b => b.is_featured === 1);
const latestPosts = await PostRepo.getLatest(3);

const siteUrl = 'https://vlxdhoangyen.com';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: settings.brand_name || 'Siêu Thị VLXD Hoàng Yến',
  description: settings.default_seo_desc || 'Siêu Thị VLXD Hoàng Yến cung cấp sắt thép Hòa Phát, xi măng, tôn Đông Á, gạch tuynel và thiết bị vệ sinh tại Quảng Trị.',
  publisher: {
    '@id': `${siteUrl}/#organization`
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/san-pham/?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  },
  inLanguage: 'vi-VN'
};
---

<Layout 
  title="Vật Liệu Xây Dựng Tại Quảng Trị - Siêu Thị VLXD Hoàng Yến"
  description="Siêu Thị VLXD Hoàng Yến cung cấp sắt thép Hòa Phát, xi măng, tôn Đông Á, gạch tuynel và thiết bị vệ sinh tại Quảng Trị. Thành lập từ 2003, hơn 20 năm kinh nghiệm đồng hành cùng 1.250+ nhà thầu."
  currentPath="/"
  schemas={[websiteSchema]}
>
  <section class="hero-industrial">
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-eyebrow">
          <span class="hero-badge">Nhà Cung Ứng VLXD Uy Tín</span>
          <span class="hero-location">Đông Hà • Quảng Trị</span>
        </div>

        <h1 class="hero-title">
          Siêu Thị Vật Liệu Xây Dựng Hoàng Yến
        </h1>

        <p class="hero-description">
          Đại lý cấp 1 cung cấp VLXD tại tỉnh Quảng Trị, thành lập từ năm 2003 với hơn 20 năm kinh nghiệm đồng hành cùng hơn 1.250+ nhà thầu công trình. Cung ứng sắt thép, xi măng, tôn, gạch xây dựng và thiết bị vệ sinh chất lượng cao tận công trình.
        </p>

        <div class="hero-actions">
          <a href="#request-quote" class="btn btn-primary btn-lg">
            <span>Nhận Báo Giá</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/san-pham/" class="btn btn-secondary btn-lg">
            <span>Xem Sản Phẩm</span>
          </a>
        </div>

        <!-- Metric badges -->
        <div class="hero-metrics">
          <div class="metric-item">
            <span class="metric-number">20+</span>
            <span class="metric-label">Năm Kinh Nghiệm (Từ 2003)</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-number">1.250+</span>
            <span class="metric-label">Nhà Thầu Tin Chọn</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-number">Chính Xác</span>
            <span class="metric-label">Barem &amp; Tiến Độ Giao Nhận</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Industrial Panel -->
      <div class="hero-visual">
        <div class="hero-image-frame">
          <img 
            src="/images/HoangYen.jpg" 
            alt="Cửa hàng Siêu Thị VLXD Hoàng Yến tại 299 Lê Duẩn, Đông Hà, Quảng Trị" 
            width="600"
            height="400"
            loading="eager"
            class="hero-main-img"
          />
          <div class="hero-floating-badge">
            <div class="badge-title-row">
              <span class="badge-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              </span>
              <strong>Cửa hàng 299 Lê Duẩn, Đông Hà, Quảng Trị</strong>
            </div>
            <span class="badge-tagline">Bạn của mọi nhà</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-concrete" id="categories-section">
    <div class="container">
      <!-- 2.1 GROUP 1: VẬT LIỆU XÂY THÔ & KẾT CẤU -->
      <div class="section-header">
        <div class="eyebrow">Nhóm Ngành Hàng 01</div>
        <h2>VẬT LIỆU XÂY THÔ & KẾT CẤU</h2>
        <p>Cung ứng các loại sắt thép, xi măng, tôn lợp, gạch tuynel, lưới thép và phụ kiện xây thô chịu lực từ các thương hiệu lớn.</p>
      </div>

      <div class="categories-showcase-grid vlxd-showcase-grid">
        {vlxdCategories.map((cat) => (
          <a href={`/${cat.slug}/`} class="category-showcase-card">
            <div class="category-showcase-img-box">
              <img src={cat.image_url || '/anh-sanpham.png'} alt={`${cat.name} xây thô`} width="180" height="135" loading="lazy" />
            </div>
            <div class="category-showcase-info">
              <span class="category-showcase-name">{cat.name}</span>
              <span class="category-showcase-action">
                <span>Xem Báo Giá</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- 2.2 GROUP 2: THIẾT BỊ VỆ SINH & PHÒNG TẮM -->
      <div class="section-header" style="margin-top: var(--space-14); padding-top: var(--space-12); border-top: 1px solid var(--color-border);">
        <div class="eyebrow" style="color: var(--color-red);">Nhóm Ngành Hàng 02</div>
        <h2>THIẾT BỊ VỆ SINH & PHÒNG TẮM</h2>
        <p>Cung cấp thiết bị phòng tắm từ Caesar, Mowoen với độ bền men sứ cao và thiết kế hiện đại.</p>
      </div>

      <div class="categories-showcase-grid noi-that-showcase-grid">
        {noiThatCategories.map((cat) => (
          <a href={`/${cat.slug}/`} class="category-showcase-card">
            <div class="category-showcase-img-box">
              <img src={cat.image_url || '/anh-sanpham.png'} alt={`Thiết bị ${cat.name} hoàn thiện`} width="180" height="135" loading="lazy" />
            </div>
            <div class="category-showcase-info">
              <span class="category-showcase-name">{cat.name}</span>
              <span class="category-showcase-action">
                <span>Xem Báo Giá</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
  <section class="section section-about">
    <div class="container">
      <div class="about-grid">
        <div class="about-visual">
          <div class="about-image-stack">
            <img src="/images/cta-vlxd.png" alt="Cửa hàng Siêu Thị VLXD Hoàng Yến tại Đông Hà Quảng Trị" width="560" height="380" loading="lazy" class="about-img-main" />
          </div>
        </div>

        <div class="about-content">
          <div class="eyebrow">Giới Thiệu Doanh Nghiệp</div>
          <h2>Siêu Thị VLXD Hoàng Yến — Đối Tác Cung Ứng Vật Liệu Tại Quảng Trị</h2>
          <p class="about-lead">
            Tọa lạc tại trung tâm thành phố Đông Hà, <strong>CÔNG TY TNHH MTV VLXD TỔNG HỢP HOÀNG YẾN</strong> là đơn vị cung ứng vật liệu xây dựng cho các công trình nhà ở và dự án tại khu vực tỉnh Quảng Trị.
          </p>

          <div class="about-pillars">
            <div class="pillar-item">
              <div class="pillar-header">
                <span class="pillar-bullet"></span>
                <h3 class="pillar-title">Nguồn Hàng Minh Bạch & Rõ Ràng</h3>
              </div>
              <p>Nguồn hàng từ các thương hiệu VLXD lớn (Hòa Phát, Nghi Sơn, Bỉm Sơn, Sông Gianh, Tôn Đông Á, Caesar, Mowoen), có thông tin xuất xứ và chứng từ theo từng sản phẩm. Chính sách giá được áp dụng theo chủng loại và khối lượng đơn hàng.</p>
            </div>

            <div class="pillar-item">
              <div class="pillar-header">
                <span class="pillar-bullet"></span>
                <h3 class="pillar-title">Chuẩn Barem & Hóa Đơn Hợp Lệ</h3>
              </div>
              <p>Mọi lô thép cuộn, thép cây và xi măng đều chuẩn barem nhà sản xuất, nguồn gốc rõ ràng và hỗ trợ xuất hóa đơn GTGT đầy đủ.</p>
            </div>

            <div class="pillar-item">
              <div class="pillar-header">
                <span class="pillar-bullet"></span>
                <h3 class="pillar-title">Hỗ Trợ Giao Hàng An Toàn Tận Nơi</h3>
              </div>
              <p>Hỗ trợ vận chuyển và bốc xếp hàng hóa an toàn đến công trình tại khu vực Đông Hà và lân cận theo tiến độ thi công.</p>
            </div>
          </div>

          <div class="about-action">
            <a href="/gioi-thieu/" class="btn btn-dark">
              <span>Xem Giới Thiệu Chi Tiết</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="brands-showcase-section">
    <div class="container">
      <!-- Centered Header with Line Dividers -->
      <div class="brands-divider-header">
        <span class="divider-line"></span>
        <h2 class="brands-title-heading">THƯƠNG HIỆU VẬT LIỆU XÂY DỰNG</h2>
        <span class="divider-line"></span>
      </div>
    </div>

    <!-- Full-Width Seamless Continuous Logo Marquee -->
    <div class="marquee-wrapper" aria-label="Danh sách thương hiệu đối tác liên tục">
      <div class="marquee-track">
        <!-- Set 1 -->
        {brands.map(brand => (
          <a href={`/san-pham/${brand.slug}/`} class="marquee-logo-item" title={brand.name}>
            <img src={brand.logo_url || '/anh-logo.png'} alt={`Logo đối tác ${brand.name}`} width="140" height="60" class="brand-showcase-img" loading="lazy" />
          </a>
        ))}
        <!-- Set 2 (Continuous marquee loop with unique alt) -->
        {brands.map(brand => (
          <a href={`/san-pham/${brand.slug}/`} class="marquee-logo-item" aria-hidden="true" tabindex="-1">
            <img src={brand.logo_url || '/anh-logo.png'} alt={`Thương hiệu ${brand.name} tại Hoàng Yến`} width="140" height="60" class="brand-showcase-img" loading="lazy" />
          </a>
        ))}
        <!-- Set 3 (Ensure wide screen continuity with unique alt) -->
        {brands.map(brand => (
          <a href={`/san-pham/${brand.slug}/`} class="marquee-logo-item" aria-hidden="true" tabindex="-1">
            <img src={brand.logo_url || '/anh-logo.png'} alt={`Đại lý ${brand.name} tại Quảng Trị`} width="140" height="60" class="brand-showcase-img" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section products-section">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <div class="eyebrow">Sản Phẩm Cốt Lõi</div>
          <h2>Vật Liệu Xây Dựng & Thiết Bị Sẵn Kho</h2>
          <p>Đáp ứng số lượng lớn theo nhu cầu công trình với đầy đủ chủng loại chuẩn kỹ thuật.</p>
        </div>
        <a href="/san-pham/" class="btn btn-outline">
          <span>Xem Toàn Bộ Sản Phẩm ({totalProductsCount || featuredProducts.length}+)</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <div class="products-grid">
        {featuredProducts.map(p => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>
  <section class="section section-quote-industrial" id="request-quote">
    <div class="container">
      <div class="quote-grid">
        <div class="quote-info">
          <div class="quote-eyebrow-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
            <span>Báo Giá Theo Khối Lượng</span>
          </div>
          <h2 class="quote-main-title">Nhận Báo Giá VLXD Theo Khối Lượng Công Trình</h2>
          <p class="quote-main-desc">
            Gửi danh sách vật tư, quy cách và số lượng dự kiến để Hoàng Yến kiểm tra hàng và báo giá phù hợp với nhu cầu công trình.
          </p>

          <div class="quote-benefits">
            <div class="benefit-row">
              <div class="benefit-check-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <span>Báo giá theo chủng loại & khối lượng</span>
            </div>
            <div class="benefit-row">
              <div class="benefit-check-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <span>Hỗ trợ kiểm tra quy cách & mác vật tư</span>
            </div>
            <div class="benefit-row">
              <div class="benefit-check-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <span>Tư vấn phương án giao hàng theo công trình</span>
            </div>
          </div>

          <div class="direct-call-box">
            <div class="direct-call-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.23 2.09z"/></svg>
            </div>
            <div class="direct-call-text">
              <span class="direct-label">Hotline tư vấn & báo giá:</span>
              <a href={`tel:${settings.hotline_main}`} class="direct-phone">{settings.hotline_main}</a>
              <span class="direct-name">Tư Vấn & Tiếp Nhận Đơn Hàng</span>
            </div>
          </div>
        </div>

        <!-- Form Box -->
        <div class="quote-form-card">
          <form id="home-quote-form" class="industrial-form">
            <h3 class="form-title">Gửi Yêu Cầu Báo Giá Vật Tư</h3>
            
            <div class="form-group">
              <label class="form-label" for="q-name">Họ và tên / Tên đơn vị *</label>
              <input type="text" id="q-name" name="customer_name" required class="form-input" placeholder="Ví dụ: Nguyễn Văn A / Công ty Xây Dựng ABC" />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="q-phone">Số điện thoại / Zalo *</label>
                <input type="tel" id="q-phone" name="customer_phone" required class="form-input" placeholder="09xx xxx xxx" />
              </div>
              <div class="form-group">
                <label class="form-label" for="q-address">Địa điểm công trình</label>
                <input type="text" id="q-address" name="address" class="form-input" placeholder="Đông Hà, Triệu Phong..." />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="q-notes">Vật tư & Khối lượng cần báo giá *</label>
              <textarea id="q-notes" name="notes" rows="4" required class="form-textarea" placeholder="Ví dụ: Cần 10 tấn thép D14, 200 bao xi măng Nghi Sơn PCB40 giao tại Đông Hà..."></textarea>
            </div>

            <div class="form-group form-consent-group">
              <label class="consent-checkbox-label" for="q-consent">
                <input type="checkbox" id="q-consent" name="consent" required checked />
                <span>Tôi đồng ý để VLXD Hoàng Yến sử dụng thông tin trên nhằm liên hệ tư vấn và báo giá theo <a href="/chinh-sach-bao-mat/" target="_blank" rel="noopener">Chính sách bảo mật</a>.</span>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg btn-quote-submit" id="q-submit-btn">
              <span>Gửi Yêu Cầu Báo Giá Ngay</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
            <p class="form-privacy-note">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display: inline-block; vertical-align: middle; margin-right: 4px; color: #16a34a;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span>Thông tin của quý khách được bảo mật theo quy định.</span>
            </p>
            <div id="q-status-msg" class="status-msg" style="display:none;"></div>
          </form>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-concrete">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow">Thế Mạnh Doanh Nghiệp</div>
        <h2>Tại Sao Chọn VLXD Hoàng Yến?</h2>
        <p>4 giá trị cốt lõi làm nên sự tin cậy của khách hàng tại Quảng Trị.</p>
      </div>

      <div class="why-grid">
        <div class="why-card">
          <div class="why-number">01</div>
          <h3 class="why-title">Nguồn Hàng Rõ Ràng</h3>
          <p class="why-desc">Sản phẩm có thông tin thương hiệu, quy cách và chứng từ theo từng đơn hàng.</p>
        </div>

        <div class="why-card">
          <div class="why-number">02</div>
          <h3 class="why-title">Minh Bạch Quy Cách & Barem</h3>
          <p class="why-desc">Thép chuẩn barem nhà máy, cân tải trọng chính xác, xi măng date mới xuất xưởng, gạch ngói đồng đều.</p>
        </div>

        <div class="why-card">
          <div class="why-number">03</div>
          <h3 class="why-title">Hỗ Trợ Giao Hàng Công Trình</h3>
          <p class="why-desc">Hỗ trợ giao hàng an toàn, điều phối linh hoạt, đáp ứng tiến độ thi công cho mọi công trình.</p>
        </div>

        <div class="why-card">
          <div class="why-number">04</div>
          <h3 class="why-title">Tư Vấn Vật Tư</h3>
          <p class="why-desc">Hỗ trợ lựa chọn chủng loại, quy cách và khối lượng phù hợp với nhu cầu thực tế.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section service-area-section">
    <div class="container">
      <div class="area-box">
        <div class="area-content">
          <div class="eyebrow">Phạm Vi Giao Hàng</div>
          <h2>Hỗ Trợ Giao Hàng Tận Nơi Công Trình</h2>
          <p>Siêu Thị VLXD Hoàng Yến hỗ trợ phương tiện vận chuyển phục vụ các công trình tại Đông Hà và các địa bàn lân cận:</p>
          
          <div class="area-tags">
            <span class="area-tag">TP. Đông Hà</span>
