---
import Layout from '../layouts/Layout.astro';
import { SettingsRepo } from '../server/db/repo.js';

const settings = await SettingsRepo.getAll();
const siteUrl = 'https://vlxdhoangyen.com';
const breadcrumbs = [
  { name: 'Trang Chủ', url: '/' },
  { name: 'Giới Thiệu', url: '/gioi-thieu/' }
];

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${siteUrl}/gioi-thieu/#webpage`,
  url: `${siteUrl}/gioi-thieu/`,
  name: 'Giới Thiệu Siêu Thị Vật Liệu Xây Dựng Hoàng Yến | Quảng Trị',
  description: 'Giới thiệu Siêu Thị Vật Liệu Xây Dựng Hoàng Yến — Đơn vị phân phối vật liệu xây thô, sắt thép, xi măng, tôn lợp và thiết bị vệ sinh tại Quảng Trị.',
  mainEntity: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#organization`,
    name: 'Siêu Thị Vật Liệu Xây Dựng Hoàng Yến',
    legalName: 'CÔNG TY TNHH MTV VẬT LIỆU XÂY DỰNG TỔNG HỢP HOÀNG YẾN',
    founder: {
      '@type': 'Person',
      name: 'Hoàng Yến',
      jobTitle: 'Nhà sáng lập & CEO – Siêu Thị VLXD Hoàng Yến',
      image: `${siteUrl}/images/CEO-Hoang-Yen.png`
    },
    employee: [
      {
        '@type': 'Person',
        name: 'Thế Anh',
        jobTitle: 'Giám đốc – Siêu Thị VLXD Hoàng Yến',
        image: `${siteUrl}/images/theanh.png`
      },
      {
        '@type': 'Person',
        name: 'Chuyên viên Marketing',
        jobTitle: 'Chuyên viên Marketing & SEO – VLXD Hoàng Yến',
        image: `${siteUrl}/images/chuyenvienmkt.png`
      }
    ]
  }
};

const categoriesList = [
  { name: 'Xi Măng', slug: 'xi-mang', img: '/images/danh-muc/ximang.png', desc: 'PCB30, PCB40, chịu mặn bền sunfat', group: 'vlxd' },
  { name: 'Thép Xây Dựng', slug: 'thep-xay-dung', img: '/images/danh-muc/thep.png', desc: 'Thép Hòa Phát, TISCO D6 – D32', group: 'vlxd' },
  { name: 'Tôn Lợp Mạ Màu', slug: 'ton', img: '/images/danh-muc/ton.png', desc: 'Tôn lạnh, tôn sóng ngói Đông Á', group: 'vlxd' },
  { name: 'Gạch Tuynel', slug: 'gach-tuynel', img: '/images/danh-muc/gach.png', desc: 'Gạch 2 lỗ, 4 lỗ, 6 lỗ, gạch đặc', group: 'vlxd' },
  { name: 'Xà Gồ Mạ Kẽm', slug: 'xa-go', img: '/images/danh-muc/xago.png', desc: 'Xà gồ chữ C, chữ Z các quy cách', group: 'vlxd' },
  { name: 'Lưới Xây Dựng', slug: 'luoi-xay-dung', img: '/images/danh-muc/b40.png', desc: 'Lưới B40, lưới thép đổ sàn bê tông', group: 'vlxd' },
  { name: 'Kẽm Buộc', slug: 'kem-buoc', img: '/images/danh-muc/kem.png', desc: 'Kẽm dẻo 1 ly, 2 ly buộc cốt thép', group: 'vlxd' },
  { name: 'Đinh Vít Xây Dựng', slug: 'dinh-vit', img: '/images/danh-muc/dinhsat.png', desc: 'Đinh bê tông, đinh vít bắn tôn', group: 'vlxd' },
  { name: 'Xốp - Nhựa', slug: 'xop-nhua', img: '/images/danh-muc/xopnhua.png', desc: 'Xốp chống nóng, màng phủ nilong', group: 'vlxd' },
  { name: 'Bồn Cầu', slug: 'bon-cau', img: '/images/danh-muc/boncau.png', desc: 'Bồn cầu 1 khối, 2 khối xả xoáy nano', group: 'tbvs' },
  { name: 'Lavabo Chậu Rửa', slug: 'lavabo', img: '/images/danh-muc/lavabo.png', desc: 'Chậu đặt bàn, treo tường men chống bám', group: 'tbvs' },
  { name: 'Vòi Hoa Sen', slug: 'voi-hoa-sen', img: '/images/danh-muc/voi-hoa-sen.png', desc: 'Sen cây phím đàn, sen tắm nóng lạnh', group: 'tbvs' },
  { name: 'Bồn Tắm Cao Cấp', slug: 'bon-tam', img: '/images/danh-muc/bon-tam.png', desc: 'Bồn tắm ngâm, bồn massage sang trọng', group: 'tbvs' },
  { name: 'Gạch Men Ốp Lát', slug: 'gach-men', img: '/images/danh-muc/gachmen.png', desc: 'Gạch ốp tường, lát sàn granite cao cấp', group: 'tbvs' },
];
---

<Layout
  title="Giới Thiệu Siêu Thị Vật Liệu Xây Dựng Hoàng Yến | Quảng Trị"
  description="Giới thiệu Siêu Thị Vật Liệu Xây Dựng Hoàng Yến — Đơn vị phân phối vật liệu xây thô, sắt thép, xi măng, tôn lợp và thiết bị vệ sinh tại Quảng Trị."
  breadcrumbs={breadcrumbs}
  currentPath="/gioi-thieu/"
  schemas={[aboutPageSchema]}
>
  <div class="about-page-container">
    
    <!-- Hero Header -->
    <header class="about-hero-header">
      <div class="container">
        <div class="about-hero-inner">
          <span class="about-hero-badge">Hồ Sơ Năng Lực Doanh Nghiệp</span>
          <h1 class="about-hero-title">Giới Thiệu Siêu Thị Vật Liệu Xây Dựng Hoàng Yến</h1>
          <p class="about-hero-lead">
            Siêu Thị Vật Liệu Xây Dựng Hoàng Yến là Đại lý cấp 1 cung cấp VLXD tại tỉnh Quảng Trị, thành lập từ năm 2003 với hơn 20 năm kinh nghiệm và được hơn 1.250+ nhà thầu tin chọn trong suốt hơn 20 năm qua.
          </p>
          <p class="about-hero-desc">
            Trải qua hơn 20 năm hình thành và phát triển từ năm 2003, Hoàng Yến từng bước xây dựng hệ thống sản phẩm đa dạng, phục vụ từ khách hàng xây dựng nhà ở dân dụng, đội thợ, nhà thầu cho đến các công trình có nhu cầu mua vật liệu với số lượng lớn. Chúng tôi hướng đến một mục tiêu rõ ràng: <strong>giúp khách hàng dễ tìm đúng vật liệu, đúng quy cách, phù hợp nhu cầu công trình và thuận tiện trong quá trình báo giá – đặt hàng – giao nhận</strong>.
          </p>
        </div>
      </div>
    </header>

    <!-- Main Content Layout -->
    <div class="container section-body">
      <div class="about-layout-grid">
        
        <!-- Primary Article Content -->
        <main class="about-content-primary">
          <!-- 1. Vì Sao Khách Hàng Lựa Chọn VLXD Hoàng Yến? -->
          <section class="about-section">
            <h2 class="section-heading">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="heading-svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Vì Sao Khách Hàng Lựa Chọn VLXD Hoàng Yến?
            </h2>

            <div class="reasons-grid">
              <div class="reason-card">
                <div class="reason-number">01</div>
                <h3>Hơn 20 Năm Uy Tín &amp; 1.250+ Nhà Thầu Tin Chọn</h3>
                <p>Thành lập từ năm 2003, Hoàng Yến là đơn vị cung ứng vật liệu xây dựng hàng đầu tại Quảng Trị, luôn đồng hành tin cậy cùng các công trình dân dụng và dự án lớn.</p>
              </div>

              <div class="reason-card">
                <div class="reason-number">02</div>
                <h3>Danh Mục Sản Phẩm Đa Dạng</h3>
                <p>Từ vật liệu xây thô đến thiết bị hoàn thiện nội thất, khách hàng có thể mua trọn gói trong cùng một hệ thống.</p>
              </div>

              <div class="reason-card">
                <div class="reason-number">03</div>
                <h3>Thông Tin Sản Phẩm Rõ Ràng</h3>
                <p>Website minh bạch đầy đủ: Quy cách, kích thước, mác thép, barem trọng lượng, ứng dụng thực tế và tình trạng tồn kho.</p>
              </div>

              <div class="reason-card">
                <div class="reason-number">04</div>
                <h3>Hỗ Trợ Báo Giá Theo Nhu Cầu</h3>
                <p>Báo giá linh hoạt theo thời điểm, khối lượng mua, thương hiệu và địa điểm giao hàng tối ưu nhất cho công trình.</p>
              </div>

              <div class="reason-card full-width">
                <div class="reason-number">05</div>
                <h3>Hỗ Trợ Giao Vật Liệu Tận Công Trình</h3>
                <p>Đội xe vận chuyển chuyên dụng hỗ trợ vận chuyển an toàn đến tận công trình tại khu vực Đông Hà và các vùng lân cận tại Quảng Trị.</p>
              </div>
            </div>
          </section>

          <!-- 2. Sứ Mệnh & Tầm Nhìn Phát Triển -->
          <section class="about-section">
            <h2 class="section-heading">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="heading-svg"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
              Sứ Mệnh &amp; Tầm Nhìn Phát Triển
            </h2>

            <div class="mission-vision-grid">
              <!-- Mission Card -->
              <div class="mv-card mv-mission">
                <div class="mv-header">
                  <div class="mv-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                  </div>
                  <div>
                    <span class="mv-tag">MISSION</span>
                    <h3 class="mv-title">Sứ Mệnh</h3>
                  </div>
                </div>
                <p class="mv-lead">
                  Cung cấp vật liệu xây dựng phù hợp, thông tin rõ ràng và hỗ trợ khách hàng thuận tiện trong quá trình lựa chọn sản phẩm.
                </p>
              </div>

              <!-- Vision Card -->
              <div class="mv-card mv-vision">
                <div class="mv-header">
                  <div class="mv-icon-badge vision">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </div>
                  <div>
                    <span class="mv-tag vision">VISION</span>
                    <h3 class="mv-title">Tầm Nhìn</h3>
                  </div>
                </div>
                <p class="mv-lead">
                  Phát triển VLXD Hoàng Yến trở thành địa chỉ vật liệu xây dựng đáng tin cậy tại Quảng Trị, kết hợp kinh doanh truyền thống với nền tảng số hiện đại.
                </p>
              </div>
            </div>
          </section>

          <!-- 3. Ban Điều Hành & Đội Ngũ Nhân Sự -->
          <section class="about-section">
            <h2 class="section-heading">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="heading-svg"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              Ban Điều Hành &amp; Đội Ngũ Nhân Sự
            </h2>
            <p>
              Đằng sau mỗi đơn hàng và sự phát triển của Siêu Thị VLXD Hoàng Yến là đội ngũ tâm huyết, giàu kinh nghiệm thực tế và luôn đặt quyền lợi của khách hàng lên hàng đầu:
            </p>

            <div class="team-profiles-grid">
              <!-- Profile 1: Hoàng Yến - Nhà sáng lập -->
              <div class="team-profile-card">
                <div class="team-card-inner">
                  <div class="team-photo-wrap">
                    <img
                      src="/images/CEO-Hoang-Yen.png"
                      alt="Hoàng Yến - Nhà sáng lập VLXD Hoàng Yến"
                      class="team-avatar-img"
                      width="125"
                      height="125"
                      loading="lazy"
                    />
                  </div>
                  <div class="team-info-wrap">
                    <div class="team-header-meta">
                      <div>
                        <h3 class="team-member-name">Hoàng Yến</h3>
                        <div class="team-position">Nhà sáng lập &amp; CEO – Siêu Thị VLXD Hoàng Yến</div>
                      </div>
                      <span class="team-role-tag ceo-tag">NHÀ SÁNG LẬP</span>
                    </div>
                    <div class="team-bio-content">
                      <p>
                        Là người sáng lập và trực tiếp định hướng phát triển Siêu Thị VLXD Hoàng Yến, tập trung xây dựng hệ thống sản phẩm vật liệu xây dựng và thiết bị vệ sinh theo hướng chuyên nghiệp, minh bạch và thuận tiện hơn cho khách hàng trong quá trình tìm hiểu và lựa chọn vật liệu.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Profile 2: Thế Anh - Giám đốc -->
              <div class="team-profile-card">
                <div class="team-card-inner">
                  <div class="team-photo-wrap">
                    <img
                      src="/images/theanh.png"
                      alt="Thế Anh - Giám đốc VLXD Hoàng Yến"
                      class="team-avatar-img"
                      width="125"
                      height="125"
                      loading="lazy"
                    />
                  </div>
                  <div class="team-info-wrap">
                    <div class="team-header-meta">
                      <div>
                        <h3 class="team-member-name">Thế Anh</h3>
                        <div class="team-position">Giám đốc – Siêu Thị VLXD Hoàng Yến</div>
                      </div>
                      <span class="team-role-tag dir-tag">GIÁM ĐỐC</span>
                    </div>
                    <div class="team-bio-content">
                      <p>
                        Thế Anh là Giám đốc Siêu Thị Vật Liệu Xây Dựng Hoàng Yến, trực tiếp tham gia điều hành hoạt động kinh doanh và hỗ trợ khách hàng trong quá trình lựa chọn, báo giá và đặt mua vật liệu xây dựng.
                      </p>
                      <p>
                        Anh phụ trách tiếp nhận nhu cầu thực tế của khách hàng, hỗ trợ báo giá vật liệu, kiểm tra sản phẩm, số lượng, phương án giao nhận và chi phí vận chuyển theo từng đơn hàng. Đồng thời, Thế Anh phối hợp trong quá trình cung ứng vật tư cho khách hàng cá nhân, thợ xây, nhà thầu và các công trình.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Profile 3: Chuyên viên Marketing -->
              <div class="team-profile-card">
                <div class="team-card-inner">
                  <div class="team-photo-wrap">
                    <img
                      src="/images/chuyenvienmkt.png"
                      alt="Chuyên viên Marketing - VLXD Hoàng Yến"
                      class="team-avatar-img"
                      width="125"
                      height="125"
                      loading="lazy"
                    />
                  </div>
                  <div class="team-info-wrap">
                    <div class="team-header-meta">
                      <div>
                        <h3 class="team-member-name">Chuyên viên Marketing</h3>
                        <div class="team-position">Phụ trách nội dung &amp; SEO – VLXD Hoàng Yến</div>
                      </div>
                      <span class="team-role-tag mkt-tag">NỘI DUNG &amp; SEO</span>
                    </div>
                    <div class="team-bio-content">
                      <p>
                        Phụ trách xây dựng và phát triển nội dung truyền thông cho VLXD Hoàng Yến trên website và các kênh digital. Công việc tập trung vào nội dung sản phẩm, bài viết kiến thức vật liệu xây dựng, SEO, hình ảnh truyền thông và tối ưu trải nghiệm thông tin cho khách hàng.
                      </p>
                      <p>
                        Bên cạnh đó, vị trí Marketing hỗ trợ cập nhật thông tin sản phẩm, xây dựng nội dung theo nhu cầu tìm kiếm thực tế và kết nối các hoạt động truyền thông với định hướng phát triển thương hiệu VLXD Hoàng Yến.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- 4. Đồng Hành Cùng Ngành Xây Dựng Tại Quảng Trị (Visual Showcase & Carousel) -->
          <section class="about-section">
            <h2 class="section-heading">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="heading-svg"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              Đồng Hành Cùng Ngành Xây Dựng Tại Quảng Trị
            </h2>
            <p>
              Hoàng Yến tập trung vào lĩnh vực cung ứng vật liệu xây dựng phục vụ thị trường địa phương với hệ thống sản phẩm đa dạng từ xây thô đến hoàn thiện nội thất:
            </p>

            <!-- Slide Chạy Danh Mục Sản Phẩm (Smooth Infinite Marquee Carousel) -->
            <div class="cat-marquee-wrapper">
              <div class="cat-marquee-header">
                <span class="cat-marquee-badge">HỆ THỐNG 14+ DANH MỤC VẬT TƯ</span>
                <span class="cat-marquee-hint">Rê chuột để dừng &bull; Nhấp để xem sản phẩm</span>
              </div>
              <div class="cat-marquee-container">
                <div class="cat-marquee-track">
                  <!-- First loop -->
                  {categoriesList.map((cat) => (
                    <a href={`/${cat.slug}/`} class="cat-slide-card">
                      <div class="cat-slide-img-wrap">
                        <img src={cat.img} alt={cat.name} width="64" height="64" loading="lazy" />
                      </div>
                      <div class="cat-slide-meta">
                        <span class="cat-slide-name">{cat.name}</span>
                        <span class={`cat-slide-tag ${cat.group}`}>{cat.group === 'vlxd' ? 'Xây Thô' : 'Thiết Bị'}</span>
                      </div>
                    </a>
                  ))}
                  <!-- Second loop for infinite seamless scrolling -->
                  {categoriesList.map((cat) => (
                    <a href={`/${cat.slug}/`} class="cat-slide-card" aria-hidden="true">
                      <div class="cat-slide-img-wrap">
                        <img src={cat.img} alt={cat.name} width="64" height="64" loading="lazy" />
                      </div>
                      <div class="cat-slide-meta">
                        <span class="cat-slide-name">{cat.name}</span>
                        <span class={`cat-slide-tag ${cat.group}`}>{cat.group === 'vlxd' ? 'Xây Thô' : 'Thiết Bị'}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <!-- Visual 2-Group Display -->
            <div class="cat-visual-groups">
              <!-- Group 1: Vật Liệu Xây Thô -->
              <div class="cat-group-visual-box">
                <div class="group-visual-header">
                  <div class="gvh-icon vlxd">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                  </div>
                  <div>
                    <span class="gvh-sub">NHÓM 01</span>
                    <h3 class="gvh-title">Vật Liệu Xây Dựng Cơ Bản</h3>
                  </div>
                </div>
                <div class="cat-cards-mini-grid">
                  {categoriesList.filter(c => c.group === 'vlxd').map((cat) => (
                    <a href={`/${cat.slug}/`} class="cat-item-card">
                      <div class="cic-thumb">
                        <img src={cat.img} alt={cat.name} width="48" height="48" loading="lazy" />
                      </div>
                      <div class="cic-info">
                        <h4 class="cic-name">{cat.name}</h4>
                        <p class="cic-desc">{cat.desc}</p>
                      </div>
                      <span class="cic-arrow">&rarr;</span>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Group 2: Thiết Bị Vệ Sinh -->
              <div class="cat-group-visual-box">
                <div class="group-visual-header">
                  <div class="gvh-icon tbvs">
