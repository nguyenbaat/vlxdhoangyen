---
import Layout from '../layouts/Layout.astro';
import { PostRepo, SettingsRepo } from '../server/db/repo.js';

const settings = await SettingsRepo.getAll();
const post = await PostRepo.getBySlug('vlxd-quang-tri');

const breadcrumbs = [
  { name: 'Trang Chủ', url: '/' },
  { name: 'Tin Tức', url: '/tin-tuc/' },
  { name: 'VLXD Quảng Trị', url: '/vlxd-quang-tri/' }
];
---

<Layout
  title={post?.seo_title || 'VLXD Quảng Trị – Báo Giá Vật Liệu Xây Dựng | Siêu Thị Hoàng Yến'}
  description={post?.seo_description || 'Siêu thị VLXD Hoàng Yến tại Quảng Trị. Cung cấp xi măng, sắt thép, gạch ngói, tôn lợp, thiết bị vệ sinh, hỗ trợ giao hàng tận công trình.'}
  ogImage={post?.featured_image}
  breadcrumbs={breadcrumbs}
  currentPath="/vlxd-quang-tri/"
>
  <article class="container post-container">
    <header class="post-header">
      <span class="post-cat-badge">VLXD Tại Quảng Trị</span>
      <h1 class="post-detail-title">{post?.title || 'VLXD Quảng Trị – Cửa Hàng Vật Liệu Xây Dựng Tại Đông Hà'}</h1>
      <div class="post-meta-bar">
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px; color: #0284c7;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg> Đơn vị: Siêu Thị VLXD Hoàng Yến</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px; color: var(--color-red);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> Khu vực: Tỉnh Quảng Trị</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px; color: #16a34a;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> Hotline: {settings.hotline_main}</span>
      </div>
    </header>

    {post?.featured_image && (
      <div class="post-hero-image">
        <img src={post.featured_image} alt="VLXD Quảng Trị Hoàng Yến" width="900" height="450" />
      </div>
    )}

    <div class="post-main-content prose-content" set:html={post?.content} />

    <!-- Local Contact Form -->
    <div class="post-cta-card">
      <h3>Liên Hệ Báo Giá Vật Liệu Xây Dựng Tại Quảng Trị</h3>
      <p>Cung cấp số lượng lớn sắt thép Hòa Phát, xi măng Bỉm Sơn / Sông Gianh / Nghi Sơn, tôn lạnh, gạch tuynel...</p>
      <div class="post-cta-buttons">
        <a href={`tel:${settings.hotline_main.replace(/\./g, '')}`} class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -2px; margin-right: 6px;"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.23 2.09z"/></svg>
          Hotline: {settings.hotline_main}
        </a>
        <a href={settings.zalo_url} target="_blank" rel="noopener noreferrer" class="btn btn-navy btn-lg">
          Chat Zalo Báo Giá Ngay
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .post-container {
    max-width: 860px;
    padding: 3rem 1.25rem 5rem;
  }
  .post-header {
    margin-bottom: 2rem;
  }
  .post-cat-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-primary-glow);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    margin-bottom: 0.8rem;
  }
  .post-detail-title {
    font-size: 2.2rem;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--color-primary-dark);
  }
  .post-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .post-hero-image {
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-md);
  }
  .post-hero-image img {
    width: 100%;
    height: auto;
  }

  .post-main-content {
    line-height: 1.8;
    font-size: 1.05rem;
    color: #1e293b;
  }
  .post-main-content h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
  }
  .post-main-content h3 {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.6rem;
  }
  .post-main-content p {
    margin-bottom: 1.2rem;
  }

  .post-cta-card {
    background: linear-gradient(135deg, #0a2d52 0%, #15457a 100%);
    color: #ffffff;
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    text-align: center;
    margin-top: 4rem;
  }
  .post-cta-card h3 {
    color: #ffffff;
    font-size: 1.5rem;
    margin-bottom: 0.6rem;
  }
  .post-cta-card p {
    color: #cbd5e1;
    margin-bottom: 1.5rem;
  }
  .post-cta-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .post-detail-title { font-size: 1.7rem; }
    .post-cta-buttons { flex-direction: column; }
  }
</style>
