---
interface Props {
  title: string;
  activeNav?: string;
}

const { title, activeNav = 'dashboard' } = Astro.props;

const navItems = [
  { 
    id: 'dashboard', 
    name: 'Bảng Điều Khiển', 
    href: '/admin', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>` 
  },
  { 
    id: 'inquiries', 
    name: 'Yêu Cầu Báo Giá', 
    href: '/admin/inquiries', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>` 
  },
  { 
    id: 'products', 
    name: 'Quản Lý Sản Phẩm', 
    href: '/admin/products', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>` 
  },
  { 
    id: 'categories', 
    name: 'Danh Mục Vật Tư', 
    href: '/admin/categories', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>` 
  },
  { 
    id: 'brands', 
    name: 'Thương Hiệu', 
    href: '/admin/brands', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>` 
  },
  { 
    id: 'posts', 
    name: 'Tin Tức & Báo Giá', 
    href: '/admin/posts', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>` 
  },
  { 
    id: 'seo', 
    name: 'Tiêu Đề & Meta SEO', 
    href: '/admin/seo', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>` 
  },
  { 
    id: 'settings', 
    name: 'Cài Đặt Hệ Thống', 
    href: '/admin/settings', 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>` 
  }
];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - TailAdmin VLXD Hoàng Yến</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin-tailadmin.css" />
    <style is:global>
      @import "/css/admin-tailadmin.css";
    </style>
  </head>
  <body class="admin-body">
    <div class="admin-wrapper">
      <!-- TailAdmin Sidebar -->
      <aside class="admin-sidebar">
        <div class="admin-brand">
          <div class="brand-logo-box">
            <span class="brand-text">VLXD HOÀNG YẾN</span>
            <span class="brand-sub">TailAdmin Dashboard</span>
          </div>
        </div>

        <div class="nav-section-title">MENU QUẢN TRỊ</div>
        <nav class="admin-nav">
          <ul>
            {navItems.map(item => (
              <li class={activeNav === item.id ? 'active' : ''}>
                <a href={item.href}>
                  <span class="nav-icon" set:html={item.svg} />
                  <span class="nav-text">{item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="sidebar-bottom">
          <a href="/" target="_blank" class="admin-view-site">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            <span>Xem Website ↗</span>
          </a>
          <a href="/admin/logout" class="admin-logout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Đăng Xuất</span>
          </a>
        </div>
      </aside>

      <!-- TailAdmin Main Content Area -->
      <div class="admin-main">
        <header class="admin-topbar">
          <div class="admin-topbar-left">
            <h1 class="admin-page-title">{title}</h1>
          </div>
          <div class="admin-topbar-right">
            <div class="admin-user-pill">
              <span class="user-avatar-dot"></span>
              <span class="user-role-label">Quản Trị Viên</span>
            </div>
          </div>
        </header>

        <main class="admin-page-content">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
