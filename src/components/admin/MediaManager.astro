<script is:inline define:vars={{ featuredInputName, galleryInputName, galleryAltsName, allowMultiple }}>
  (function () {
    const root = document.getElementById('media_manager_root');
    if (!root) return;

    const fileInput = document.getElementById('mm_file_input');
    const btnUpload = document.getElementById('mm_btn_upload');
    const btnLibrary = document.getElementById('mm_btn_library');
    const statusMsg = document.getElementById('mm_status_msg');
    const thumbsGrid = document.getElementById('mm_thumbs_grid');
    const countBadge = document.getElementById('mm_selected_count');
    const dropzone = document.getElementById('mm_dropzone');

    const featuredInput = document.getElementById(featuredInputName);
    const galleryInput = document.getElementById(galleryInputName);
    const altsJsonInput = document.getElementById(galleryAltsName);

    const modal = document.getElementById('mm_library_modal');
    const modalClose = document.getElementById('mm_modal_close');
    const btnConfirmSelect = document.getElementById('mm_btn_confirm_select');
    const libraryGrid = document.getElementById('mm_library_grid');
    const searchInput = document.getElementById('mm_search_input');

    let allLibraryImages = [];
    
    // Internal items state: Array<{ url: string, alt: string }>
    let itemsState = [];

    // Parse initial state from JSON input or text fields
    function initItemsState() {
      let loaded = false;
      if (altsJsonInput && altsJsonInput.value) {
        try {
          const parsed = JSON.parse(altsJsonInput.value);
          if (Array.isArray(parsed) && parsed.length > 0) {
            itemsState = parsed.map(p => ({
              url: typeof p === 'string' ? p : p.url,
              alt: typeof p === 'object' && p.alt ? p.alt : ''
            })).filter(i => Boolean(i.url));
            loaded = true;
          }
        } catch (e) {
          console.warn('[MediaManager] JSON parse error', e);
        }
      }

      if (!loaded) {
        const urls = [];
        const feat = featuredInput ? featuredInput.value.trim() : '';
        if (feat) urls.push(feat);

        if (allowMultiple && galleryInput) {
          const galLines = galleryInput.value.split('\n').map(s => s.trim()).filter(s => s.length > 0);
          for (const line of galLines) {
            if (!urls.includes(line)) urls.push(line);
          }
        }
        itemsState = urls.map(url => ({ url, alt: '' }));
      }
    }

    initItemsState();

    // Helper to get array of URLs
    function getSelectedUrls() {
      return itemsState.map(i => i.url);
    }

    // Save itemsState to all Form Inputs
    function syncStateToInputs() {
      const urls = itemsState.map(i => i.url);
      
      // 1. Update featured image input
      if (featuredInput) {
        featuredInput.value = urls[0] || '';
        // Also trigger change event for other listeners
        featuredInput.dispatchEvent(new Event('change', { bubbles: true }));
        featuredInput.dispatchEvent(new Event('input', { bubbles: true }));
      }

      // 2. Update gallery textarea
      if (allowMultiple && galleryInput) {
        galleryInput.value = urls.join('\n');
        galleryInput.dispatchEvent(new Event('change', { bubbles: true }));
        galleryInput.dispatchEvent(new Event('input', { bubbles: true }));
      }

      // 3. Update hidden JSON input with URLs + ALTs
      if (altsJsonInput) {
        altsJsonInput.value = JSON.stringify(itemsState);
      }

      // 4. Update preview count badge
      if (countBadge) {
        countBadge.textContent = `${itemsState.length} ảnh`;
      }

      renderThumbnails();
    }

    // Render Thumbnails Grid with Delete, Set Main Buttons & ALT Input
    function renderThumbnails() {
      if (!thumbsGrid) return;
      thumbsGrid.innerHTML = '';

      if (itemsState.length === 0) {
        thumbsGrid.innerHTML = '<div style="font-size:0.85rem; color:#94a3b8; padding: 1.5rem; grid-column: 1/-1; text-align: center; background:#f8fafc; border-radius:8px; border:1px dashed #e2e8f0;">Chưa có ảnh nào được chọn. Hãy bấm <strong>Tải ảnh từ máy tính</strong> hoặc <strong>Kho ảnh MySQL</strong> phía trên.</div>';
        return;
      }

      itemsState.forEach((item, idx) => {
        const isMain = idx === 0;
        const card = document.createElement('div');
        card.className = `mm-thumb-card ${isMain ? 'is-featured' : ''}`;
        card.dataset.url = item.url;

        let html = `
          <div class="mm-thumb-img-wrapper">
            <img src="${item.url}" class="mm-thumb-img" alt="${item.alt || 'Hình ảnh'}" loading="lazy" />
            ${isMain ? `<span class="mm-thumb-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Ảnh chính</span>` : ''}
          </div>
          
          <div class="mm-thumb-alt-box">
            <label>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
              <span>Thẻ ALT (SEO):</span>
            </label>
            <input type="text" class="mm-alt-input" data-index="${idx}" value="${(item.alt || '').replace(/"/g, '&quot;')}" placeholder="Mô tả ảnh cho SEO..." title="Nhập thẻ ALT chuẩn SEO cho hình ảnh này" />
          </div>

          <div class="mm-thumb-actions">
            ${isMain 
              ? `<span class="mm-thumb-btn is-main-active">⭐ Ảnh chính</span>` 
              : `<button type="button" class="mm-thumb-btn mm-btn-main" data-set-main="${item.url}" title="Đặt tấm này làm ảnh đại diện chính">⭐ Đặt ảnh chính</button>`
            }
            <button type="button" class="mm-thumb-btn mm-btn-delete" data-remove="${item.url}" title="Xóa ảnh này">🗑️ Xóa</button>
          </div>
        `;

        card.innerHTML = html;
        thumbsGrid.appendChild(card);
      });

      // Attach ALT input event listeners
      const altInputs = thumbsGrid.querySelectorAll('.mm-alt-input');
      altInputs.forEach(input => {
        input.addEventListener('input', (e) => {
          const idx = Number(e.target.getAttribute('data-index'));
          if (itemsState[idx]) {
            itemsState[idx].alt = e.target.value;
            if (altsJsonInput) {
              altsJsonInput.value = JSON.stringify(itemsState);
            }
          }
        });
      });
    }

    // Handle Delete & Set Main Thumbnail Click Events
    if (thumbsGrid) {
      thumbsGrid.addEventListener('click', (e) => {
        const target = e.target;
        const removeUrl = target.getAttribute('data-remove') || target.closest('[data-remove]')?.getAttribute('data-remove');
        const setMainUrl = target.getAttribute('data-set-main') || target.closest('[data-set-main]')?.getAttribute('data-set-main');

        if (removeUrl) {
          itemsState = itemsState.filter(i => i.url !== removeUrl);
          syncStateToInputs();
        } else if (setMainUrl) {
          const targetItem = itemsState.find(i => i.url === setMainUrl);
          if (targetItem) {
            itemsState = [targetItem, ...itemsState.filter(i => i.url !== setMainUrl)];
            syncStateToInputs();
          }
        }
      });
    }

    // Upload Files Core Function
    async function handleUploadFiles(files) {
      if (!files || files.length === 0) return;

      if (statusMsg) {
        statusMsg.style.display = 'block';
        statusMsg.textContent = `Đang tải ${files.length} ảnh lên hệ thống & MySQL...`;
      }

      const formData = new FormData();
      for (let i = 0; i < files.length; i++) {
        formData.append('files', files[i]);
      }

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success && data.urls && data.urls.length > 0) {
          const newItems = data.urls.map(url => ({ url, alt: '' }));
          
          if (!allowMultiple) {
            itemsState = [newItems[0]];
          } else {
            for (const item of newItems) {
              if (!itemsState.some(i => i.url === item.url)) {
                itemsState.push(item);
              }
            }
          }
          syncStateToInputs();
          if (statusMsg) {
            statusMsg.textContent = `✅ Đã tải lên ${data.urls.length} ảnh thành công!`;
            setTimeout(() => { statusMsg.style.display = 'none'; }, 4000);
          }
        } else {
          if (statusMsg) statusMsg.textContent = `❌ Lỗi: ${data.error || data.message || 'Không thể tải ảnh'}`;
        }
      } catch (err) {
        if (statusMsg) statusMsg.textContent = `❌ Lỗi kết nối mạng: ${err.message}`;
      }
      if (fileInput) fileInput.value = '';
    }

    // Upload Button Click
    if (btnUpload && fileInput) {
      btnUpload.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', () => handleUploadFiles(fileInput.files));
    }

    // Drag and drop events
    if (dropzone) {
      ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('drag-over');
        }, false);
      });
      ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('drag-over');
        }, false);
      });
      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt ? dt.files : null;
        if (files && files.length > 0) {
          handleUploadFiles(files);
        }
      }, false);
    }

    // Modal MySQL Library Handlers
    if (btnLibrary && modal) {
      btnLibrary.addEventListener('click', () => {
        modal.style.display = 'flex';
        loadLibraryImages();
      });
    }

    if (modalClose && modal) {
      modalClose.addEventListener('click', () => modal.style.display = 'none');
    }
    if (btnConfirmSelect && modal) {
      btnConfirmSelect.addEventListener('click', () => modal.style.display = 'none');
    }
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.style.display = 'none';
      });
    }

    async function loadLibraryImages() {
      if (!libraryGrid) return;
      libraryGrid.innerHTML = '<div class="mm-loading-state" style="grid-column:1/-1; text-align:center; padding:2rem; color:#64748b;">Đang tải danh sách kho ảnh...</div>';

      try {
        const res = await fetch('/api/upload');
        const data = await res.json();
        if (data.success && data.images) {
          allLibraryImages = data.images.map(img => {
            if (typeof img === 'string') return { url: img, name: img.split('/').pop() };
            return img;
          });
          renderLibraryGrid(allLibraryImages);
        } else {
          libraryGrid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:2rem; color:#ef4444;">Không thể tải kho ảnh.</div>';
        }
      } catch (err) {
        libraryGrid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:2rem; color:#ef4444;">Lỗi tải kho ảnh: ${err.message}</div>`;
      }
    }

    function renderLibraryGrid(images) {
      if (!libraryGrid) return;
      libraryGrid.innerHTML = '';

      if (images.length === 0) {
        libraryGrid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:2rem; color:#64748b;">Không tìm thấy ảnh nào.</div>';
        return;
      }

      const selectedUrls = getSelectedUrls();

      images.forEach(imgObj => {
        const isSelected = selectedUrls.includes(imgObj.url);
        const item = document.createElement('div');
        item.className = `mm-lib-item ${isSelected ? 'is-selected' : ''}`;
        
        let html = `
          <img src="${imgObj.url}" class="mm-lib-img" alt="${imgObj.name}" loading="lazy" />
          <span class="mm-lib-name" title="${imgObj.name}">${imgObj.name}</span>
        `;
        if (isSelected) html += `<span class="mm-lib-badge">✓ Đã chọn</span>`;

        item.innerHTML = html;

        item.addEventListener('click', () => {
          if (!allowMultiple) {
            itemsState = [{ url: imgObj.url, alt: '' }];
          } else {
            const exists = itemsState.some(i => i.url === imgObj.url);
            if (exists) {
              itemsState = itemsState.filter(i => i.url !== imgObj.url);
            } else {
              itemsState.push({ url: imgObj.url, alt: '' });
            }
          }
          syncStateToInputs();
          renderLibraryGrid(images);
        });

        libraryGrid.appendChild(item);
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.toLowerCase().trim();
        const filtered = allLibraryImages.filter(img => (img.name || '').toLowerCase().includes(q) || (img.url || '').toLowerCase().includes(q));
        renderLibraryGrid(filtered);
      });
    }

    // Initial render of thumbnails
    renderThumbnails();
  })();
</script>
