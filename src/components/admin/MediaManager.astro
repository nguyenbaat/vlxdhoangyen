---
interface ImageItem {
  url: string;
  alt?: string;
}

interface Props {
  featuredImage?: string;
  galleryImages?: Array<string | ImageItem>;
  featuredInputName?: string;
  galleryInputName?: string;
  galleryAltsName?: string;
  allowMultiple?: boolean;
  targetInputId?: string;
  buttonText?: string;
  initialAlts?: Record<string, string>;
}

const targetInput = Astro.props.targetInputId || Astro.props.featuredInputName || 'featured_image';
const isMultiple = Astro.props.allowMultiple !== undefined 
  ? Boolean(Astro.props.allowMultiple) 
  : (!Astro.props.targetInputId);

const {
  featuredImage = '',
  galleryImages = [],
  featuredInputName = targetInput,
  galleryInputName = 'gallery',
  galleryAltsName = 'gallery_alts_json',
  allowMultiple = isMultiple,
  buttonText = 'Tải ảnh từ máy tính',
  initialAlts = {}
} = Astro.props;

// Prepare initial items array
const parsedInitialItems: Array<{ url: string; alt: string }> = [];

if (featuredImage) {
  parsedInitialItems.push({
    url: featuredImage,
    alt: initialAlts[featuredImage] || ''
  });
}

for (const item of galleryImages) {
  if (typeof item === 'string' && item) {
    if (!parsedInitialItems.some(i => i.url === item)) {
      parsedInitialItems.push({ url: item, alt: initialAlts[item] || '' });
    }
  } else if (typeof item === 'object' && item?.url) {
    const existing = parsedInitialItems.find(i => i.url === item.url);
    if (existing) {
      if (item.alt && !existing.alt) existing.alt = item.alt;
    } else {
      parsedInitialItems.push({ url: item.url, alt: item.alt || initialAlts[item.url] || '' });
    }
  }
}

const galleryStr = parsedInitialItems.map(i => i.url).join('\n');
const initialJsonStr = JSON.stringify(parsedInitialItems);
---

<div class="media-manager-card" id="media_manager_root" data-allow-multiple={allowMultiple ? "true" : "false"}>
  <div class="media-manager-header">
    <div class="mm-header-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
      <h4>Hình Ảnh & Thẻ ALT Chuẩn SEO</h4>
    </div>
    <span class="header-hint">Tải ảnh chất lượng cao hoặc chọn từ kho lưu trữ MySQL. Hỗ trợ đặt thẻ ALT riêng cho từng ảnh.</span>
  </div>

  <!-- Action Controls Dropzone Area -->
  <div class="media-dropzone-box" id="mm_dropzone">
    <input type="file" id="mm_file_input" accept="image/*" multiple={allowMultiple} style="display:none;" />
    
    <div class="dropzone-inner">
      <div class="dropzone-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
      </div>
      <div class="dropzone-text">
        <strong>Tải ảnh lên hệ thống (Tự động lưu trữ MySQL)</strong>
        <span>Hỗ trợ định dạng JPG, PNG, WebP (Tối đa 5MB/ảnh)</span>
      </div>
      
      <div class="media-actions-bar">
        <button type="button" class="mm-btn mm-btn-upload" id="mm_btn_upload">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <span>{buttonText}</span>
        </button>

        <button type="button" class="mm-btn mm-btn-library" id="mm_btn_library">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Kho ảnh MySQL / Thư viện</span>
        </button>
      </div>
    </div>
  </div>

  <div id="mm_status_msg" class="mm-status" style="display: none;"></div>

  <!-- Visual Selected Thumbnails Grid -->
  <div class="mm-thumbnails-section">
    <div class="mm-sublabel-bar">
      <span class="mm-sublabel">Danh sách ảnh đã chọn ({allowMultiple ? 'Đặt ảnh chính, sửa thẻ ALT & Xóa từng tấm' : 'Ảnh đại diện'}):</span>
      <span class="mm-count-badge" id="mm_selected_count">{parsedInitialItems.length} ảnh</span>
    </div>
    
    <div class="mm-thumbs-grid" id="mm_thumbs_grid"></div>
  </div>

  <!-- Hidden JSON input storing full objects with url and alt text -->
  <input type="hidden" id={galleryAltsName} name={galleryAltsName} value={initialJsonStr} />

  <!-- Form Collapsible URL Inputs (for Power Users) -->
  <details class="mm-urls-toggle">
    <summary>Xem & Chỉnh sửa danh sách URL ảnh trực tiếp</summary>
    <div class="mm-inputs-group">
      <div class="form-group-mm">
        <label for={featuredInputName}>URL Ảnh đại diện chính ({featuredInputName})</label>
        <input type="text" id={featuredInputName} name={featuredInputName} value={featuredImage} class="form-input-mm" />
      </div>

      {allowMultiple && (
        <div class="form-group-mm">
          <label for={galleryInputName}>Danh sách URL ảnh phụ ({galleryInputName} - Mỗi ảnh 1 dòng)</label>
          <textarea id={galleryInputName} name={galleryInputName} rows="3" class="form-textarea-mm">{galleryStr}</textarea>
        </div>
      )}
    </div>
  </details>

  <!-- Modal Kho Ảnh MySQL Library -->
  <div class="mm-modal-overlay" id="mm_library_modal" style="display: none;">
    <div class="mm-modal-dialog">
      <div class="mm-modal-header">
        <div class="mm-modal-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <h3>Kho Ảnh MySQL & Thư Viện Media</h3>
        </div>
        <button type="button" class="mm-modal-close" id="mm_modal_close" title="Đóng">&times;</button>
      </div>

      <div class="mm-modal-search-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="mm_search_input" placeholder="Tìm kiếm hình ảnh theo tên file..." />
      </div>

      <div class="mm-modal-body" id="mm_library_grid">
        <div class="mm-loading-state">Đang nạp danh sách kho ảnh...</div>
      </div>

      <div class="mm-modal-footer">
        <span class="mm-modal-hint">Nhấp chuột vào ảnh để Chọn hoặc Bỏ chọn</span>
        <button type="button" class="mm-btn mm-btn-primary" id="mm_btn_confirm_select">Hoàn Tất Chọn</button>
      </div>
    </div>
  </div>
</div>

