---
interface Props {
  product: {
    id: number;
    name: string;
    slug: string;
    sku?: string;
    price?: number;
    unit?: string;
    short_description?: string;
    featured_image?: string;
    brand_name?: string;
    brand_slug?: string;
    category_name?: string;
    category_slug?: string;
    is_in_stock?: number;
    is_featured?: number;
    custom_badge?: string;
  };
}

const { product } = Astro.props;
const fallbackImage = '/anh-sanpham.png';

// Clean, non-duplicate badges
const badges: Array<{ label: string; styleClass: string }> = [];

if (product.custom_badge && product.custom_badge.trim()) {
  badges.push({ label: product.custom_badge.trim(), styleClass: 'badge-tier1' });
}

if (product.brand_name && product.brand_name.trim()) {
  const brandTrimmed = product.brand_name.trim();
  if (!badges.some(b => b.label.toLowerCase() === brandTrimmed.toLowerCase())) {
    badges.push({ label: brandTrimmed, styleClass: 'badge-brand' });
  }
}

if (badges.length === 0) {
  if (product.category_name && product.category_name.trim()) {
    badges.push({ label: product.category_name.trim(), styleClass: 'badge-brand' });
  } else if (product.is_in_stock !== 0) {
    badges.push({ label: 'SẴN HÀNG', styleClass: 'badge-san-kho' });
  }
}
---

<article class="product-industrial-card">
  <!-- Image Box -->
  <a href={`/${product.slug}/`} class="card-image-wrap" aria-label={product.name}>
    <img 
      src={product.featured_image || fallbackImage} 
      alt={`${product.name} tại Đông Hà, Quảng Trị - VLXD Hoàng Yến`}
      width="300"
      height="225"
      loading="lazy"
      decoding="async"
      class="card-img"
    />
    <div class="card-badges">
      {badges.map(b => (
        <span class={`badge ${b.styleClass}`}>{b.label}</span>
      ))}
    </div>
  </a>

  <!-- Content Box -->
  <div class="card-body">
    {product.category_name && (
      <span class="card-cat-label">{product.category_name}</span>
    )}

    <h3 class="card-title">
      <a href={`/${product.slug}/`}>{product.name}</a>
    </h3>

    {product.short_description && (
      <p class="card-excerpt">{product.short_description.slice(0, 85)}...</p>
    )}

    <div class="card-meta">
      <div class="card-pricing">
        <span class="price-label">Đơn vị:</span>
        <span class="price-val">{product.unit || 'Quy cách chuẩn'}</span>
      </div>
      <div class="stock-status">
        <span class="stock-indicator in-stock"></span>
        <span class="stock-text">Sẵn hàng tại kho</span>
      </div>
    </div>

    <!-- Action Button with Unique Anchor Content for SEO -->
    <div class="card-action">
      <a href={`/${product.slug}/`} class="btn btn-primary btn-sm btn-block" aria-label={`Báo giá chi tiết ${product.name}`}>
        <span>Báo Giá Chi Tiết</span>
        <span class="sr-only"> cho {product.name}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .product-industrial-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transition: all var(--transition-normal);
    position: relative;
    height: 100%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .product-industrial-card:hover {
    border-color: var(--color-red);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  /* Image Container */
  .card-image-wrap {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-concrete-light);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-4);
    transition: transform var(--transition-normal);
  }

  .product-industrial-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    z-index: 2;
  }

  /* Badge Variants */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: 6px;
    line-height: 1.2;
  }

  .badge-brand {
    background-color: #0f172a;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .badge-tier1 {
    background-color: #dc2626;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(220, 38, 38, 0.35);
  }

  .badge-hot {
    background-color: #ea580c;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(234, 88, 12, 0.35);
  }

  .badge-hang-chuan {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .badge-san-kho {
    background-color: #16a34a;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(22, 163, 74, 0.3);
  }

  .badge-gia-dai-ly {
    background-color: #d97706;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(217, 119, 6, 0.3);
  }

  .badge-bao-hanh {
    background-color: #0284c7;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(2, 132, 199, 0.3);
  }

  .badge-uu-dai {
    background-color: #e11d48;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(225, 29, 72, 0.35);
  }

  .badge-de-xuat {
    background-color: #4f46e5;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(79, 70, 229, 0.3);
  }

  .badge-hang-moi {
    background-color: #0d9488;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(13, 148, 136, 0.3);
  }

  /* Body */
  .card-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-cat-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--space-2);
  }

  .card-title a {
    color: var(--color-charcoal);
  }

  .card-title a:hover {
    color: var(--color-red);
  }

  .card-excerpt {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  /* Meta */
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
    font-size: 0.75rem;
  }

  .card-pricing {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    color: var(--color-text-subtle);
  }

  .price-val {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .stock-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .stock-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #2e7d32;
  }

  .stock-text {
    font-weight: 600;
    color: #2e7d32;
  }

  /* Action */
  .btn-block {
    width: 100%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
